---
import '../styles/global.css';
import { areas } from '../data/areas';
import { url } from '../lib/nav';
import Search from '../components/Search.astro';
import AreaIcon from '../components/AreaIcon.astro';
import Chat from '../components/Chat.astro';

interface Props {
  title: string;
  description?: string;
  /** id of the active top tab: 'home' or an area id */
  active: string;
  /** render the mobile menu button (pages with a sidebar) */
  hasSidebar?: boolean;
}

const { title, description = 'Foundational notes for people who build with computers.', active, hasSidebar = false } =
  Astro.props;
const fullTitle = title === 'Workbench' ? title : `${title} · Workbench`;
// set automatically in GitHub Actions; the link is hidden in local builds
const repo = process.env.GITHUB_REPOSITORY;
const tabs = areas.map((a) => ({ id: a.id, title: a.title, href: url(`${a.id}/`) }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content="noai, noimageai" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.19.0/dist/katex.min.css" crossorigin="anonymous" />
  </head>
  <body>
    <noscript class="no-js">This site needs JavaScript to work. Please enable it to continue.</noscript>
    <header class="site-header">
      <div class="bar">
        {
          hasSidebar && (
            <button class="menu-btn" type="button" aria-label="Open navigation" data-open-sidebar>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <path d="M3 5h14M3 10h14M3 15h14" />
              </svg>
            </button>
          )
        }
        <a class="logo" href={url()}>
          <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="4" y="8" width="5.5" height="19" rx="1.6" fill="#4285F4"></rect>
            <rect x="10.5" y="5" width="5.5" height="22" rx="1.6" fill="#EA4335"></rect>
            <rect x="17" y="10" width="5.5" height="17" rx="1.6" fill="#FBBC05"></rect>
            <rect x="23.5" y="7" width="5.5" height="20" rx="1.6" fill="#34A853"></rect>
            <g fill="#E8EAED">
              <rect x="5.2" y="12" width="3.1" height="1.8" rx=".9"></rect>
              <rect x="11.7" y="9" width="3.1" height="1.8" rx=".9"></rect>
              <rect x="18.2" y="14" width="3.1" height="1.8" rx=".9"></rect>
              <rect x="24.7" y="11" width="3.1" height="1.8" rx=".9"></rect>
            </g>
          </svg>
          <span>Workbench</span>
        </a>
        <div class="bar-right">
          <Search />
          <a class="icon-link muted" href={url('graph/')} aria-label="Graph view">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 15 9.5 9 16 11.5" />
              <g fill="currentColor" stroke="none">
                <circle cx="4" cy="15" r="2.2" />
                <circle cx="9.5" cy="9" r="2.6" />
                <circle cx="16" cy="11.5" r="2.2" />
                <circle cx="14.5" cy="3.8" r="1.5" />
                <circle cx="4.2" cy="4.5" r="1.5" />
              </g>
              <circle cx="16.3" cy="17" r="1.5" stroke-width="1.2" />
            </svg>
            <span class="hide-sm">Graph</span>
          </a>
          {
            repo && (
              <a class="gh-link" href={`https://github.com/${repo}`} aria-label="GitHub repository">
                <svg width="24" height="24" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
                </svg>
              </a>
            )
          }
        </div>
      </div>
      <nav class="tabs" aria-label="Areas">
        {
          tabs.map((t) => (
            <a href={t.href} class:list={['tab', { active: t.id === active }]} aria-current={t.id === active ? 'page' : undefined}>
              <AreaIcon id={t.id} size={16} />
              {t.title}
            </a>
          ))
        }
      </nav>
    </header>
    <slot />
    <Chat />
    <script>
      // The tab row scrolls sideways on narrow screens and every page load resets it to the
      // left, hiding a later area off screen. Bring the active tab into view.
      const tabRow = document.querySelector<HTMLElement>('.tabs');
      const activeTab = tabRow?.querySelector<HTMLElement>('.tab.active');
      if (tabRow && activeTab) {
        tabRow.scrollLeft = activeTab.offsetLeft - (tabRow.clientWidth - activeTab.offsetWidth) / 2;
      }
    </script>
    <script>
      // Button switchers in figures: <input type="hidden" data-x value="a" /><span class="choice">
      // <button data-choice="a">…</button>…</span>. A click sets the hidden input, marks the pressed
      // button and fires input/change events, so figure code reads it like a <select>.
      // Auto-play for steppers: <button data-auto-step>Auto</button> presses the figure's own
      // [data-step-btn] button every 700 ms until it is disabled, nothing changes, a reset or
      // other control is used, or Auto is pressed again (it reads Pause while running).
      const running = new Map<HTMLElement, number>();
      const stop = (btn: HTMLElement) => {
        clearInterval(running.get(btn));
        running.delete(btn);
        btn.textContent = 'Auto';
        btn.setAttribute('aria-pressed', 'false');
      };
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const auto = target.closest<HTMLButtonElement>('[data-auto-step]');
        if (!auto) {
          // any other button in a figure stops its auto-play (a user step, reset or mode change)
          const fig = target.closest('figure');
          // (programmatic step clicks from auto-play are not trusted, so they do not stop it)
          if (fig && target.closest('button') && e.isTrusted) {
            running.forEach((_, b) => { if (fig.contains(b)) stop(b); });
          }
          return;
        }
        if (running.has(auto)) return stop(auto);
        const host = auto.closest('figure')!;
        const step = host.querySelector<HTMLButtonElement>('[data-step-btn]');
        if (!step) return;
        auto.textContent = 'Pause';
        auto.setAttribute('aria-pressed', 'true');
        const tick = () => {
          if (step.disabled) return stop(auto);
          const before = host.textContent + host.innerHTML.length;
          step.click();
          if (step.disabled || host.textContent + host.innerHTML.length === before) stop(auto);
        };
        running.set(auto, window.setInterval(tick, 700));
        tick();
      });
      // Toggle buttons: <input type="checkbox" hidden data-x /><button data-toggle aria-pressed>…</button>.
      // A click flips the hidden checkbox and fires input/change, so figure code reads .checked as before.
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-toggle]');
        const box = btn?.previousElementSibling as HTMLInputElement | null;
        if (!btn || !box || box.type !== 'checkbox') return;
        box.checked = !box.checked;
        btn.setAttribute('aria-pressed', String(box.checked));
        box.dispatchEvent(new Event('input', { bubbles: true }));
        box.dispatchEvent(new Event('change', { bubbles: true }));
      });
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.choice [data-choice]');
        if (!btn) return;
        const group = btn.closest('.choice')!;
        const input = group.previousElementSibling as HTMLInputElement | null;
        group.querySelectorAll('[data-choice]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        if (!input || input.value === btn.dataset.choice) return;
        input.value = btn.dataset.choice!;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    height: 60px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 24px;
    max-width: 1520px;
    margin: 0 auto;
  }
  :global(.no-js) {
    display: block;
    padding: 10px 24px;
    text-align: center;
    font-size: 0.875rem;
    color: var(--text);
    background: rgba(234, 67, 53, 0.16);
    border-bottom: 1px solid var(--g-red);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .bar-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 7px 12px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .icon-link:hover {
    background: var(--bg-hover);
  }
  .icon-link.muted {
    color: var(--text-muted);
    transition: color 0.15s;
  }
  .icon-link.muted:hover {
    color: var(--text);
  }
  /* the GitHub link is the bare mark, no box or label */
  .gh-link {
    display: inline-flex;
    align-items: center;
    padding: 6px;
    color: var(--text-muted);
    transition: color 0.15s;
  }
  .gh-link:hover {
    color: var(--text);
  }
  .menu-btn {
    display: none;
    background: none;
    border: 0;
    padding: 6px;
    margin-left: -6px;
    cursor: pointer;
    color: var(--text-muted);
  }
  .tabs {
    display: flex;
    gap: 28px;
    padding: 0 24px;
    height: 45px;
    max-width: 1520px;
    margin: 0 auto -1px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
  }
  .tab {
    display: flex;
    align-items: center;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .tab :global(svg) {
    margin-right: 7px;
    flex: none;
  }
  .tab:hover {
    color: var(--text);
  }
  .tab.active {
    color: var(--text);
    border-bottom-color: var(--text);
  }
  @media (max-width: 1023px) {
    .menu-btn {
      display: inline-flex;
    }
  }
  @media (max-width: 640px) {
    .bar,
    .tabs {
      padding: 0 16px;
    }
    .hide-sm {
      display: none;
    }
    .icon-link {
      padding: 7px;
    }
  }
</style>
