---
import Base from '../layouts/Base.astro';
import { areas } from '../data/areas';
import { buildGraph } from '../lib/graph';
import AreaIcon from '../components/AreaIcon.astro';
import GraphView from '../components/GraphView.astro';

const g = await buildGraph();
const written = g.nodes.filter((n) => n.written).length;
if (g.broken.length) console.warn(`[graph] ${g.broken.length} broken note links:\n  ${g.broken.join('\n  ')}`);
console.log(`[graph] ${g.nodes.length} notes (${written} written), ${g.edges.length} links`);
const data = { areas: areas.map((a) => ({ id: a.id, title: a.title })), nodes: g.nodes, edges: g.edges };
---

<Base title="Note Graph" description="Every note as a dot and every link between notes as a line." active="graph">
  <main class="graph-page">
    <header class="gp-head">
      <h1>Note Graph</h1>
      <p class="gp-lead">
        Each dot is a note, coloured by area and sized by how many links it has. Hover a dot to see its neighbours, click it
        to inspect, drag to rearrange.
      </p>
    </header>

    <GraphView data={data}>
      <div slot="controls" class="gp-ctl">
        <div class="gp-row">
          {
            areas.map((a) => (
              <>
                <input type="checkbox" hidden checked data-area={a.id} />
                <button type="button" class="btn gp-area" data-toggle aria-pressed="true" style={`--c: var(--ga-${a.id})`}>
                  <AreaIcon id={a.id} size={15} />
                  {a.title}
                </button>
              </>
            ))
          }
        </div>
        <div class="gp-row">
          <input type="search" class="input gp-search" placeholder="Find a note…" aria-label="Find a note" data-q />
          <input type="checkbox" hidden data-orphans />
          <button type="button" class="btn" data-toggle aria-pressed="false">Orphan notes</button>
          <button type="button" class="btn" data-fit>Fit</button>
          <button type="button" class="btn" data-play aria-pressed="false">Animate</button>
        </div>
      </div>
    </GraphView>
  </main>
</Base>

<style>
  .graph-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 24px 24px 40px;
  }
  .gp-head h1 {
    margin: 0 0 6px;
  }
  .gp-lead {
    margin: 0 0 16px;
    max-width: 72ch;
    color: var(--text-muted);
  }
  .gp-ctl {
    display: grid;
    gap: 8px;
    margin-bottom: 12px;
  }
  .gp-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .gp-area {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .gp-area[aria-pressed='false'] {
    opacity: 0.5;
  }
  .gp-area[aria-pressed='true'] {
    border-color: var(--c);
    color: var(--text);
    background: color-mix(in srgb, var(--c) 14%, transparent);
  }
  .gp-area :global(svg) {
    flex: none;
  }
  .gp-search {
    flex: 1 1 200px;
    max-width: 320px;
  }
  @media (max-width: 640px) {
    .graph-page {
      padding: 16px;
    }
  }
</style>
