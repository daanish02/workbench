---
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import { areas, type Area } from '../../data/areas';
import { areaNav, noteUrl, readingMinutes } from '../../lib/nav';

export function getStaticPaths() {
  return areas.map((area) => ({ params: { area: area.id }, props: { area } }));
}

const { area } = Astro.props as { area: Area };
const nav = await areaNav(area.id);
const total = nav.reduce((n, s) => n + s.notes.length, 0);
const swatches = ['var(--g-blue)', 'var(--g-red)', 'var(--g-yellow)', 'var(--g-green)'];
---

<Base title={area.title} description={area.blurb} active={area.id} hasSidebar>
  <div class="shell">
    <Sidebar areaId={area.id} areaTitle={area.title} nav={nav} />
    <main class="main">
      <header>
        <p class="eyebrow">{nav.length} sections · {total} notes</p>
        <h1>{area.title}</h1>
        <p class="lead">{area.blurb} Sections are ordered as a learning path: each one leans on the ones before it.</p>
      </header>

      <div class="sections">
        {
          nav.map((section, i) => (
            <section class="card" id={section.id} style={`--swatch: ${swatches[i % 4]}`}>
              <h2>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                {section.title}
                <span class="mins">{section.notes.reduce((m, n) => m + readingMinutes(n), 0)} min</span>
              </h2>
              <ol>
                {section.notes.map((n) => (
                  <li>
                    <a href={noteUrl(n)}>
                      <span class="n-title">
                        {n.data.title}
                        <span class="mins">{readingMinutes(n)} min</span>
                      </span>
                      <span class="n-desc">{n.data.description}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))
        }
      </div>
    </main>
  </div>
</Base>

<style>
  .shell {
    display: grid;
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
    max-width: 1520px;
    margin: 0 auto;
  }
  .main {
    min-width: 0;
    padding: 40px 56px 96px;
    max-width: 1100px;
  }
  .eyebrow {
    margin: 0 0 10px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 2.75rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .lead {
    max-width: 680px;
    margin: 14px 0 0;
    color: var(--text-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .sections {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 16px;
  }
  .card {
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg-elev);
    padding: 20px 20px 14px;
    position: relative;
    overflow: hidden;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--swatch);
    opacity: 0.85;
  }
  h2 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 10px;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  .num {
    font: 500 0.75rem var(--font-mono);
    color: var(--swatch);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li a {
    display: block;
    padding: 8px 10px;
    margin: 0 -10px;
    border-radius: 10px;
  }
  li a:hover {
    background: var(--bg-hover);
  }
  li a:hover .n-title {
    color: var(--accent);
  }
  .n-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .mins {
    margin-left: auto;
    font: 500 0.6875rem var(--font-mono);
    color: var(--text-faint);
    white-space: nowrap;
  }
  .n-desc {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-faint);
    line-height: 1.5;
    margin-top: 1px;
  }
  @media (max-width: 1023px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
    }
    .main {
      padding: 28px 16px 72px;
    }
  }
</style>
