---
import Base from '../layouts/Base.astro';
import { areas } from '../data/areas';
import AreaIcon from '../components/AreaIcon.astro';
import { areaNav, isAppendix, url } from '../lib/nav';

const PLACEHOLDER = 'Placeholder. Content not written yet.';
const cards = await Promise.all(
  areas.map(async (area) => {
    const nav = await areaNav(area.id);
    const all = nav.flatMap((s) => s.notes);
    // an area is ready once any of its notes has real content
    const ready = all.some((n) => !n.body?.includes(PLACEHOLDER));
    const sections = nav.filter((s) => !isAppendix(s));
    return { area, sections: sections.length, notes: all.length, nav: sections, ready };
  }),
);
---

<Base title="Workbench" active="home">
  <main class="home">
    <section class="hero">
      <h1>Workbench</h1>
      <p class="tag">
        Foundational notes for people who build with computers. Textbook-style explanations, the math where it matters, and
        interactives you can poke at.
      </p>
      <a class="graph-link" href={url('graph/')}>
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 15 9.5 9 16 11.5" />
          <g fill="currentColor" stroke="none">
            <circle cx="4" cy="15" r="2.2" />
            <circle cx="9.5" cy="9" r="2.6" />
            <circle cx="16" cy="11.5" r="2.2" />
            <circle cx="14.5" cy="3.8" r="1.5" />
            <circle cx="4.2" cy="4.5" r="1.5" />
          </g>
          <circle cx="16.3" cy="17" r="1.5" stroke-width="1.2" />
        </svg>
        See how the notes connect: the note graph
        <span aria-hidden="true">→</span>
      </a>
    </section>

    <section class="areas" aria-label="Areas">
      {
        cards.map(({ area, sections, notes, nav, ready }) => (
          <a class:list={['area', { soon: !ready }]} href={url(`${area.id}/`)}>
            <div class="area-top">
              <AreaIcon id={area.id} size={36} />
              <span class="meta">
                {sections} sections · {notes} notes
              </span>
            </div>
            {!ready && <span class="badge">Coming soon</span>}
            <h2>{area.title}</h2>
            <p>{area.blurb}</p>
            <ul class="chips">
              {nav.map((s) => (
                <li>{s.title}</li>
              ))}
            </ul>
            <span class="cta">Start reading →</span>
          </a>
        ))
      }
    </section>
  </main>
</Base>

<style>
  .home {
    max-width: 1100px;
    margin: 0 auto;
    padding: 72px 24px 96px;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(2.6rem, 8vw, 4.5rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .tag {
    max-width: 820px;
    margin: 20px 0 0;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .graph-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: 0.9375rem;
    color: var(--text-faint);
    transition: color 0.15s;
  }
  .graph-link:hover {
    color: var(--accent);
  }
  .areas {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 480px), 1fr));
    gap: 16px;
  }
  .area {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--bg-elev);
    transition: border-color 0.15s, transform 0.15s;
  }
  .area:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .area.soon {
    opacity: 0.5;
  }
  .badge {
    align-self: flex-start;
    margin-top: 14px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text-muted);
  }
  .area-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .meta {
    font: 0.75rem var(--font-mono);
    color: var(--text-faint);
  }
  h2 {
    margin: 20px 0 8px;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chips li {
    font-size: 0.75rem;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text-muted);
  }
  .cta {
    display: inline-block;
    align-self: flex-start;
    margin-top: auto;
    padding-top: 20px;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .home {
      padding: 40px 16px 72px;
    }
  }
</style>
