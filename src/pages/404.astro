---
import Base from '../layouts/Base.astro';
import { url } from '../lib/nav';
---

<Base title="Page Not Found" description="This page does not exist." active="">
  <main class="not-found">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p>The note you are looking for may have moved or may not exist yet. Try the search, or start from the home page.</p>
    <a class="btn primary" href={url()}>Back to home</a>
  </main>
</Base>

<style>
  .not-found {
    max-width: 520px;
    margin: 0 auto;
    padding: 96px 24px;
    text-align: center;
  }
  .code {
    margin: 0;
    font: 500 0.875rem var(--font-mono);
    letter-spacing: 0.12em;
    color: var(--g-blue-l);
  }
  h1 {
    margin: 8px 0 12px;
    font-size: 1.75rem;
  }
  p {
    margin: 0 0 24px;
    color: var(--text-muted);
  }
</style>
