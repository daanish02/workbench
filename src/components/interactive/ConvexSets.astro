---
import Figure from '../Figure.astro';
---

<Figure
  kind="Diagram"
  title="Convex and non-convex sets"
  caption="Left: an ellipse. The segment between any two of its points stays inside, so it is convex. Right: an L-shaped region. The dashed segment joins two points of the region but leaves it through the notch, so the region is not convex."
>
  <svg class="cs-svg" viewBox="0 0 400 200" role="img" aria-label="Left, an ellipse with a segment inside. Right, an L-shaped region with a dashed segment leaving the region">
    <ellipse cx="100" cy="100" rx="70" ry="50" class="cs-convex"></ellipse>
    <line x1="55" y1="112" x2="150" y2="88" class="cs-in"></line>
    <text x="100" y="180" class="cs-t">convex</text>
    <polygon points="230,40 300,40 300,100 370,100 370,170 230,170" class="cs-nonconvex"></polygon>
    <line x1="250" y1="70" x2="355" y2="70" class="cs-out"></line>
    <text x="300" y="190" class="cs-t">not convex</text>
  </svg>
</Figure>

<style>
  .cs-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .cs-convex,
  .cs-nonconvex {
    fill: rgba(66, 133, 244, 0.2);
    stroke: var(--g-blue);
    stroke-width: 1.5;
  }
  .cs-in {
    stroke: var(--g-yellow);
    stroke-width: 2;
  }
  .cs-out {
    stroke: var(--g-red);
    stroke-width: 2;
    stroke-dasharray: 5 4;
  }
  .cs-t {
    fill: var(--text-muted);
    font: 12px var(--font-mono);
    text-anchor: middle;
  }
</style>
