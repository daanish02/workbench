---
import Figure from '../Figure.astro';
---

<Figure
  title="Nine trials: grid or random"
  caption="The validation loss from the note depends almost only on the learning rate (horizontal axis; darker blue is better) and hardly on dropout (vertical). Ticks under the plot mark the learning rates actually tried. A 3 × 3 grid tries only 3 of them; nine random trials try 9, so one usually lands closer to the best value (yellow line). Resample to draw a new random set."
>
  <grid-vs-random>
    <div class="gr-ctl">
      <input type="hidden" data-kind value="random" />
      <span class="choice">
        <button type="button" class="btn" data-choice="grid" aria-pressed="false">grid</button>
        <button type="button" class="btn" data-choice="random" aria-pressed="true">random</button>
      </span>
      <button type="button" class="btn" data-resample>Resample</button>
    </div>
    <div class="axes" style="--ax-w: 400px">
      <span class="ax-y">dropout</span>
      <svg class="gr-svg" viewBox="0 0 400 230" role="img" aria-label="Search space of learning rate against dropout with the trials marked">
        <g data-bg></g>
        <line data-opt y1="10" y2="200" class="gr-opt"></line>
        <g data-pts></g>
        <text x="20" y="226" class="ax-tick">10⁻⁴</text>
        <text x="390" y="226" class="ax-tick gr-end">10⁻²</text>
      </svg>
      <span class="ax-x">learning rate (log scale)</span>
    </div>
    <p class="gr-stat" data-stat></p>
  </grid-vs-random>
</Figure>

<style>
  .gr-ctl {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-bottom: 10px;
  }
  .gr-svg {
    display: block;
    width: 100%;
    max-width: 400px;
  }
  .gr-opt {
    stroke: var(--g-yellow);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }
  .gr-svg :global(.gr-pt) {
    fill: var(--g-green);
    stroke: var(--bg);
    stroke-width: 1.5;
  }
  .gr-svg :global(.gr-best) {
    fill: var(--g-yellow);
  }
  .gr-svg :global(.gr-tick) {
    stroke: var(--g-green);
    stroke-width: 2;
  }
  .gr-end {
    text-anchor: end;
  }
  .gr-stat {
    margin: 10px 0 0;
    font: 0.875rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  // Plot area [20, 10]–[390, 200]: log10(lr) from −4 to −2, dropout 0.5 at the top to 0 at the bottom.
  const loss = (llr: number, d: number) => (llr + 2.7) ** 2 + 0.05 * (d - 0.2) ** 2;
  const px = (llr: number) => 20 + ((llr + 4) / 2) * 370;
  const py = (d: number) => 200 - (d / 0.5) * 190;

  class GridVsRandom extends HTMLElement {
    seed = 1;
    connectedCallback() {
      let bg = '';
      for (let i = 0; i < 37; i++) {
        const llr = -4 + (i + 0.5) * (2 / 37);
        const a = 0.55 * Math.exp(-loss(llr, 0.2) * 3);
        bg += `<rect x="${(20 + i * 10).toFixed(1)}" y="10" width="10" height="190" style="fill:rgba(66,133,244,${(0.05 + a).toFixed(3)})"></rect>`;
      }
      this.querySelector('[data-bg]')!.innerHTML = bg;
      const o = this.querySelector('[data-opt]')!;
      o.setAttribute('x1', px(-2.7).toFixed(1));
      o.setAttribute('x2', px(-2.7).toFixed(1));
      this.querySelector('[data-kind]')!.addEventListener('input', () => this.draw());
      this.querySelector('[data-resample]')!.addEventListener('click', () => {
        this.seed++;
        this.draw();
      });
      this.draw();
    }
    draw() {
      const kind = this.querySelector<HTMLInputElement>('[data-kind]')!.value;
      let s = Math.imul(this.seed, 2654435761) >>> 0;
      const u = () => ((s = (Math.imul(s, 1103515245) + 12345) >>> 0) / 4294967296);
      const pts: [number, number][] =
        kind === 'grid'
          ? [-4, -3, -2].flatMap((l) => [0, 0.25, 0.5].map((d) => [l, d] as [number, number]))
          : Array.from({ length: 9 }, () => [-4 + 2 * u(), 0.5 * u()] as [number, number]);
      let best = 0;
      pts.forEach((p, i) => {
        if (loss(...p) < loss(...pts[best])) best = i;
      });
      this.querySelector('[data-pts]')!.innerHTML = pts
        .map(
          ([l, d], i) =>
            `<line x1="${px(l).toFixed(1)}" x2="${px(l).toFixed(1)}" y1="203" y2="213" class="gr-tick"></line>` +
            `<circle cx="${px(l).toFixed(1)}" cy="${py(d).toFixed(1)}" r="${i === best ? 7 : 5}" class="gr-pt${i === best ? ' gr-best' : ''}"></circle>`,
        )
        .join('');
      const distinct = new Set(pts.map((p) => p[0].toFixed(4))).size;
      this.querySelector('[data-stat]')!.textContent =
        `${kind} · ${distinct} distinct learning rates · best lr ${(10 ** pts[best][0]).toExponential(2)} · loss ${loss(...pts[best]).toFixed(4)}`;
    }
  }
  customElements.define('grid-vs-random', GridVsRandom);
</script>
