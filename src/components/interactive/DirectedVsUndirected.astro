---
import Figure from '../Figure.astro';
---

<Figure
  kind="Diagram"
  title="Undirected and directed graphs"
  caption="Left: an undirected triangle, where each edge is a pair with no direction. Right: a directed graph with the same three vertices, where each edge points from one vertex to another. In the directed case the in-degree and out-degree of each vertex are counted separately."
>
  <svg class="du-svg" viewBox="0 0 400 200" role="img" aria-label="Left: undirected triangle on three vertices. Right: directed graph on the same vertices with arrows">
    <defs>
      <marker id="du-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="du-head"></path>
      </marker>
    </defs>
    <line x1="60" y1="150" x2="120" y2="50" class="du-edge"></line>
    <line x1="120" y1="50" x2="180" y2="150" class="du-edge"></line>
    <line x1="60" y1="150" x2="180" y2="150" class="du-edge"></line>
    <g class="du-node"><circle cx="60" cy="150" r="14"></circle><text x="60" y="150">a</text></g>
    <g class="du-node"><circle cx="120" cy="50" r="14"></circle><text x="120" y="50">b</text></g>
    <g class="du-node"><circle cx="180" cy="150" r="14"></circle><text x="180" y="150">c</text></g>
    <text x="120" y="190" class="du-t">undirected</text>
    <line x1="230" y1="150" x2="290" y2="50" class="du-arc" marker-end="url(#du-arrow)"></line>
    <line x1="290" y1="50" x2="350" y2="150" class="du-arc" marker-end="url(#du-arrow)"></line>
    <line x1="350" y1="150" x2="230" y2="150" class="du-arc" marker-end="url(#du-arrow)"></line>
    <g class="du-node"><circle cx="230" cy="150" r="14"></circle><text x="230" y="150">a</text></g>
    <g class="du-node"><circle cx="290" cy="50" r="14"></circle><text x="290" y="50">b</text></g>
    <g class="du-node"><circle cx="350" cy="150" r="14"></circle><text x="350" y="150">c</text></g>
    <text x="290" y="190" class="du-t">directed</text>
  </svg>
</Figure>

<style>
  .du-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .du-edge,
  .du-arc {
    stroke: #5f6368;
    stroke-width: 1.8;
  }
  .du-head {
    fill: #5f6368;
  }
  .du-node circle {
    fill: #1a1a1a;
    stroke: var(--g-blue);
    stroke-width: 1.5;
  }
  .du-node text {
    fill: var(--text);
    font: 600 12px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .du-t {
    fill: var(--text-muted);
    font: 12px var(--font-mono);
    text-anchor: middle;
  }
</style>
