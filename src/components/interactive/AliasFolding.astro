---
import Figure from '../Figure.astro';

// Frequency axis from 0 to the sample rate fs. Frequencies above fs/2 are reflected about fs/2 onto the same samples.
const X = (f: number) => 30 + f * 340; // f as a fraction of fs
---

<Figure
  kind="Diagram"
  title="Folding about the Nyquist frequency"
  caption="The frequency axis runs from 0 to the sample rate fs. A tone at 0.3 fs is kept. A tone at 0.7 fs is reflected about the Nyquist frequency fs/2 and lands on 0.3 fs, so after sampling the two cannot be told apart."
>
  <svg class="af-svg" viewBox="0 0 400 196" role="img" aria-label="Frequency axis from zero to the sample rate, with the Nyquist frequency at the midpoint, a tone at 0.3 kept and a tone at 0.7 folded onto 0.3">
    <line x1={X(0)} y1="110" x2={X(1)} y2="110" class="af-axis"></line>
    <line x1={X(0.5)} y1="72" x2={X(0.5)} y2="110" class="af-nyq"></line>
    <text x={X(0.5)} y="62" class="af-t">Nyquist fs/2</text>
    <text x={X(0)} y="134" class="af-t">0</text>
    <text x={X(1)} y="134" class="af-t">fs</text>
    <path d={`M ${X(0.7)} 110 Q ${X(0.5)} 170 ${X(0.3)} 110`} class="af-arc"></path>
    <circle cx={X(0.3)} cy="110" r="6" class="af-kept"></circle>
    <text x={X(0.3)} y="94" class="af-t">0.3 fs kept</text>
    <circle cx={X(0.7)} cy="110" r="6" class="af-folded"></circle>
    <text x={X(0.7)} y="94" class="af-t">0.7 fs</text>
    <text x={X(0.5)} y="180" class="af-t">0.7 fs reflects onto 0.3 fs</text>
  </svg>
</Figure>

<style>
  .af-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .af-axis {
    stroke: #3c4043;
    stroke-width: 1.5;
  }
  .af-nyq {
    stroke: #9aa0a6;
    stroke-width: 1.2;
    stroke-dasharray: 4 3;
  }
  .af-kept {
    fill: var(--g-blue);
  }
  .af-folded {
    fill: var(--g-red);
  }
  .af-arc {
    fill: none;
    stroke: var(--g-yellow);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }
  .af-t {
    fill: var(--text-muted);
    font: 11px var(--font-mono);
    text-anchor: middle;
  }
</style>
