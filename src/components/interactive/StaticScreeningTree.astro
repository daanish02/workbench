---
import Figure from '../Figure.astro';

// Natural frequencies for the medical test: 10,000 people, 1% prevalence, 90% sensitivity, 5% false positive rate.
---

<Figure
  kind="Diagram"
  title="Counting the medical test"
  caption="Start from 10,000 people. Split by disease status, then by test result. Of the 585 positive tests, only 90 belong to sick people, so P(sick | positive) = 90 / 585 ≈ 0.1538."
>
  <svg class="st-svg" viewBox="0 0 440 250" role="img" aria-label="Tree from 10,000 people to 100 sick and 9,900 healthy, then to positive and negative results, with the positive leaves highlighted.">
    <g class="st-edge">
      <line x1="120" y1="106" x2="150" y2="38"></line>
      <line x1="120" y1="106" x2="150" y2="174"></line>
      <line x1="260" y1="38" x2="270" y2="16"></line>
      <line x1="260" y1="38" x2="270" y2="60"></line>
      <line x1="260" y1="174" x2="270" y2="152"></line>
      <line x1="260" y1="174" x2="270" y2="196"></line>
    </g>
    <rect x="10" y="90" width="110" height="32" rx="6" class="st-node"></rect>
    <text x="65" y="106" class="st-t">10,000 people</text>
    <rect x="150" y="22" width="110" height="32" rx="6" class="st-node"></rect>
    <text x="205" y="38" class="st-t">100 sick</text>
    <rect x="150" y="158" width="110" height="32" rx="6" class="st-node"></rect>
    <text x="205" y="174" class="st-t">9,900 healthy</text>
    <rect x="270" y="0" width="165" height="32" rx="6" class="st-leaf st-hit"></rect>
    <text x="352" y="16" class="st-t">90 sick, positive</text>
    <rect x="270" y="44" width="165" height="32" rx="6" class="st-leaf"></rect>
    <text x="352" y="60" class="st-t">10 sick, negative</text>
    <rect x="270" y="136" width="165" height="32" rx="6" class="st-leaf st-fp"></rect>
    <text x="352" y="152" class="st-t">495 healthy, positive</text>
    <rect x="270" y="180" width="165" height="32" rx="6" class="st-leaf"></rect>
    <text x="352" y="196" class="st-t">9,405 healthy, negative</text>
    <text x="10" y="243" class="st-result">P(sick | positive) = 90 / (90 + 495) = 0.1538</text>
  </svg>
</Figure>

<style>
  .st-svg {
    display: block;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
  }
  .st-edge line {
    stroke: #5f6368;
    stroke-width: 1.2;
  }
  .st-node {
    fill: #1a1a1a;
    stroke: var(--g-blue);
    stroke-width: 1.2;
  }
  .st-leaf {
    fill: #1a1a1a;
    stroke: #5f6368;
    stroke-width: 1;
  }
  .st-hit {
    fill: rgba(66, 133, 244, 0.25);
    stroke: var(--g-blue);
  }
  .st-fp {
    fill: rgba(234, 67, 53, 0.2);
    stroke: var(--g-red);
  }
  .st-t {
    fill: var(--text);
    font: 11px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .st-result {
    fill: var(--text-muted);
    font: 12px var(--font-mono);
  }
</style>
