---
import Figure from '../Figure.astro';
---

<Figure
  title="Controllers keep closing the gap between desired and actual"
  caption="The web Deployment from above with its HorizontalPodAutoscaler (target 70% of the 250m CPU request, 3 to 20 replicas). Each node fits 4 Pods. Set the load, kill a Pod, then step: every step is one pass of the control loops. The HPA sets the desired count, the ReplicaSet creates or deletes Pods, the scheduler places them on free slots, and the cluster autoscaler adds a node when Pods stay pending. Green Pods are ready, yellow are starting, red are pending; a dashed node is still joining."
>
  <reconcile-loop>
    <label class="rl-lbl">load <input type="range" min="300" max="3200" step="100" value="400" data-load /> <b data-lv>400m</b> CPU</label>
    <div class="ctl-row">
      <button type="button" class="btn" data-kill>Kill a Pod</button>
    </div>
    <svg class="rl-svg" data-svg viewBox="0 0 440 150" role="img" aria-label="Nodes with Pod slots, and Pods waiting to be scheduled"></svg>
    <p class="rl-msg" data-msg></p>
    <p class="rl-stat mono" data-stat></p>
    <div class="ctl-row">
      <button type="button" class="btn primary" data-step-btn>Step</button>
      <button type="button" class="btn" data-auto-step aria-pressed="false">Auto</button>
      <button type="button" class="btn" data-reset>Reset</button>
    </div>
  </reconcile-loop>
</Figure>

<style>
  .rl-lbl {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
  }
  .rl-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 10px auto 0;
  }
  .rl-svg :global(rect.node) {
    fill: transparent;
    stroke: var(--border-strong);
  }
  .rl-svg :global(rect.node.new) {
    stroke: var(--g-blue);
    stroke-dasharray: 4 3;
  }
  .rl-svg :global(rect.slot) {
    fill: transparent;
    stroke: var(--border);
    stroke-dasharray: 2 3;
  }
  .rl-svg :global(rect.ready) {
    fill: rgba(52, 168, 83, 0.35);
    stroke: var(--g-green);
  }
  .rl-svg :global(rect.starting) {
    fill: rgba(251, 188, 5, 0.3);
    stroke: var(--g-yellow);
  }
  .rl-svg :global(rect.pending) {
    fill: rgba(234, 67, 53, 0.25);
    stroke: var(--g-red);
  }
  .rl-svg :global(text) {
    fill: var(--text-muted);
    font: 10px var(--font-mono);
    dominant-baseline: central;
  }
  .rl-msg {
    min-height: 3em;
    margin: 8px 0 4px;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .rl-stat {
    font-size: 0.8125rem;
    color: var(--text);
    margin: 0 0 8px;
  }
</style>

<script>
  const REQUEST = 250;      // CPU request per Pod, millicores
  const TARGET = 0.7;       // HPA target utilisation of the request
  const MIN = 3, MAX = 20, SLOTS = 4, MAX_NODES = 5;

  // pod.node = -1 while pending; node.ready = false during the step it is being added
  interface Pod { node: number; ready: boolean }

  class ReconcileLoop extends HTMLElement {
    pods: Pod[] = [];
    nodes: boolean[] = [];
    desired = MIN;
    msg = '';
    connectedCallback() {
      const load = this.querySelector<HTMLInputElement>('[data-load]')!;
      load.addEventListener('input', () => {
        this.querySelector('[data-lv]')!.textContent = `${load.value}m`;
        this.msg = 'Load changed. Nothing reacts until the next pass of the control loops.';
        this.draw();
      });
      this.querySelector('[data-kill]')!.addEventListener('click', () => {
        const i = this.pods.findIndex((p) => p.ready);
        if (i >= 0) this.pods.splice(i, 1);
        this.msg = 'A Pod died (node failure, OOMKilled, kubectl delete). Actual is now below desired.';
        this.draw();
      });
      this.querySelector('[data-step-btn]')!.addEventListener('click', () => this.step());
      this.querySelector('[data-reset]')!.addEventListener('click', () => this.reset());
      this.reset();
    }
    load() {
      return Number(this.querySelector<HTMLInputElement>('[data-load]')!.value);
    }
    reset() {
      const load = this.querySelector<HTMLInputElement>('[data-load]')!;
      load.value = '400';
      this.querySelector('[data-lv]')!.textContent = '400m';
      this.nodes = [true, true];
      this.pods = [0, 0, 1].map((node) => ({ node, ready: true }));
      this.desired = MIN;
      this.msg = 'Steady state: 3 ready Pods on 2 nodes, matching the desired 3.';
      this.draw();
    }
    step() {
      const notes: string[] = [];
      // nodes added last pass and Pods placed last pass become ready
      this.nodes = this.nodes.map(() => true);
      this.pods.forEach((p) => { if (p.node >= 0) p.ready = true; });
      // HPA: replicas so that average CPU per Pod is near the target
      const want = Math.min(MAX, Math.max(MIN, Math.ceil(this.load() / (REQUEST * TARGET))));
      if (want !== this.desired) notes.push(`HPA sets replicas ${this.desired} → ${want}`);
      this.desired = want;
      // ReplicaSet: create or delete Pods to match
      const diff = this.desired - this.pods.length;
      if (diff > 0) {
        for (let k = 0; k < diff; k++) this.pods.push({ node: -1, ready: false });
        notes.push(`ReplicaSet creates ${diff} Pod${diff > 1 ? 's' : ''}`);
      } else if (diff < 0) {
        this.pods.sort((a, b) => Number(a.ready) - Number(b.ready) || b.node - a.node);
        this.pods.splice(0, -diff);
        notes.push(`ReplicaSet deletes ${-diff} Pod${diff < -1 ? 's' : ''}`);
      }
      // scheduler: place pending Pods on ready nodes with a free slot
      let placed = 0;
      this.pods.filter((p) => p.node < 0).forEach((p) => {
        const n = this.nodes.findIndex((ok, i) => ok && this.pods.filter((q) => q.node === i).length < SLOTS);
        if (n >= 0) { p.node = n; placed++; }
      });
      if (placed) notes.push(`scheduler places ${placed}`);
      // cluster autoscaler: pending Pods mean the cluster is full
      const pending = this.pods.filter((p) => p.node < 0).length;
      if (pending && this.nodes.length < MAX_NODES) {
        this.nodes.push(false);
        notes.push(`${pending} still pending, so the cluster autoscaler adds a node`);
      }
      // scale-in: an empty node is removed
      const empty = this.nodes.findIndex((_, i) => i >= 2 && i === this.nodes.length - 1 && !this.pods.some((p) => p.node === i));
      if (empty >= 0 && !pending) {
        this.nodes.pop();
        notes.push('cluster autoscaler removes an empty node');
      }
      this.msg = notes.length ? notes.join('; ') + '.' : 'Desired equals actual and every Pod is ready: the loops have nothing to do.';
      this.draw();
    }
    settled() {
      const want = Math.min(MAX, Math.max(MIN, Math.ceil(this.load() / (REQUEST * TARGET))));
      return want === this.desired && this.pods.length === this.desired && this.pods.every((p) => p.ready) && this.nodes.every(Boolean)
        && !(this.nodes.length > 2 && !this.pods.some((p) => p.node === this.nodes.length - 1));
    }
    draw() {
      let s = '';
      this.nodes.forEach((ok, i) => {
        const x = 6 + i * 87;
        s += `<rect class="node${ok ? '' : ' new'}" x="${x}" y="6" width="80" height="104" rx="6" />`;
        s += `<text x="${x + 8}" y="18">node ${i + 1}</text>`;
        if (!ok) s += `<text x="${x + 8}" y="98">joining</text>`;
        const here = this.pods.filter((p) => p.node === i);
        for (let k = 0; k < SLOTS; k++) {
          const sx = x + 6 + (k % 2) * 36, sy = 30 + Math.floor(k / 2) * 32;
          const p = here[k];
          s += `<rect class="${p ? (p.ready ? 'ready' : 'starting') : 'slot'}" x="${sx}" y="${sy}" width="32" height="26" rx="4" />`;
        }
      });
      const pend = this.pods.filter((p) => p.node < 0);
      s += `<text x="6" y="132">pending</text>`;
      pend.forEach((_, k) => {
        s += `<rect class="pending" x="${62 + k * 22}" y="122" width="18" height="20" rx="3" />`;
      });
      this.querySelector('[data-svg]')!.innerHTML = s;
      this.querySelector('[data-msg]')!.textContent = this.msg;
      const ready = this.pods.filter((p) => p.ready).length;
      const perPod = ready ? Math.round((this.load() / (ready * REQUEST)) * 100) : 0;
      this.querySelector('[data-stat]')!.textContent =
        `CPU per ready Pod ${ready ? perPod + '%' : '-'} (target 70%) · desired ${this.desired} · ready ${ready} · starting ${this.pods.length - ready - pend.length} · pending ${pend.length} · nodes ${this.nodes.length}`;
      this.querySelector<HTMLButtonElement>('[data-step-btn]')!.disabled = this.settled();
    }
  }
  customElements.define('reconcile-loop', ReconcileLoop);
</script>
