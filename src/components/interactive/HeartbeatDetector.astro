---
import Figure from '../Figure.astro';
---

<Figure
  title="How long should a timeout be?"
  caption="Each tick is a heartbeat that arrived (some delayed, some lost). A red band marks a gap longer than the timeout: the detector would wrongly declare a healthy node dead. Drag the timeout, then crash the node and see how long detection takes."
>
  <heartbeat-detector>
    <div class="ctl-row">
      <label class="stat">Timeout <input type="range" min="1.2" max="6" step="0.1" value="2" data-t /> <b data-tv>2.0</b> s</label>
      <button class="btn" data-crash aria-pressed="false">Crash node at t=50s</button>
    </div>
    <svg viewBox="0 0 400 70" class="hb-svg" data-svg aria-label="Heartbeat timeline"></svg>
    <div class="ctl-row">
      <span class="stat" data-stat></span>
    </div>
  </heartbeat-detector>
</Figure>

<style>
  .hb-svg {
    width: 100%;
    display: block;
    margin-top: 10px;
  }
  .hb-svg :global(.beat) {
    stroke: var(--g-green);
    stroke-width: 1.2;
  }
  .hb-svg :global(.fa) {
    fill: rgba(234, 67, 53, 0.35);
  }
  .hb-svg :global(.det) {
    stroke: var(--g-yellow);
    stroke-width: 2;
  }
  .hb-svg :global(.ax) {
    stroke: var(--border-strong);
  }
  .hb-svg :global(text) {
    font: 8px var(--font-mono);
    fill: var(--text-faint);
  }
  input[type='range'] {
    width: 130px;
    vertical-align: middle;
  }
</style>

<script>
  function rng(seed: number) {
    return () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  class HeartbeatDetector extends HTMLElement {
    beats: number[] = [];
    crash = false;
    connectedCallback() {
      const r = rng(11);
      for (let t = 1; t <= 100; t++) if (r() > 0.02) this.beats.push(t + -Math.log(1 - r()) * 0.3);
      this.beats.sort((a, b) => a - b);
      this.querySelector('[data-t]')!.addEventListener('input', () => this.draw());
      this.querySelector('[data-crash]')!.addEventListener('click', (e) => {
        this.crash = !this.crash;
        (e.currentTarget as HTMLElement).setAttribute('aria-pressed', String(this.crash));
        this.draw();
      });
      this.draw();
    }
    draw() {
      const T = +this.querySelector<HTMLInputElement>('[data-t]')!.value;
      this.querySelector('[data-tv]')!.textContent = T.toFixed(1);
      const CRASH = 50;
      const beats = this.crash ? this.beats.filter((b) => b <= CRASH) : this.beats;
      const X = (t: number) => 8 + (t / 100) * 384;
      let h = '<line class="ax" x1="8" x2="392" y1="48" y2="48"></line>';
      let fa = 0;
      for (let i = 1; i < beats.length; i++) {
        if (beats[i] - beats[i - 1] > T) {
          fa++;
          h += `<rect class="fa" x="${X(beats[i - 1] + T)}" y="14" width="${Math.max(2, X(beats[i]) - X(beats[i - 1] + T))}" height="34"></rect>`;
        }
      }
      for (const b of beats) h += `<line class="beat" x1="${X(b)}" x2="${X(b)}" y1="26" y2="48"></line>`;
      let det = '';
      if (this.crash) {
        const last = beats.at(-1)!;
        h += `<line class="det" x1="${X(last + T)}" x2="${X(last + T)}" y1="8" y2="54"></line>`;
        det = ` · crash noticed <b>${(last + T - CRASH).toFixed(1)} s</b> after it happened`;
      }
      h += '<text x="8" y="64">0 s</text><text x="372" y="64">100 s</text>';
      this.querySelector('[data-svg]')!.innerHTML = h;
      this.querySelector('[data-stat]')!.innerHTML = `false alarms: <b>${fa}</b>${det}`;
    }
  }
  customElements.define('heartbeat-detector', HeartbeatDetector);
</script>
