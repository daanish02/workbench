---
import Figure from '../Figure.astro';
---

<Figure
  title="filter → map → reduce, one item at a time"
  caption="reduce(add, map(square, filter(is_even, [1..6])), 0). Python's map and filter are lazy: reduce pulls one value, which is pulled through map, which pulls through filter. So each number travels the whole pipeline before the next one starts, and no intermediate list is ever built. Odd numbers stop at the filter."
>
  <fp-pipeline>
    <div class="lanes">
      <div class="stage"><span class="lab mono">source</span><div class="slot mono" data-s="src"></div></div>
      <div class="arrow">→</div>
      <div class="stage"><span class="lab mono">filter(is_even)</span><div class="slot mono" data-s="filter"></div></div>
      <div class="arrow">→</div>
      <div class="stage"><span class="lab mono">map(n * n)</span><div class="slot mono" data-s="map"></div></div>
      <div class="arrow">→</div>
      <div class="stage"><span class="lab mono">reduce(+, 0)</span><div class="slot mono" data-s="acc"></div></div>
    </div>
    <div class="queue mono" data-queue></div>
    <div class="ctl-row">
      <button class="btn primary" data-play>Play</button>
      <button class="btn" data-step>Step</button>
      <button class="btn" data-reset>Reset</button>
      <span class="stat" data-msg></span>
    </div>
  </fp-pipeline>
</Figure>

<style>
  .lanes {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 6px;
  }
  .stage {
    flex: 1 1 110px;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 8px;
    text-align: center;
    min-width: 0;
  }
  .lab {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  @media (max-width: 560px) {
    .arrow {
      display: none;
    }
    .stage {
      flex-basis: calc(50% - 6px);
    }
  }
  .arrow {
    align-self: center;
    color: var(--text-faint);
  }
  .slot {
    margin-top: 6px;
    min-height: 2.2em;
    display: grid;
    place-items: center;
    font-size: 1.25rem;
    font-weight: 700;
    border-radius: 8px;
    transition: background 0.2s;
  }
  .slot.live {
    background: rgba(66, 133, 244, 0.18);
  }
  .slot.drop {
    background: rgba(234, 67, 53, 0.18);
    color: var(--g-red);
    text-decoration: line-through;
  }
  .slot.acc {
    background: rgba(52, 168, 83, 0.16);
  }
  .queue {
    margin: 10px 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }
  .queue :global(s) {
    color: var(--text-faint);
  }
</style>

<script>
  const SRC = [1, 2, 3, 4, 5, 6];
  type Frame = { src: string; filter: string; map: string; acc: string; live: string; drop?: boolean; msg: string; done: number };

  // Precompute every frame of the real evaluation.
  function frames(): Frame[] {
    const out: Frame[] = [];
    let acc = 0;
    out.push({ src: '', filter: '', map: '', acc: '0', live: '', msg: 'reduce starts with initial 0 and asks for the first value', done: 0 });
    SRC.forEach((n, i) => {
      out.push({ src: String(n), filter: '', map: '', acc: String(acc), live: 'src', msg: `filter pulls ${n} from the list`, done: i + 1 });
      if (n % 2) {
        out.push({ src: '', filter: String(n), map: '', acc: String(acc), live: 'filter', drop: true, msg: `${n} % 2 != 0: dropped, filter pulls again`, done: i + 1 });
        return;
      }
      out.push({ src: '', filter: String(n), map: '', acc: String(acc), live: 'filter', msg: `${n} is even: passed on to map`, done: i + 1 });
      out.push({ src: '', filter: '', map: String(n * n), acc: String(acc), live: 'map', msg: `map yields ${n} * ${n} = ${n * n}`, done: i + 1 });
      out.push({ src: '', filter: '', map: '', acc: String(acc + n * n), live: 'acc', msg: `reduce: ${acc} + ${n * n} = ${acc + n * n}`, done: i + 1 });
      acc += n * n;
    });
    out.push({ src: '', filter: '', map: '', acc: String(acc), live: 'acc', msg: `source exhausted → result ${acc}`, done: SRC.length });
    return out;
  }

  class FpPipeline extends HTMLElement {
    k = 0;
    timer = 0;
    f = frames();
    connectedCallback() {
      this.querySelector('[data-play]')!.addEventListener('click', () => {
        clearInterval(this.timer);
        if (this.k >= this.f.length - 1) this.k = 0;
        this.draw();
        this.timer = window.setInterval(() => (this.k < this.f.length - 1 ? (this.k++, this.draw()) : clearInterval(this.timer)), 650);
      });
      this.querySelector('[data-step]')!.addEventListener('click', () => {
        clearInterval(this.timer);
        if (this.k < this.f.length - 1) this.k++;
        this.draw();
      });
      this.querySelector('[data-reset]')!.addEventListener('click', () => {
        clearInterval(this.timer);
        this.k = 0;
        this.draw();
      });
      this.draw();
    }
    draw() {
      const fr = this.f[this.k];
      for (const s of ['src', 'filter', 'map', 'acc'] as const) {
        const el = this.querySelector<HTMLElement>(`[data-s="${s}"]`)!;
        el.textContent = fr[s];
        el.classList.toggle('live', fr.live === s && !fr.drop && s !== 'acc');
        el.classList.toggle('drop', fr.live === s && !!fr.drop);
        el.classList.toggle('acc', s === 'acc' && fr.live === 'acc');
      }
      this.querySelector('[data-queue]')!.innerHTML = 'list: [' + SRC.map((n, i) => (i < fr.done ? `<s>${n}</s>` : String(n))).join(', ') + ']';
      this.querySelector('[data-msg]')!.textContent = fr.msg;
    }
  }
  customElements.define('fp-pipeline', FpPipeline);
</script>
