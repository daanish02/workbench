---
import Figure from '../Figure.astro';

// Fair die: PMF bars on the left, CDF steps on the right.
const faces = [1, 2, 3, 4, 5, 6];
const baseY = 160;
const barScale = 540; // pixels per unit probability
const cdfScale = 120; // pixels for F = 1
const sx = (x: number) => 220 + x * (160 / 7);
const fy = (F: number) => baseY - cdfScale * F;
let cdf = `M${sx(0)} ${fy(0)}`;
faces.forEach((k) => {
  cdf += ` H${sx(k)} V${fy(k / 6)}`;
});
cdf += ` H${sx(7)}`;
---

<Figure
  kind="Diagram"
  title="PMF and CDF of a fair die"
  caption="Left: each face has probability 1/6, so the bars are equal. Right: the CDF F(x) = P(X ≤ x) rises by 1/6 at each face and reaches 1 at the top face."
>
  <svg class="sd-svg" viewBox="0 0 400 190" role="img" aria-label="Left: six equal bars for the die faces. Right: a step function rising by one sixth at each face to one.">
    <text x="105" y="14" class="sd-h">PMF</text>
    <text x="300" y="14" class="sd-h">CDF</text>
    <line x1="20" y1={baseY} x2="190" y2={baseY} class="sd-axis"></line>
    <line x1="210" y1={baseY} x2="390" y2={baseY} class="sd-axis"></line>
    {faces.map((k) => {
      const cx = 34 + (k - 1) * 28;
      const h = barScale / 6;
      return (
        <g>
          <rect x={cx - 10} y={baseY - h} width="20" height={h} class="sd-bar"></rect>
          <text x={cx} y={baseY - h - 5} class="sd-t">0.17</text>
          <text x={cx} y={baseY + 14} class="sd-t">{k}</text>
        </g>
      );
    })}
    <path d={cdf} class="sd-cdf"></path>
    {faces.map((k) => (
      <text x={sx(k)} y={baseY + 14} class="sd-t">{k}</text>
    ))}
    <text x={sx(0)} y={baseY + 14} class="sd-t">0</text>
  </svg>
</Figure>

<style>
  .sd-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .sd-h {
    fill: var(--text);
    font: 600 12px var(--font-mono);
    text-anchor: middle;
  }
  .sd-t {
    fill: var(--text-muted);
    font: 11px var(--font-mono);
    text-anchor: middle;
  }
  .sd-axis {
    stroke: #3c4043;
    stroke-width: 1;
  }
  .sd-bar {
    fill: var(--g-blue);
  }
  .sd-cdf {
    fill: none;
    stroke: var(--g-blue);
    stroke-width: 2;
  }
</style>
