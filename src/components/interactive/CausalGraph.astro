---
import Figure from '../Figure.astro';
---

<Figure
  kind="Diagram"
  title="A confounder in a causal graph"
  caption="Stone size affects both which treatment a patient gets and how the kidney stone resolves. The arrow from treatment to outcome is the effect we want. The path through stone size is a backdoor path, and adjusting for stone size blocks it."
>
  <svg class="cg-svg" viewBox="0 0 360 200" role="img" aria-label="Causal graph: stone size points to treatment and outcome, and treatment points to outcome">
    <defs>
      <marker id="cg-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="cg-head"></path>
      </marker>
    </defs>
    <g class="cg-node"><circle cx="180" cy="40" r="34"></circle><text x="180" y="40">stone</text><text x="180" y="56">size</text></g>
    <g class="cg-node"><circle cx="60" cy="150" r="34"></circle><text x="60" y="150">treat-</text><text x="60" y="166">ment</text></g>
    <g class="cg-node"><circle cx="300" cy="150" r="34"></circle><text x="300" y="150">out-</text><text x="300" y="166">come</text></g>
    <line x1="160" y1="68" x2="84" y2="124" class="cg-edge" marker-end="url(#cg-arrow)"></line>
    <line x1="200" y1="68" x2="276" y2="124" class="cg-edge" marker-end="url(#cg-arrow)"></line>
    <line x1="94" y1="150" x2="266" y2="150" class="cg-key" marker-end="url(#cg-arrow)"></line>
    <text x="180" y="142" class="cg-label">the effect we want</text>
  </svg>
</Figure>

<style>
  .cg-svg {
    display: block;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
  }
  .cg-node circle {
    fill: #1a1a1a;
    stroke: var(--g-blue);
    stroke-width: 1.5;
  }
  .cg-svg :global(.cg-node text) {
    fill: var(--text);
    font: 600 11px var(--font-mono);
    text-anchor: middle;
  }
  .cg-edge {
    stroke: #5f6368;
    stroke-width: 1.5;
  }
  .cg-key {
    stroke: var(--g-yellow);
    stroke-width: 2.2;
  }
  .cg-head {
    fill: #5f6368;
  }
  .cg-label {
    fill: var(--g-yellow);
    font: 11px var(--font-mono);
    text-anchor: middle;
  }
</style>
