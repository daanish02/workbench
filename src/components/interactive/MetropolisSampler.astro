---
import Figure from '../Figure.astro';
---

<Figure
  title="Metropolis sampling from a posterior"
  caption="The target is the Beta(8, 4) posterior of a coin after 7 heads in 10 flips (green curve). Each Step adds 50 samples from a random-walk Metropolis chain started at 0.5. The bars are the histogram of the samples so far; the trace below shows the chain's path. A tiny step accepts almost everything but crawls; a huge step is rejected most of the time and sticks."
>
  <metropolis-sampler>
    <div class="ms-ctl">
      <label class="ms-lbl">step size <input type="range" min="0" max="100" step="1" value="57" data-s /> <b data-sv>0.20</b></label>
      <div class="ms-btns">
        <button type="button" class="btn" data-step-btn>Step</button>
        <button type="button" class="btn" data-auto-step aria-pressed="false">Auto</button>
        <button type="button" class="btn" data-reset>Reset</button>
      </div>
    </div>
    <div class="axes" style="--ax-w: 440px">
      <span class="ax-y">density</span>
      <svg class="ms-svg" viewBox="0 0 400 180" data-grid='{"box":[20,15,390,160],"x":[0,1],"y":[0,3.2]}' role="img" aria-label="Histogram of Metropolis samples against the Beta(8, 4) density">
        <line x1="20" y1="160" x2="390" y2="160" class="ms-axis"></line>
        <g data-bars></g>
        <path data-pdf class="ms-pdf"></path>
        <text class="ax-tick" x="20" y="174" text-anchor="middle">0</text>
        <text class="ax-tick" x="205" y="174" text-anchor="middle">0.5</text>
        <text class="ax-tick" x="390" y="174" text-anchor="end">1</text>
      </svg>
      <span class="ax-x">heads probability θ</span>
    </div>
    <div class="axes" style="--ax-w: 440px">
      <span class="ax-y">θ</span>
      <svg class="ms-svg ms-trace" viewBox="0 0 400 110" data-grid='{"box":[20,10,390,100],"x":[0,2000],"y":[0,1]}' role="img" aria-label="Trace of the chain: theta against sample number">
        <line x1="20" y1="100" x2="390" y2="100" class="ms-axis"></line>
        <line x1="20" y1="10" x2="20" y2="100" class="ms-axis"></line>
        <path data-trace class="ms-tr"></path>
        <circle data-now r="3.5" class="ms-now"></circle>
        <text class="ax-tick" x="16" y="14" text-anchor="end">1</text>
        <text class="ax-tick" x="16" y="103" text-anchor="end">0</text>
      </svg>
      <span class="ax-x">sample number (up to 2000)</span>
    </div>
    <p class="ms-stat" data-stat></p>
  </metropolis-sampler>
</Figure>

<style>
  .ms-ctl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-bottom: 10px;
  }
  .ms-lbl {
    flex: 1 1 220px;
    display: flex;
    align-items: center;
    gap: 10px;
    font: 0.8125rem var(--font-mono);
    color: var(--text-muted);
  }
  .ms-lbl input {
    flex: 1;
  }
  .ms-lbl b {
    min-width: 3em;
    text-align: right;
    color: var(--text);
  }
  .ms-btns {
    display: flex;
    gap: 8px;
  }
  .ms-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .ms-trace {
    margin-top: 6px;
  }
  .ms-axis {
    stroke: var(--border-strong);
  }
  .ms-svg :global(.ms-bar) {
    fill: rgba(66, 133, 244, 0.35);
    stroke: var(--g-blue);
    stroke-width: 0.5;
  }
  .ms-pdf {
    fill: none;
    stroke: var(--g-green);
    stroke-width: 2;
  }
  .ms-tr {
    fill: none;
    stroke: var(--g-blue);
    stroke-width: 0.8;
  }
  .ms-now {
    fill: var(--g-yellow);
  }
  .ms-stat {
    margin: 10px 0 0;
    font: 0.8125rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  const MAX = 2000; // samples; Step is disabled at this point so Auto stops
  const PER_STEP = 50;
  const BINS = 25;
  const X = (t: number) => 20 + t * 370;

  // target: Beta(8, 4), known only up to a constant to the sampler
  const logTarget = (t: number) => (t <= 0 || t >= 1 ? -Infinity : 7 * Math.log(t) + 3 * Math.log(1 - t));
  const pdf = (t: number) => 1320 * t ** 7 * (1 - t) ** 3; // 1 / B(8, 4) = 1320, for the green curve only

  // seeded generator so a run is repeatable; Reset replays the same chain
  const mulberry = (seed: number) => () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };

  class MetropolisSampler extends HTMLElement {
    rand = mulberry(7);
    chain: number[] = [];
    theta = 0.5;
    accepted = 0;

    connectedCallback() {
      const yMax = 3.2; // a little above the density's peak of about 2.94
      const pts: string[] = [];
      for (let i = 0; i <= 200; i++) {
        const t = i / 200;
        pts.push(`${i ? 'L' : 'M'}${X(t).toFixed(1)},${(160 - (pdf(t) / yMax) * 145).toFixed(1)}`);
      }
      this.querySelector('[data-pdf]')!.setAttribute('d', pts.join(' '));
      this.querySelector('[data-s]')!.addEventListener('input', () => this.reset());
      this.querySelector('[data-step-btn]')!.addEventListener('click', () => this.step());
      this.querySelector('[data-reset]')!.addEventListener('click', () => this.reset());
      this.reset();
    }

    stepSize() {
      // slider 0..100 maps to 0.01..2 on a log scale
      return 0.01 * 200 ** (+this.querySelector<HTMLInputElement>('[data-s]')!.value / 100);
    }

    gauss() {
      // Box-Muller from two uniforms
      const u = 1 - this.rand();
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * this.rand());
    }

    reset() {
      this.rand = mulberry(7);
      this.chain = [];
      this.theta = 0.5;
      this.accepted = 0;
      this.querySelector('[data-sv]')!.textContent = this.stepSize().toFixed(2);
      this.draw();
    }

    step() {
      const s = this.stepSize();
      for (let i = 0; i < PER_STEP && this.chain.length < MAX; i++) {
        const prop = this.theta + s * this.gauss();
        if (Math.log(this.rand()) < logTarget(prop) - logTarget(this.theta)) {
          this.theta = prop;
          this.accepted++;
        }
        this.chain.push(this.theta);
      }
      this.draw();
    }

    draw() {
      const n = this.chain.length;
      const yMax = 3.2;
      const counts = new Array(BINS).fill(0);
      for (const t of this.chain) counts[Math.min(BINS - 1, Math.floor(t * BINS))]++;
      const w = 370 / BINS;
      this.querySelector('[data-bars]')!.innerHTML = n
        ? counts
            .map((c, i) => {
              const h = Math.min(145, ((c / n) * BINS / yMax) * 145); // histogram density = share / bin width
              return `<rect class="ms-bar" x="${(20 + i * w).toFixed(1)}" y="${(160 - h).toFixed(1)}" width="${w.toFixed(1)}" height="${h.toFixed(1)}"></rect>`;
            })
            .join('')
        : '';
      const tx = (i: number) => 20 + (i / (MAX - 1)) * 370;
      const ty = (t: number) => 100 - t * 90;
      this.querySelector('[data-trace]')!.setAttribute('d', this.chain.map((t, i) => `${i ? 'L' : 'M'}${tx(i).toFixed(1)},${ty(t).toFixed(1)}`).join(' '));
      const now = this.querySelector<SVGCircleElement>('[data-now]')!;
      now.setAttribute('cx', tx(Math.max(0, n - 1)).toFixed(1));
      now.setAttribute('cy', ty(this.theta).toFixed(1));
      this.querySelector<HTMLButtonElement>('[data-step-btn]')!.disabled = n >= MAX;
      const mean = n ? this.chain.reduce((a, b) => a + b, 0) / n : NaN;
      this.querySelector('[data-stat]')!.textContent = n
        ? `samples = ${n} · step = ${this.stepSize().toFixed(2)} · accepted = ${Math.round((this.accepted / n) * 100)}% · mean = ${mean.toFixed(3)} · exact 0.667`
        : `samples = 0 · step = ${this.stepSize().toFixed(2)} · press Step to sample`;
    }
  }
  customElements.define('metropolis-sampler', MetropolisSampler);
</script>
