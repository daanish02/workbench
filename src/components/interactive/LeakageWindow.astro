---
import Figure from '../Figure.astro';
---

<Figure
  title="Leakage, and what a window does about it"
  caption="The DFT magnitude (in dB) of 64 samples of a cosine. On a whole number of cycles the tone sits in one bin. Slide it between bins and, with no window, its energy leaks across the whole spectrum. A Hann window tapers the ends, widening the peak slightly but pushing the leakage tens of decibels lower."
>
  <leakage-window>
    <div class="lw-ctl">
      <label class="lw-lbl">cycles in window <input type="range" min="6" max="12" step="0.05" value="8.5" data-f /> <b data-fv>8.50</b></label>
      <div class="lw-lbl">window
        <input type="hidden" data-w value="rect" /><span class="choice"><button type="button" class="btn" data-choice="rect" aria-pressed="true">rectangular (none)</button><button type="button" class="btn" data-choice="hann" aria-pressed="false">Hann</button></span>
      </div>
    </div>
    <svg class="lw-svg" viewBox="0 0 340 200" role="img" aria-label="Spectrum in decibels by bin">
      <line x1="30" y1="180" x2="330" y2="180" class="lw-ax"></line>
      <text x="0" y="16" class="lw-t">0 dB</text><text x="0" y="182" class="lw-t">−100</text>
      <g data-bars></g>
    </svg>
    <p class="lw-stat" data-stat></p>
  </leakage-window>
</Figure>

<style>
  .lw-ctl { display: grid; gap: 10px; margin-bottom: 12px; }
  .lw-lbl { display: flex; align-items: center; gap: 10px; font-size: 0.875rem; color: var(--text-muted); }
  .lw-lbl input { flex: 1; }
  .lw-lbl select { background: var(--bg-soft); color: var(--text); border: 1px solid var(--border); border-radius: 6px; padding: 2px 6px; }
  .lw-svg { display: block; width: 100%; max-width: 420px; margin: 0 auto; }
  .lw-ax { stroke: #3c4043; }
  .lw-t { fill: var(--text-faint); font: 0.625rem var(--font-mono); }
  .lw-svg :global(.lw-bar) { fill: var(--g-blue); }
  .lw-stat { margin: 10px 0 0; font: 0.875rem/1.6 var(--font-mono); color: var(--text-muted); text-align: center; }
</style>

<script>
  const N = 64;
  class LeakageWindow extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll('input, select').forEach((el) => el.addEventListener('input', () => this.draw()));
      this.draw();
    }
    draw() {
      const f = +this.querySelector<HTMLInputElement>('[data-f]')!.value;
      const win = this.querySelector<HTMLSelectElement>('[data-w]')!.value;
      this.querySelector('[data-fv]')!.textContent = f.toFixed(2);
      const x = Array.from({ length: N }, (_, n) => Math.cos((2 * Math.PI * f * n) / N) * (win === 'hann' ? 0.5 * (1 - Math.cos((2 * Math.PI * n) / N)) : 1));
      const mag: number[] = [];
      for (let k = 0; k <= N / 2; k++) {
        let re = 0, im = 0;
        for (let n = 0; n < N; n++) { re += x[n] * Math.cos((2 * Math.PI * k * n) / N); im -= x[n] * Math.sin((2 * Math.PI * k * n) / N); }
        mag.push(Math.hypot(re, im));
      }
      const peak = Math.max(...mag);
      const db = mag.map((m) => Math.max(-100, 20 * Math.log10(m / peak + 1e-12)));
      const w = 300 / db.length;
      this.querySelector('[data-bars]')!.innerHTML = db.map((d, k) => {
        const h = ((d + 100) / 100) * 165;
        return `<rect class="lw-bar" x="${(30 + k * w + 1).toFixed(1)}" y="${(180 - h).toFixed(1)}" width="${(w - 2).toFixed(1)}" height="${h.toFixed(1)}"></rect>`;
      }).join('');
      const far = Math.max(...db.filter((_, k) => Math.abs(k - f) > 10));
      this.querySelector('[data-stat]')!.textContent = `strongest leakage more than 10 bins from the tone: ${far.toFixed(1)} dB`;
    }
  }
  customElements.define('leakage-window', LeakageWindow);
</script>
