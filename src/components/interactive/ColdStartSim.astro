---
import Figure from '../Figure.astro';
---

<Figure
  title="Cold starts on a request timeline"
  caption="Thirty minutes of requests arriving at random. Each dot is one request: blue if a warm environment was free, red if the platform had to start a new one first (a cold start, which adds the start-up time to the latency). An idle environment is discarded after the keep-warm timeout. Try a slow trickle against a short timeout, then add provisioned environments or a burst of simultaneous requests."
>
  <cold-start-sim>
    <div class="ctl-row">
      <label class="stat">Requests/min <input type="range" min="1" max="120" value="1" data-r /> <b data-rv>1</b></label>
      <label class="stat">Keep-warm <input type="range" min="30" max="900" step="30" value="60" data-t /> <b data-tv>60</b> s</label>
      <label class="stat">Cold start <input type="range" min="100" max="3000" step="100" value="800" data-c /> <b data-cv>800</b> ms</label>
      <label class="stat">Provisioned <input type="range" min="0" max="4" value="0" data-p /> <b data-pv>0</b></label>
      <button class="btn" data-burst aria-pressed="false">Burst of 10 at minute 15</button>
    </div>
    <svg viewBox="0 0 400 190" class="cs-svg" data-svg aria-label="Request latency over time"></svg>
    <p class="cs-msg" data-msg></p>
  </cold-start-sim>
</Figure>

<style>
  .cs-svg {
    width: 100%;
    max-width: 640px;
    display: block;
    margin: 10px auto 0;
    background: var(--bg-soft);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
  }
  .cs-svg :global(text) {
    font: 9px var(--font-mono);
    fill: var(--text-muted);
  }
  .cs-svg :global(.ax) {
    stroke: var(--border-strong);
  }
  .cs-svg :global(.warm) {
    fill: var(--g-blue);
    opacity: 0.8;
  }
  .cs-svg :global(.cold) {
    fill: var(--g-red);
    opacity: 0.9;
  }
  .cs-msg {
    margin: 12px 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    min-height: 3.8em;
  }
  input[type='range'] {
    width: 100px;
    vertical-align: middle;
  }
</style>

<script>
  function rng(seed: number) {
    return () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  const SPAN = 1800; // seconds simulated
  const DUR = 0.2; // seconds of work per request
  class ColdStartSim extends HTMLElement {
    burst = false;
    connectedCallback() {
      this.querySelectorAll('input').forEach((i) => i.addEventListener('input', () => this.draw()));
      this.querySelector('[data-burst]')!.addEventListener('click', (e) => {
        this.burst = !this.burst;
        (e.currentTarget as HTMLElement).setAttribute('aria-pressed', String(this.burst));
        this.draw();
      });
      this.draw();
    }
    draw() {
      const q = (s: string) => +this.querySelector<HTMLInputElement>(s)!.value;
      const rate = q('[data-r]');
      const idle = q('[data-t]');
      const cold = q('[data-c]') / 1000;
      const prov = q('[data-p]');
      this.querySelector('[data-rv]')!.textContent = String(rate);
      this.querySelector('[data-tv]')!.textContent = String(idle);
      this.querySelector('[data-cv]')!.textContent = String(Math.round(cold * 1000));
      this.querySelector('[data-pv]')!.textContent = String(prov);
      const r = rng(7);
      const arrivals: number[] = [];
      for (let t = 0; ; ) {
        t += -Math.log(1 - r()) / (rate / 60);
        if (t >= SPAN) break;
        arrivals.push(t);
      }
      if (this.burst) for (let i = 0; i < 10; i++) arrivals.push(900 + i * 0.01);
      arrivals.sort((a, b) => a - b);
      type Env = { free: number; pinned: boolean };
      let envs: Env[] = Array.from({ length: prov }, () => ({ free: 0, pinned: true }));
      const pts: { t: number; lat: number; cold: boolean }[] = [];
      for (const t of arrivals) {
        envs = envs.filter((e) => e.pinned || e.free + idle >= t);
        const e = envs.find((x) => x.free <= t);
        if (e) {
          e.free = t + DUR;
          pts.push({ t, lat: DUR, cold: false });
        } else {
          const lat = cold + DUR;
          envs.push({ free: t + lat, pinned: false });
          pts.push({ t, lat, cold: true });
        }
      }
      const X = (t: number) => 30 + (t / SPAN) * 360;
      const YMAX = Math.max(1, Math.ceil((cold + DUR) * 2) / 2);
      const Y = (s: number) => 160 - (s / YMAX) * 140;
      let h = `<line class="ax" x1="30" y1="160" x2="390" y2="160"></line><line class="ax" x1="30" y1="15" x2="30" y2="160"></line>`;
      h += pts.map((p) => `<circle class="${p.cold ? 'cold' : 'warm'}" cx="${X(p.t).toFixed(1)}" cy="${Y(p.lat).toFixed(1)}" r="${p.cold ? 3.2 : 2.2}"></circle>`).join('');
      h += [0, 10, 20, 30].map((m) => `<text x="${X(m * 60) - 6}" y="173">${m}m</text>`).join('') + `<text x="4" y="22">${YMAX.toFixed(1)}s</text><text x="12" y="163">0</text><text x="160" y="186">time</text>`;
      this.querySelector('[data-svg]')!.innerHTML = h;
      const lats = pts.map((p) => p.lat).sort((a, b) => a - b);
      const pc = (p: number) => (lats.length ? lats[Math.min(lats.length - 1, Math.floor(p * lats.length))] : 0);
      const colds = pts.filter((p) => p.cold).length;
      this.querySelector('[data-msg]')!.textContent = pts.length
        ? `${pts.length.toLocaleString('en-US')} requests, ${colds.toLocaleString('en-US')} cold (${Math.round((colds / pts.length) * 100)}%). Median latency ${Math.round(pc(0.5) * 1000).toLocaleString('en-US')} ms, 99th percentile ${Math.round(pc(0.99) * 1000).toLocaleString('en-US')} ms. ${colds / pts.length > 0.05 && pc(0.5) < cold ? 'The median looks healthy while the tail is paid in cold starts: judge latency by percentiles, not the average.' : colds === 0 ? 'Every request found a warm environment.' : 'Cold starts are frequent enough to show up even in the typical request.'}`
        : 'No requests in this window.';
    }
  }
  customElements.define('cold-start-sim', ColdStartSim);
</script>
