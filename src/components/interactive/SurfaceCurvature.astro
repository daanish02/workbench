---
import Figure from '../Figure.astro';
---

<Figure
  kind="Diagram"
  title="Three signs of curvature"
  caption="Left: a sphere, Gaussian curvature K > 0; a geodesic triangle's angles sum to more than 180°. Middle: a plane, K = 0, exactly 180°. Right: a saddle, K < 0; the sides bow inward and the angles sum to less than 180°. The excess or deficit equals the total curvature inside the triangle."
>
  <svg class="sc-svg" viewBox="0 0 360 150" role="img" aria-label="Triangles drawn on a sphere, a plane and a saddle">
    <!-- sphere -->
    <circle cx="60" cy="65" r="45" class="sc-surf"></circle>
    <ellipse cx="60" cy="65" rx="45" ry="13" class="sc-guide"></ellipse>
    <path d="M60,22 Q78,50 92,72 Q60,88 28,72 Q42,50 60,22 Z" class="sc-tri"></path>
    <text x="60" y="124" class="sc-lab">K &gt; 0<tspan x="60" dy="14">sum &gt; 180°</tspan></text>
    <!-- plane -->
    <path d="M140,95 L230,95 L250,40 L160,40 Z" class="sc-surf"></path>
    <path d="M165,88 L222,88 L198,50 Z" class="sc-tri"></path>
    <text x="195" y="124" class="sc-lab">K = 0<tspan x="195" dy="14">sum = 180°</tspan></text>
    <!-- saddle -->
    <path d="M270,50 Q305,80 340,50 M270,50 Q285,85 295,105 M340,50 Q325,85 315,105 M295,105 Q305,85 315,105" class="sc-surf-line"></path>
    <path d="M285,62 Q306,70 327,62 Q312,78 306,98 Q300,78 285,62 Z" class="sc-tri"></path>
    <text x="305" y="124" class="sc-lab">K &lt; 0<tspan x="305" dy="14">sum &lt; 180°</tspan></text>
  </svg>
</Figure>

<style>
  .sc-svg { display: block; width: 100%; max-width: 520px; margin: 0 auto; }
  .sc-surf { fill: rgba(66, 133, 244, 0.12); stroke: var(--g-blue); stroke-width: 1.2; }
  .sc-surf-line { fill: none; stroke: var(--g-blue); stroke-width: 1.2; }
  .sc-guide { fill: none; stroke: #3c4043; stroke-dasharray: 3 3; }
  .sc-tri { fill: rgba(251, 188, 4, 0.25); stroke: var(--g-yellow); stroke-width: 1.5; }
  .sc-lab { fill: var(--text-muted); font: 0.7rem var(--font-mono); text-anchor: middle; }
</style>
