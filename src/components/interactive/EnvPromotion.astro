---
import Figure from '../Figure.astro';
---

<Figure
  title="One artifact, promoted; only configuration changes"
  caption="The pipeline builds the image once (the same digest in every environment) and promotes it from left to right through a gate at each step: CI tests, a QA sign-off, then smoke tests and an approval. Pick an environment: the image stays the same, while its configuration, data, scale and access change. Green marks what is identical everywhere, yellow what differs by design."
>
  <env-promotion>
    <input type="hidden" data-env value="staging" />
    <span class="choice">
      <button type="button" class="btn" data-choice="dev" aria-pressed="false">dev</button>
      <button type="button" class="btn" data-choice="qa" aria-pressed="false">qa</button>
      <button type="button" class="btn" data-choice="staging" aria-pressed="true">staging</button>
      <button type="button" class="btn" data-choice="prod" aria-pressed="false">prod</button>
    </span>
    <svg class="ep-svg" data-svg viewBox="0 0 440 66" role="img" aria-label="Pipeline from dev through qa and staging to prod, with the selected environment highlighted"></svg>
    <table class="ep-tbl" data-tbl></table>
    <p class="ep-stat mono" data-stat></p>
  </env-promotion>
</Figure>

<style>
  .ep-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 10px auto 0;
  }
  .ep-svg :global(rect.env) {
    fill: rgba(66, 133, 244, 0.12);
    stroke: var(--g-blue);
  }
  .ep-svg :global(rect.env.on) {
    fill: rgba(251, 188, 5, 0.25);
    stroke: var(--g-yellow);
    stroke-width: 2;
  }
  .ep-svg :global(line) {
    stroke: var(--text-faint);
    stroke-width: 1.3;
  }
  .ep-svg :global(text) {
    fill: var(--text);
    font: 11px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .ep-svg :global(text.m) {
    fill: var(--text-muted);
    font-size: 9px;
  }
  .ep-tbl {
    width: 100%;
    max-width: 440px;
    margin: 10px auto 0;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }
  .ep-tbl :global(td) {
    padding: 4px 8px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .ep-tbl :global(td:first-child) {
    color: var(--text-muted);
    white-space: nowrap;
    width: 30%;
  }
  .ep-tbl :global(td.same) {
    color: var(--g-green);
  }
  .ep-tbl :global(td.diff) {
    color: var(--g-yellow);
  }
  .ep-stat {
    font-size: 0.8125rem;
    color: var(--text);
    margin: 8px 0;
  }
</style>

<script>
  const ENVS = ['dev', 'qa', 'staging', 'prod'];
  const GATES = ['CI tests', 'sign-off', 'approval'];
  const ROWS: [string, boolean, Record<string, string>][] = [
    ['image', true, { all: 'shop-api@sha256:4f2a…' }],
    ['database', false, { dev: 'local container, seed data', qa: 'shared, synthetic data', staging: 'pseudonymised copy of prod', prod: 'real customer data' }],
    ['replicas', false, { dev: '1', qa: '1', staging: '2', prod: '6, across 3 zones' }],
    ['payments', false, { dev: 'mock', qa: 'provider sandbox', staging: 'provider sandbox', prod: 'live provider' }],
    ['log level', false, { dev: 'DEBUG', qa: 'DEBUG', staging: 'INFO', prod: 'INFO' }],
    ['who deploys', false, { dev: 'any engineer', qa: 'pipeline on merge', staging: 'pipeline', prod: 'pipeline after approval' }],
    ['account', false, { dev: 'dev account', qa: 'nonprod account', staging: 'nonprod account', prod: 'prod account, separate' }],
    ['schema version', true, { all: 'migration 0042' }],
  ];

  class EnvPromotion extends HTMLElement {
    connectedCallback() {
      this.querySelector('[data-env]')!.addEventListener('change', () => this.draw());
      this.draw();
    }
    draw() {
      const env = this.querySelector<HTMLInputElement>('[data-env]')!.value;
      let s = '';
      ENVS.forEach((e, i) => {
        const x = 6 + i * 110;
        if (i > 0) {
          s += `<line x1="${x - 24}" y1="26" x2="${x}" y2="26" />`;
          s += `<text class="m" x="${x - 12}" y="56">${GATES[i - 1]}</text>`;
        }
        s += `<rect class="env${e === env ? ' on' : ''}" x="${x}" y="8" width="86" height="36" rx="6" />`;
        s += `<text x="${x + 43}" y="26">${e}</text>`;
      });
      this.querySelector('[data-svg]')!.innerHTML = s;
      this.querySelector('[data-tbl]')!.innerHTML = ROWS.map(([k, same, v]) =>
        `<tr><td>${k}</td><td class="${same ? 'same' : 'diff'}">${same ? v.all : v[env]}</td></tr>`).join('');
      const diffs = ROWS.filter(([, same]) => !same).length;
      this.querySelector('[data-stat]')!.textContent = `${env} · ${ROWS.length - diffs} identical in every environment · ${diffs} set per environment`;
    }
  }
  customElements.define('env-promotion', EnvPromotion);
</script>
