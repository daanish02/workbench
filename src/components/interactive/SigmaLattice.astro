---
import Figure from '../Figure.astro';

// Lattice of the sigma-algebra generated by {1, 2} on Omega = {1, 2, 3, 4}: lines mean "is a subset of".
---

<Figure
  kind="Diagram"
  title="Events generated by {1, 2}"
  caption="The four events of the smallest sigma-algebra containing {1, 2}, drawn as a lattice. Going up is adding elements. The set {1} is not an event here, so it has no probability in this model."
>
  <svg class="sl-svg" viewBox="0 0 360 260" role="img" aria-label="Lattice: the empty set below two middle events {1,2} and {3,4}, which join at the whole space Omega. A dashed link marks {1} as not an event.">
    <g class="sl-edge">
      <line x1="180" y1="200" x2="110" y2="120"></line>
      <line x1="180" y1="200" x2="250" y2="120"></line>
      <line x1="110" y1="110" x2="180" y2="40"></line>
      <line x1="250" y1="110" x2="180" y2="40"></line>
    </g>
    <line x1="40" y1="200" x2="110" y2="110" class="sl-bad"></line>
    <g class="sl-node"><circle cx="180" cy="40" r="22"></circle><text x="180" y="40">Ω</text></g>
    <g class="sl-node"><circle cx="110" cy="120" r="22"></circle><text x="110" y="120">{"{1,2}"}</text></g>
    <g class="sl-node"><circle cx="250" cy="120" r="22"></circle><text x="250" y="120">{"{3,4}"}</text></g>
    <g class="sl-node"><circle cx="180" cy="200" r="22"></circle><text x="180" y="200">∅</text></g>
    <g class="sl-bad-node"><circle cx="40" cy="200" r="22"></circle><text x="40" y="200">{"{1}"}</text></g>
    <text x="40" y="240" class="sl-note">not an event</text>
    <text x="250" y="240" class="sl-note">Ω = {"{1,2,3,4}"}</text>
  </svg>
</Figure>

<style>
  .sl-svg {
    display: block;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
  }
  .sl-edge line {
    stroke: #5f6368;
    stroke-width: 1.4;
  }
  .sl-bad {
    stroke: var(--g-red);
    stroke-width: 1.2;
    stroke-dasharray: 4 4;
  }
  .sl-node circle {
    fill: #1a1a1a;
    stroke: var(--g-blue);
    stroke-width: 1.5;
  }
  .sl-node text {
    fill: var(--text);
    font: 600 12px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .sl-bad-node circle {
    fill: #1a1a1a;
    stroke: var(--g-red);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }
  .sl-bad-node text {
    fill: var(--g-red);
    font: 600 12px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .sl-note {
    fill: var(--text-muted);
    font: 11px var(--font-mono);
    text-anchor: middle;
  }
</style>
