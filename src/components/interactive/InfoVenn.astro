---
import Figure from '../Figure.astro';
---

<Figure
  kind="Diagram"
  title="Entropies and mutual information"
  caption="The two circles are H(X) and H(Y). Their overlap is the mutual information I(X;Y): the uncertainty they share. The joint entropy H(X,Y) is the whole union. For the example table the overlap is small, 0.035 bits."
>
  <svg class="iv-svg" viewBox="0 0 400 256" role="img" aria-label="Two overlapping circles for H of X and H of Y, with the small overlap labelled mutual information">
    <circle cx="140" cy="110" r="95" class="iv-x"></circle>
    <circle cx="260" cy="110" r="85" class="iv-y"></circle>
    <text x="106" y="106" class="iv-t">H(X)</text>
    <text x="106" y="124" class="iv-s">1.000 bits</text>
    <text x="296" y="106" class="iv-t">H(Y)</text>
    <text x="296" y="124" class="iv-s">0.881 bits</text>
    <text x="205" y="104" class="iv-o">I</text>
    <text x="205" y="120" class="iv-s">0.035</text>
    <text x="200" y="246" class="iv-s">union = H(X,Y) = 1.846 bits</text>
  </svg>
</Figure>

<style>
  .iv-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto 16px;
  }
  .iv-x {
    fill: rgba(66, 133, 244, 0.2);
    stroke: var(--g-blue);
    stroke-width: 1.5;
  }
  .iv-y {
    fill: rgba(251, 188, 4, 0.2);
    stroke: var(--g-yellow);
    stroke-width: 1.5;
  }
  .iv-t {
    fill: var(--text);
    font: 600 12px var(--font-mono);
    text-anchor: middle;
  }
  .iv-o {
    fill: var(--text);
    font: 600 13px var(--font-mono);
    text-anchor: middle;
  }
  .iv-s {
    fill: var(--text-muted);
    font: 11px var(--font-mono);
    text-anchor: middle;
  }
</style>
