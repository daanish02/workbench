---
import Figure from '../Figure.astro';
---

<Figure
  title="More tests, more false alarms"
  caption="Run m independent tests at level α when every null hypothesis is true. The curve is the chance of at least one false positive, 1 − (1 − α)ᵐ; the dashed line is the same chance after the Bonferroni correction, which tests each at α/m and stays at or below α."
>
  <multiple-tests>
    <div class="mt-ctl">
      <label class="mt-lbl">α <input type="range" min="0.01" max="0.1" step="0.01" value="0.05" data-a /> <b data-av>0.05</b></label>
      <label class="mt-lbl">tests m <input type="range" min="1" max="100" step="1" value="20" data-m /> <b data-mv>20</b></label>
    </div>
    <svg class="mt-svg" viewBox="0 0 340 200" role="img" aria-label="Family-wise error rate against number of tests">
      <line x1="30" y1="180" x2="330" y2="180" class="mt-ax"></line>
      <line x1="30" y1="10" x2="30" y2="180" class="mt-ax"></line>
      <text x="4" y="14" class="mt-t">1</text><text x="4" y="182" class="mt-t">0</text><text x="300" y="196" class="mt-t">m = 100</text>
      <path data-raw class="mt-raw"></path>
      <path data-bonf class="mt-bonf"></path>
      <line data-mark y1="10" y2="180" class="mt-mark"></line>
    </svg>
    <p class="mt-stat" data-stat></p>
  </multiple-tests>
</Figure>

<style>
  .mt-ctl { display: grid; gap: 10px; margin-bottom: 12px; }
  .mt-lbl { display: flex; align-items: center; gap: 10px; font-size: 0.875rem; color: var(--text-muted); }
  .mt-lbl input { flex: 1; }
  .mt-svg { display: block; width: 100%; max-width: 420px; margin: 0 auto; }
  .mt-ax { stroke: #3c4043; }
  .mt-t { fill: var(--text-faint); font: 0.625rem var(--font-mono); }
  .mt-raw { fill: none; stroke: var(--g-red); stroke-width: 2; }
  .mt-bonf { fill: none; stroke: var(--g-green); stroke-width: 2; stroke-dasharray: 5 4; }
  .mt-mark { stroke: var(--text-faint); stroke-dasharray: 3 3; }
  .mt-stat { margin: 10px 0 0; font: 0.875rem/1.6 var(--font-mono); color: var(--text-muted); text-align: center; }
</style>

<script>
  const sx = (m: number) => 30 + ((m - 1) / 99) * 300;
  const sy = (p: number) => 180 - p * 170;
  class MultipleTests extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll('input').forEach((el) => el.addEventListener('input', () => this.draw()));
      this.draw();
    }
    draw() {
      const a = +this.querySelector<HTMLInputElement>('[data-a]')!.value;
      const m = +this.querySelector<HTMLInputElement>('[data-m]')!.value;
      this.querySelector('[data-av]')!.textContent = a.toFixed(2);
      this.querySelector('[data-mv]')!.textContent = String(m);
      let raw = '', bonf = '';
      for (let k = 1; k <= 100; k++) {
        raw += `${k > 1 ? 'L' : 'M'}${sx(k).toFixed(1)},${sy(1 - (1 - a) ** k).toFixed(1)}`;
        bonf += `${k > 1 ? 'L' : 'M'}${sx(k).toFixed(1)},${sy(1 - (1 - a / k) ** k).toFixed(1)}`;
      }
      this.querySelector('[data-raw]')!.setAttribute('d', raw);
      this.querySelector('[data-bonf]')!.setAttribute('d', bonf);
      const mk = this.querySelector('[data-mark]')!;
      mk.setAttribute('x1', String(sx(m))); mk.setAttribute('x2', String(sx(m)));
      this.querySelector('[data-stat]')!.textContent =
        `P(at least one false positive): uncorrected ${(1 - (1 - a) ** m).toFixed(3)} · Bonferroni ${(1 - (1 - a / m) ** m).toFixed(3)} · expected false positives ${(a * m).toFixed(1)}`;
    }
  }
  customElements.define('multiple-tests', MultipleTests);
</script>
