---
import Figure from '../Figure.astro';
---

<Figure
  title="The self-attention weight table"
  caption="Row i is how much token i reads from each token (darker blue = more weight; each row sums to 1). Click a row to select it (yellow). The weights are illustrative, of the kind a trained head produces: “it” reads mostly from “animal”, the noun it refers to. Turn on the causal mask: every cell above the diagonal is blocked (red) and each row's weight is redistributed over the tokens before it, so “it” can still see “animal” but “tired” cannot be seen by anyone earlier."
>
  <self-attn-matrix>
    <div class="sa-ctl">
      <input type="checkbox" hidden data-causal /><button type="button" class="btn" data-toggle aria-pressed="false">causal mask</button>
    </div>
    <svg class="sa-svg" viewBox="0 0 400 330" role="img" aria-label="Self-attention weights between the ten tokens of a sentence">
      <g data-g></g>
    </svg>
    <p class="sa-stat" data-stat></p>
  </self-attn-matrix>
</Figure>

<style>
  .sa-ctl {
    margin-bottom: 10px;
  }
  .sa-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .sa-svg :global(.sa-t) {
    fill: var(--text-muted);
    font: 10px var(--font-mono);
    dominant-baseline: middle;
  }
  .sa-svg :global(.sa-row) {
    cursor: pointer;
  }
  .sa-svg :global(.sa-on) {
    fill: var(--g-yellow);
  }
  .sa-stat {
    margin: 10px 0 0;
    font: 0.875rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  const T = ['The', 'animal', "didn't", 'cross', 'the', 'street', 'because', 'it', 'was', 'tired'];
  const n = T.length;
  // logits: each token attends a little to itself, plus a few learned links
  const L = Array.from({ length: n }, (_, i) => Array.from({ length: n }, (_, j) => (i === j ? 1.2 : 0)));
  const link = (i: number, j: number, v: number) => (L[i][j] += v);
  link(0, 1, 1.5);
  link(1, 0, 1.0);
  link(1, 3, 1.2);
  link(2, 3, 2.0);
  link(3, 1, 1.6);
  link(3, 5, 1.6);
  link(4, 5, 1.8);
  link(5, 3, 1.4);
  link(6, 9, 1.0);
  link(6, 3, 0.8);
  link(7, 1, 3.0);
  link(7, 5, 0.8);
  link(8, 7, 1.8);
  link(8, 9, 1.2);
  link(9, 1, 1.6);
  link(9, 7, 1.6);
  const X0 = 100;
  const Y0 = 64;
  const C = 26;

  class SelfAttnMatrix extends HTMLElement {
    row = 7;
    connectedCallback() {
      this.querySelector('[data-causal]')!.addEventListener('input', () => this.draw());
      this.querySelector('[data-g]')!.addEventListener('click', (e) => {
        const r = (e.target as Element).closest('[data-row]');
        if (!r) return;
        this.row = +r.getAttribute('data-row')!;
        this.draw();
      });
      this.draw();
    }
    weights(causal: boolean) {
      return L.map((r, i) => {
        const e = r.map((v, j) => (causal && j > i ? 0 : Math.exp(v)));
        const s = e.reduce((a, b) => a + b, 0);
        return e.map((v) => v / s);
      });
    }
    draw() {
      const causal = this.querySelector<HTMLInputElement>('[data-causal]')!.checked;
      const W = this.weights(causal);
      let html = '';
      T.forEach((t, j) => {
        const x = X0 + j * C + C / 2;
        html += `<text class="sa-t" transform="translate(${x} ${Y0 - 6}) rotate(-55)">${t}</text>`;
      });
      W.forEach((r, i) => {
        const y = Y0 + i * C;
        html += `<g class="sa-row" data-row="${i}">`;
        html += `<rect x="0" y="${y}" width="${X0}" height="${C}" style="fill:transparent"></rect>`;
        html += `<text x="${X0 - 6}" y="${y + C / 2}" class="sa-t ${i === this.row ? 'sa-on' : ''}" style="text-anchor:end">${T[i]}</text>`;
        r.forEach((w, j) => {
          const masked = causal && j > i;
          html += `<rect x="${X0 + j * C + 1}" y="${y + 1}" width="${C - 2}" height="${C - 2}" rx="2" style="fill:var(--bg)"></rect>`;
          html += `<rect x="${X0 + j * C + 1}" y="${y + 1}" width="${C - 2}" height="${C - 2}" rx="2" style="fill:${masked ? 'rgba(234,67,53,0.16)' : `rgba(66,133,244,${(0.06 + 0.94 * Math.min(1, w / 0.6)).toFixed(2)})`}"></rect>`;
        });
        html += '</g>';
      });
      html += `<rect x="${X0}" y="${Y0 + this.row * C}" width="${n * C}" height="${C}" rx="3" style="fill:none;stroke:var(--g-yellow);stroke-width:2"></rect>`;
      this.querySelector('[data-g]')!.innerHTML = html;
      const top = W[this.row]
        .map((w, j) => [w, j])
        .sort((a, b) => b[0] - a[0])
        .slice(0, 3)
        .map(([w, j]) => `${T[j]} ${w.toFixed(2)}`)
        .join(' · ');
      this.querySelector('[data-stat]')!.textContent = `“${T[this.row]}” reads from: ${top}`;
    }
  }
  customElements.define('self-attn-matrix', SelfAttnMatrix);
</script>
