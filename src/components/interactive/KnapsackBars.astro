---
import Figure from '../Figure.astro';

// Two knapsack instances from the note, each with capacity limit: greedy value against the exact best value.
const cases = [
  { label: 'instance 1', greedy: 14, best: 16 },
  { label: 'instance 2', greedy: 50, best: 60 },
];
const base = 170;
const scale = 2.2; // pixels per unit value: the largest value (60) fits with room for its label
---

<Figure
  kind="Diagram"
  title="Greedy against the exact knapsack value"
  caption="Greedy picks items by value per weight until the next one does not fit. Instance 1: greedy gets 14 where 16 is possible. Instance 2: greedy takes a 50 item and then nothing fits, while the single 60 item is best."
>
  <div class="axes" style="--ax-w: 440px">
    <span class="ax-y">total value</span>
    <svg class="kb-svg" viewBox="0 0 400 210" role="img" aria-label="Bars comparing the greedy knapsack value with the best value for two instances">
      <line x1="30" y1={base} x2="390" y2={base} class="kb-axis"></line>
      {cases.map((c, i) => {
        const gx = 60 + i * 170;
        return (
          <g>
            <rect x={gx} y={base - c.greedy * scale} width="50" height={c.greedy * scale} class="kb-g"></rect>
            <text x={gx + 25} y={base - c.greedy * scale - 6} class="kb-v">greedy {c.greedy}</text>
            <rect x={gx + 60} y={base - c.best * scale} width="50" height={c.best * scale} class="kb-b"></rect>
            <text x={gx + 85} y={base - c.best * scale - 6} class="kb-v">best {c.best}</text>
            <text x={gx + 55} y={base + 18} class="kb-l">{c.label}</text>
          </g>
        );
      })}
    </svg>
  </div>
</Figure>

<style>
  .kb-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .kb-axis {
    stroke: #3c4043;
    stroke-width: 1;
  }
  .kb-g {
    fill: var(--g-yellow);
  }
  .kb-b {
    fill: var(--g-blue);
  }
  .kb-v {
    fill: var(--text);
    font: 10px var(--font-mono);
    text-anchor: middle;
  }
  .kb-l {
    fill: var(--text-muted);
    font: 11px var(--font-mono);
    text-anchor: middle;
  }
</style>
