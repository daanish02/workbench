---
import Figure from '../Figure.astro';
---

<Figure
  title="Skip list search: go right, then drop down"
  caption="This is the note's skip list. Search a key and follow the yellow path: it starts at the head's top level, moves right while the next key is not greater than the target, and drops a level when the next key would overshoot. Re-roll levels assigns each key a random height by coin flips (each level with probability ½), which is how real skip lists stay balanced in expectation."
>
  <skip-list-viz>
    <div class="stage"><svg data-svg role="img" aria-label="skip list"></svg></div>
    <p class="msg" data-msg></p>
    <div class="ctl-row">
      <label class="ctl-label" for="sk-t">Target</label>
      <input class="input" id="sk-t" data-t type="number" value="55" style="width:5em" />
      <button class="btn primary" data-go>Search</button>
      <button class="btn" data-q="80">80</button>
      <button class="btn" data-q="35">35 (absent)</button>
    </div>
    <div class="ctl-row">
      <button class="btn" data-roll>Re-roll levels</button>
      <button class="btn" data-orig>Note's levels</button>
    </div>
  </skip-list-viz>
</Figure>

<style>
  .stage {
    display: flex;
    justify-content: center;
  }
  .stage svg {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .stage :global(.lk) {
    stroke: var(--border-strong);
    stroke-width: 1.4;
  }
  .stage :global(.lk.on) {
    stroke: var(--g-yellow);
    stroke-width: 2.6;
  }
  .stage :global(.tw) {
    stroke: var(--border);
    stroke-width: 1;
  }
  .stage :global(.tw.on) {
    stroke: var(--g-yellow);
    stroke-width: 2.6;
  }
  .stage :global(rect) {
    fill: var(--bg-soft);
    stroke: var(--border-strong);
    stroke-width: 1.4;
  }
  .stage :global(.on rect) {
    fill: rgba(251, 188, 5, 0.18);
    stroke: var(--g-yellow);
  }
  .stage :global(.cmp rect) {
    stroke: var(--g-blue);
    stroke-dasharray: 3 2;
  }
  .stage :global(.hit rect) {
    fill: var(--g-green);
    stroke: var(--g-green);
  }
  .stage :global(text) {
    fill: var(--text);
    font: 700 12px var(--font-mono);
  }
  .stage :global(.hit text) {
    fill: #000;
  }
  .stage :global(text.lv) {
    fill: var(--text-faint);
    font: 9px var(--font-mono);
  }
  .msg {
    min-height: 2.8em;
    margin: 8px 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>

<script>
  const KEYS = [10, 20, 25, 30, 40, 50, 55, 60, 70, 80];
  const NOTE = [3, 1, 2, 1, 3, 1, 2, 1, 3, 1];
  interface St {
    path: [number, number][]; // (col, level) visited, col 0 = head
    cmp: [number, number] | null;
    hit: number;
    msg: string;
  }
  class SkipListViz extends HTMLElement {
    hts = [...NOTE];
    timer = 0;

    connectedCallback() {
      const t = this.querySelector<HTMLInputElement>('[data-t]')!;
      this.querySelector('[data-go]')!.addEventListener('click', () => this.search(Math.trunc(+t.value)));
      this.querySelectorAll<HTMLButtonElement>('[data-q]').forEach((b) =>
        b.addEventListener('click', () => {
          t.value = b.dataset.q!;
          this.search(+b.dataset.q!);
        }),
      );
      this.querySelector('[data-roll]')!.addEventListener('click', () => {
        this.hts = KEYS.map(() => {
          let l = 1;
          while (l < 4 && Math.random() < 0.5) l++;
          return l;
        });
        this.idle('New random heights. Towers per level: ' + [1, 2, 3, 4].map((l) => this.hts.filter((x) => x >= l).length).join(', ') + ' (expect about 10, 5, 2.5, 1.25).');
      });
      this.querySelector('[data-orig]')!.addEventListener('click', () => ((this.hts = [...NOTE]), this.idle("The note's skip list.")));
      this.idle('Level 0 holds every key; each higher level holds a subset.');
    }
    idle(msg: string) {
      clearInterval(this.timer);
      this.draw({ path: [], cmp: null, hit: -1, msg });
    }
    search(target: number) {
      if (!Number.isFinite(target)) return;
      clearInterval(this.timer);
      const top = Math.max(...this.hts);
      const states: St[] = [];
      const path: [number, number][] = [[0, top - 1]];
      let col = 0, cmps = 0;
      const nextAt = (c: number, l: number) => {
        for (let j = c; j < KEYS.length; j++) if (this.hts[j] > l) return j + 1;
        return -1;
      };
      let hitCol = -1;
      outer: for (let l = top - 1; l >= 0; l--) {
        if (path[path.length - 1][1] !== l) path.push([col, l]);
        for (;;) {
          const nx = nextAt(col, l);
          if (nx < 0) {
            states.push({ path: [...path], cmp: null, hit: -1, msg: `Level ${l}: end of level, drop down.` });
            break;
          }
          cmps++;
          const k = KEYS[nx - 1];
          if (k < target) {
            states.push({ path: [...path], cmp: [nx, l], hit: -1, msg: `Level ${l}: next is ${k} &lt; ${target}, move right.` });
            col = nx;
            path.push([col, l]);
          } else if (k === target) {
            hitCol = nx;
            path.push([nx, l]);
            break outer;
          } else {
            states.push({ path: [...path], cmp: [nx, l], hit: -1, msg: `Level ${l}: next is ${k} &gt; ${target}, ${l ? 'drop down a level' : 'stop'}.` });
            break;
          }
        }
      }
      const nx = hitCol > 0 ? hitCol : nextAt(col, 0);
      const found = hitCol > 0;
      const linear = KEYS.findIndex((k) => k >= target) + 1 || KEYS.length;
      states.push({
        path: [...path],
        cmp: null,
        hit: found ? nx : -1,
        msg: `${found ? `Next is ${target}: found it at level ${path[path.length - 1][1]}` : `${target} is not present (the next key at level 0 is ${nx > 0 ? KEYS[nx - 1] : 'none'})`} after <b>${cmps}</b> key comparisons. A plain sorted linked list would need ${linear}.`,
      });
      let i = 0;
      const tick = () => {
        this.draw(states[i]);
        if (++i >= states.length) clearInterval(this.timer);
      };
      tick();
      this.timer = window.setInterval(tick, 650);
    }
    draw(s: St) {
      const top = Math.max(...this.hts);
      const SX = 42, SY = 40, BW = 32, BH = 22, X0 = 22;
      const w = X0 + (KEYS.length + 1) * SX, ht = top * SY + 8;
      const cx = (c: number) => X0 + c * SX;
      const cy = (l: number) => (top - 1 - l) * SY + 8;
      const on = new Set(s.path.map(([c, l]) => c + ':' + l));
      let g = '';
      for (let l = 0; l < top; l++) g += `<text class="lv" x="0" y="${cy(l) + 15}">L${l}</text>`;
      // tower lines and links
      const cols = [0, ...KEYS.map((_, i) => i + 1)];
      for (const c of cols) {
        const hgt = c === 0 ? top : this.hts[c - 1];
        if (hgt > 1) {
          g += `<line class="tw" x1="${cx(c) + BW / 2}" y1="${cy(hgt - 1) + BH}" x2="${cx(c) + BW / 2}" y2="${cy(0)}"/>`;
          for (let l = hgt - 1; l > 0; l--) if (on.has(c + ':' + l) && on.has(c + ':' + (l - 1))) g += `<line class="tw on" x1="${cx(c) + BW / 2}" y1="${cy(l) + BH}" x2="${cx(c) + BW / 2}" y2="${cy(l - 1)}"/>`;
        }
      }
      for (let l = 0; l < top; l++) {
        let prev = 0;
        for (let i = 0; i < KEYS.length; i++) {
          if (this.hts[i] <= l) continue;
          const c = i + 1;
          const used = on.has(prev + ':' + l) && on.has(c + ':' + l);
          g += `<line class="lk ${used ? 'on' : ''}" x1="${cx(prev) + BW}" y1="${cy(l) + BH / 2}" x2="${cx(c)}" y2="${cy(l) + BH / 2}"/>`;
          prev = c;
        }
      }
      for (const c of cols) {
        const hgt = c === 0 ? top : this.hts[c - 1];
        for (let l = 0; l < hgt; l++) {
          const cls = s.hit === c ? 'hit' : on.has(c + ':' + l) ? 'on' : s.cmp && s.cmp[0] === c && s.cmp[1] === l ? 'cmp' : '';
          g += `<g class="${cls}"><rect x="${cx(c)}" y="${cy(l)}" width="${BW}" height="${BH}" rx="5"/><text x="${cx(c) + BW / 2}" y="${cy(l) + 15}" text-anchor="middle">${c === 0 ? 'H' : KEYS[c - 1]}</text></g>`;
        }
      }
      const svg = this.querySelector('[data-svg]')!;
      svg.setAttribute('viewBox', `0 0 ${w} ${ht}`);
      svg.setAttribute('width', String(w));
      svg.innerHTML = g;
      this.querySelector('[data-msg]')!.innerHTML = s.msg;
    }
  }
  customElements.define('skip-list-viz', SkipListViz);
</script>
