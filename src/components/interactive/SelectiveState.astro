---
import Figure from '../Figure.astro';
---

<Figure
  title="Selection: the input decides what the state keeps"
  caption="One state reads 60 steps of noise (grey) with one important value at step 5 (yellow). A fixed (time-invariant) layer applies the same decay at every step, so it either forgets the value quickly or averages it with all the noise (red). A selective layer, as in Mamba, computes its step size from the input: a large step writes the flagged value, a near-zero step keeps the state untouched while noise passes by (green). Drag the fixed layer's step size: no single value does both."
>
  <selective-state>
    <label class="ss-lbl">fixed step size Δ <input type="range" min="0.01" max="1" step="0.01" value="0.1" data-d /> <b data-dv>0.10</b></label>
    <div class="axes" style="--ax-w: 440px">
      <span class="ax-y">state h_t</span>
      <svg class="ss-svg" viewBox="0 0 400 190" data-grid='{"box":[30,10,390,170],"x":[0,60],"y":[-1.5,3.5]}' role="img" aria-label="State over time for a fixed and a selective state space layer">
        <path data-x class="ss-x"></path>
        <line data-mark y1="10" y2="170" class="ss-mark"></line>
        <path data-lti class="ss-lti"></path>
        <path data-sel class="ss-sel"></path>
        <text x="30" y="186" class="ax-tick">0</text>
        <text x="390" y="186" class="ax-tick ss-end">60</text>
      </svg>
      <span class="ax-x">step t</span>
    </div>
    <p class="ss-stat" data-stat></p>
  </selective-state>
</Figure>

<style>
  .ss-lbl {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .ss-lbl input[type='range'] {
    flex: 1;
  }
  .ss-svg {
    display: block;
    width: 100%;
    max-width: 440px;
  }
  .ss-x {
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 1;
  }
  .ss-mark {
    stroke: var(--g-yellow);
    stroke-dasharray: 4 4;
  }
  .ss-lti,
  .ss-sel {
    fill: none;
    stroke-width: 2.5;
  }
  .ss-lti {
    stroke: var(--g-red);
  }
  .ss-sel {
    stroke: var(--g-green);
  }
  .ss-end {
    text-anchor: end;
  }
  .ss-stat {
    margin: 10px 0 0;
    font: 0.875rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  const T = 60;
  function rng(seed: number) {
    let s = seed >>> 0;
    const u = () => {
      s = (s + 0x6d2b79f5) >>> 0;
      let t = s;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
    return () => Math.sqrt(-2 * Math.log(u() + 1e-12)) * Math.cos(2 * Math.PI * u());
  }
  const g = rng(3);
  const X = Array.from({ length: T }, () => g() * 0.5);
  X[5] = 3;
  const px = (t: number) => 30 + (t / T) * 360;
  const py = (v: number) => 170 - ((v + 1.5) / 5) * 160;
  const path = (v: number[]) => v.map((y, t) => `${t ? 'L' : 'M'}${px(t).toFixed(1)},${py(y).toFixed(1)}`).join('');

  function run(dtAt: (t: number) => number): number[] {
    let h = 0;
    return X.map((x, t) => {
      const a = Math.exp(-dtAt(t));
      h = a * h + (1 - a) * x;
      return h;
    });
  }

  class SelectiveState extends HTMLElement {
    connectedCallback() {
      this.querySelector('[data-x]')!.setAttribute('d', path(X));
      const m = this.querySelector('[data-mark]')!;
      m.setAttribute('x1', px(5).toFixed(1));
      m.setAttribute('x2', px(5).toFixed(1));
      this.querySelector('[data-sel]')!.setAttribute('d', path(run((t) => (t === 5 ? 5 : 1e-4))));
      this.querySelector('[data-d]')!.addEventListener('input', () => this.draw());
      this.draw();
    }
    draw() {
      const d = +this.querySelector<HTMLInputElement>('[data-d]')!.value;
      this.querySelector('[data-dv]')!.textContent = d.toFixed(2);
      const lti = run(() => d);
      const sel = run((t) => (t === 5 ? 5 : 1e-4));
      this.querySelector('[data-lti]')!.setAttribute('d', path(lti));
      this.querySelector('[data-stat]')!.textContent =
        `state at step 59 · fixed Δ = ${d.toFixed(2)}: ${lti[59].toFixed(3)} · selective: ${sel[59].toFixed(3)} (the stored value was 3)`;
    }
  }
  customElements.define('selective-state', SelectiveState);
</script>
