---
import Figure from '../Figure.astro';
---

<Figure
  title="Hamming(7,4): flip a bit, read the syndrome"
  caption="Choose four data bits; they are placed in positions 3, 5, 6 and 7, and parity bits fill positions 1, 2 and 4. Click any transmitted bit to flip it, as noise would. The three parity checks form the syndrome, which read as a binary number points at the flipped position. Flip two bits and the syndrome points at the wrong one."
>
  <hamming-code>
    <div class="hc-data">data <span data-data></span></div>
    <div class="hc-word" data-word></div>
    <p class="hc-stat" data-stat></p>
  </hamming-code>
</Figure>

<style>
  .hc-data { display: flex; gap: 8px; justify-content: center; align-items: center; font: 0.875rem var(--font-mono); color: var(--text-muted); margin-bottom: 12px; }
  .hc-data :global(button), .hc-word :global(button) {
    width: 2.2em; height: 2.2em; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-soft);
    color: var(--text); font: 0.95rem var(--font-mono); cursor: pointer;
  }
  .hc-word { display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; }
  .hc-data :global(button) { background: rgba(66, 133, 244, 0.16); border-color: var(--g-blue); color: var(--g-blue-l); }
  .hc-word :global(button) { background: rgba(66, 133, 244, 0.12); border-color: var(--g-blue); }
  .hc-word :global(.par) { border-color: var(--g-green); background: rgba(52, 168, 83, 0.16); color: var(--g-green-l); }
  .hc-word :global(.flip) { background: rgba(234, 67, 53, 0.35); border-color: var(--g-red); color: var(--g-red-l); }
  .hc-word :global(.hint) { display: block; font: 0.625rem var(--font-mono); color: var(--text-faint); text-align: center; }
  .hc-stat { margin: 12px 0 0; font: 0.875rem/1.6 var(--font-mono); color: var(--text-muted); text-align: center; }
</style>

<script>
  const DATA_POS = [3, 5, 6, 7];
  class HammingCode extends HTMLElement {
    data = [1, 0, 1, 1];
    flips = new Set<number>();
    connectedCallback() { this.draw(); }
    encode() {
      const c = new Array(8).fill(0); // 1-indexed
      DATA_POS.forEach((p, i) => (c[p] = this.data[i]));
      for (const b of [1, 2, 4]) {
        let s = 0;
        for (let j = 1; j <= 7; j++) if (j & b && j !== b) s ^= c[j];
        c[b] = s;
      }
      return c;
    }
    draw() {
      const dEl = this.querySelector('[data-data]')!;
      dEl.innerHTML = this.data.map((v, i) => `<button data-d="${i}">${v}</button>`).join('');
      dEl.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
        const i = +b.getAttribute('data-d')!; this.data[i] ^= 1; this.flips.clear(); this.draw();
      }));
      const c = this.encode();
      const r = c.slice();
      this.flips.forEach((p) => (r[p] ^= 1));
      const wEl = this.querySelector('[data-word]')!;
      wEl.innerHTML = Array.from({ length: 7 }, (_, k) => {
        const p = k + 1;
        const cls = [[1, 2, 4].includes(p) ? 'par' : '', this.flips.has(p) ? 'flip' : ''].join(' ');
        return `<span><button class="${cls}" data-p="${p}">${r[p]}</button><span class="hint">${p}</span></span>`;
      }).join('');
      wEl.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
        const p = +b.getAttribute('data-p')!;
        if (this.flips.has(p)) this.flips.delete(p); else this.flips.add(p);
        this.draw();
      }));
      let syn = 0;
      for (let j = 1; j <= 7; j++) if (r[j]) syn ^= j; // XOR of positions holding a 1 = syndrome
      const n = this.flips.size;
      const verdict = n === 0 ? 'no error' : n === 1 ? `flip at position ${syn}: corrected` : `points at position ${syn}, but ${n} bits were flipped: decoding fails`;
      this.querySelector('[data-stat]')!.textContent = `syndrome = ${syn.toString(2).padStart(3, '0')} (binary) = ${syn} · ${verdict}`;
    }
  }
  customElements.define('hamming-code', HammingCode);
</script>
