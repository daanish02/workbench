---
import Figure from '../Figure.astro';
---

<Figure
  title="Each layer reaches one hop further"
  caption="Click a node to make it the target (yellow). Each Step adds one message-passing layer and colours the nodes whose features can now influence the target's state: 1 hop (blue), 2 hops (green), 3 hops (red). Nodes that stay grey are outside the receptive field; no number of training steps lets their features affect this node until more layers are added."
>
  <message-hops>
    <div class="mh2-ctl">
      <button type="button" class="btn primary" data-step-btn>Step</button>
      <button type="button" class="btn" data-auto-step aria-pressed="false">Auto</button>
      <button type="button" class="btn" data-reset>Reset</button>
    </div>
    <svg class="mh2-svg" viewBox="0 0 400 200" role="img" aria-label="Receptive field of one node after several message-passing layers">
      <g data-g></g>
    </svg>
    <p class="mh2-stat" data-stat aria-live="polite"></p>
  </message-hops>
</Figure>

<style>
  .mh2-ctl {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
  }
  .mh2-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .mh2-svg :global(.mh2-n) {
    cursor: pointer;
  }
  .mh2-svg :global(.mh2-t) {
    fill: var(--text);
    font: 10px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
    pointer-events: none;
  }
  .mh2-stat {
    margin: 10px 0 0;
    font: 0.875rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  const POS = [
    [40, 100], [90, 50], [90, 150], [150, 100], [210, 45], [210, 155],
    [270, 100], [320, 40], [330, 160], [370, 100], [150, 175], [250, 15],
  ];
  const EDGES = [
    [0, 1], [0, 2], [1, 3], [2, 3], [3, 4], [3, 5], [4, 6], [5, 6],
    [6, 7], [6, 8], [7, 9], [8, 9], [2, 10], [4, 11], [5, 10],
  ];
  const N = POS.length;
  const MAX = 3;
  const COL = ['#fbbc05', '#4285f4', '#34a853', '#ea4335'];
  const NB: number[][] = Array.from({ length: N }, () => []);
  for (const [a, b] of EDGES) {
    NB[a].push(b);
    NB[b].push(a);
  }

  class MessageHops extends HTMLElement {
    k = 0;
    target = 0;
    connectedCallback() {
      this.querySelector('[data-step-btn]')!.addEventListener('click', () => this.step());
      this.querySelector('[data-reset]')!.addEventListener('click', () => this.reset());
      this.querySelector('[data-g]')!.addEventListener('click', (e) => {
        const n = (e.target as Element).closest('[data-n]');
        if (!n) return;
        this.target = +n.getAttribute('data-n')!;
        this.reset();
      });
      this.reset();
    }
    reset() {
      this.k = 0;
      (this.querySelector('[data-step-btn]') as HTMLButtonElement).disabled = false;
      this.draw();
    }
    step() {
      if (this.k >= MAX) return;
      this.k++;
      this.draw();
      if (this.k >= MAX) (this.querySelector('[data-step-btn]') as HTMLButtonElement).disabled = true;
    }
    hops() {
      const d = Array(N).fill(Infinity);
      d[this.target] = 0;
      const q = [this.target];
      while (q.length) {
        const v = q.shift()!;
        for (const u of NB[v]) if (d[u] === Infinity) {
          d[u] = d[v] + 1;
          q.push(u);
        }
      }
      return d;
    }
    draw() {
      const d = this.hops();
      let html = '';
      for (const [a, b] of EDGES) {
        const on = d[a] <= this.k && d[b] <= this.k;
        html += `<line x1="${POS[a][0]}" y1="${POS[a][1]}" x2="${POS[b][0]}" y2="${POS[b][1]}" style="stroke:${on ? 'var(--text-muted)' : 'var(--border)'};stroke-width:2"></line>`;
      }
      POS.forEach(([x, y], i) => {
        const h = d[i];
        const c = h <= this.k ? COL[h] : null;
        html += `<g class="mh2-n" data-n="${i}"><circle cx="${x}" cy="${y}" r="12" style="fill:var(--bg)"></circle><circle cx="${x}" cy="${y}" r="12" style="fill:${c ?? 'transparent'};fill-opacity:0.5;stroke:${c ?? 'var(--text-faint)'};stroke-width:2"></circle><text x="${x}" y="${y}" class="mh2-t">${i}</text></g>`;
      });
      this.querySelector('[data-g]')!.innerHTML = html;
      const reached = d.filter((h) => h <= this.k).length;
      this.querySelector('[data-stat]')!.textContent =
        `${this.k} layer${this.k === 1 ? '' : 's'} · node ${this.target} sees ${reached} of ${N} nodes${this.k === 0 ? ' (only itself)' : ''}`;
    }
  }
  customElements.define('message-hops', MessageHops);
</script>
