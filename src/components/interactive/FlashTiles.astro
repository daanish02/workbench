---
import Figure from '../Figure.astro';
---

<Figure
  title="FlashAttention walks the table in tiles"
  caption="The n × n score table split into 4 × 4 tiles: rows are blocks of queries, columns blocks of keys and values. Each Step loads one query block and one key/value block into on-chip SRAM, computes that tile's scores (yellow), folds them into the running max, sum and output, and discards them (green = done, never written to HBM). After the last key block of a row, the finished output rows are written out. Standard attention would instead write the whole table to HBM, 32 MiB per head at n = 4096 in 16-bit floats, and read it back."
>
  <flash-tiles>
    <div class="ft-ctl">
      <button type="button" class="btn primary" data-step-btn>Step</button>
      <button type="button" class="btn" data-auto-step aria-pressed="false">Auto</button>
      <button type="button" class="btn" data-reset>Reset</button>
    </div>
    <svg class="ft-svg" viewBox="0 0 400 200" role="img" aria-label="Tiles of the attention score table processed one at a time">
      <g data-g></g>
    </svg>
    <p class="ft-stat" data-stat aria-live="polite"></p>
  </flash-tiles>
</Figure>

<style>
  .ft-ctl {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
  }
  .ft-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .ft-svg :global(.ft-t) {
    fill: var(--text-muted);
    font: 10px var(--font-mono);
    dominant-baseline: middle;
  }
  .ft-svg :global(.ft-h) {
    fill: var(--text);
    font: 11px var(--font-mono);
  }
  .ft-stat {
    margin: 10px 0 0;
    font: 0.8125rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
    min-height: 3.2em;
  }
</style>

<script>
  const T = 4;
  const STEPS = T * T;
  const X0 = 50;
  const Y0 = 34;
  const C = 36;

  class FlashTiles extends HTMLElement {
    k = 0;
    connectedCallback() {
      this.querySelector('[data-step-btn]')!.addEventListener('click', () => this.step());
      this.querySelector('[data-reset]')!.addEventListener('click', () => this.reset());
      this.reset();
    }
    reset() {
      this.k = 0;
      (this.querySelector('[data-step-btn]') as HTMLButtonElement).disabled = false;
      this.draw();
    }
    step() {
      if (this.k >= STEPS) return;
      this.k++;
      this.draw();
      if (this.k >= STEPS) (this.querySelector('[data-step-btn]') as HTMLButtonElement).disabled = true;
    }
    draw() {
      const cur = this.k - 1;
      const qi = cur >= 0 ? Math.floor(cur / T) : -1;
      const kj = cur >= 0 ? cur % T : -1;
      let html = `<text x="${X0}" y="12" class="ft-h">score table (never stored)</text>`;
      for (let i = 0; i < T; i++) {
        html += `<text x="${X0 - 6}" y="${Y0 + i * C + C / 2}" class="ft-t" style="text-anchor:end">Q${i + 1}</text>`;
        html += `<text x="${X0 + i * C + C / 2}" y="${Y0 - 9}" class="ft-t" style="text-anchor:middle">KV${i + 1}</text>`;
        for (let j = 0; j < T; j++) {
          const idx = i * T + j;
          const fill = idx === cur ? 'rgba(251,188,5,0.75)' : idx < cur ? 'rgba(52,168,83,0.45)' : 'transparent';
          html += `<rect x="${X0 + j * C + 2}" y="${Y0 + i * C + 2}" width="${C - 4}" height="${C - 4}" rx="3" style="fill:${fill};stroke:var(--border)"></rect>`;
        }
      }
      // SRAM and HBM panels
      const sx = 230;
      html += `<text x="${sx}" y="12" class="ft-h">SRAM (on chip)</text>`;
      html += `<rect x="${sx}" y="22" width="160" height="78" rx="6" style="fill:rgba(251,188,5,0.08);stroke:var(--g-yellow)"></rect>`;
      const sram = cur >= 0 ? [`Q${qi + 1} block`, `K${kj + 1}, V${kj + 1} blocks`, `running max, sum, O${qi + 1}`] : ['empty'];
      sram.forEach((s, r) => (html += `<text x="${sx + 10}" y="${40 + r * 20}" class="ft-t">${s}</text>`));
      html += `<text x="${sx}" y="122" class="ft-h">HBM (GPU memory)</text>`;
      html += `<rect x="${sx}" y="132" width="160" height="58" rx="6" style="fill:rgba(66,133,244,0.1);stroke:var(--g-blue)"></rect>`;
      const rowsDone = cur < 0 ? 0 : kj === T - 1 ? qi + 1 : qi;
      html += `<text x="${sx + 10}" y="150" class="ft-t">Q, K, V (read in blocks)</text>`;
      html += `<text x="${sx + 10}" y="172" class="ft-t">O rows written: ${rowsDone} of ${T}</text>`;
      this.querySelector('[data-g]')!.innerHTML = html;
      let msg = 'Press Step to load the first pair of blocks.';
      if (cur >= 0) {
        msg = `tile Q${qi + 1} × KV${kj + 1}: scores computed in SRAM, running max and sum rescaled, scores discarded`;
        if (kj === T - 1) msg += ` · output block O${qi + 1} final, written to HBM`;
      }
      if (this.k === STEPS) msg = 'done: exact attention output, and no n × n table ever reached HBM';
      this.querySelector('[data-stat]')!.textContent = msg;
    }
  }
  customElements.define('flash-tiles', FlashTiles);
</script>
