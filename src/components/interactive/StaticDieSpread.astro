---
import Figure from '../Figure.astro';

// Fair die PMF with the mean 3.5 and the band one standard deviation either side.
const faces = [1, 2, 3, 4, 5, 6];
const mu = 3.5;
const sd = Math.sqrt(35 / 12);
const baseY = 165;
const sx = (x: number) => 40 + (x - 0.5) * 60;
const h = 120;
---

<Figure
  kind="Diagram"
  title="Mean and spread of a die"
  caption="Each face has probability 1/6. The dashed line is the mean 3.5. The shaded band runs one standard deviation (about 1.71) either side of it, and covers the faces 2 to 5."
>
  <svg class="sp-svg" viewBox="0 0 440 200" role="img" aria-label="Six equal bars for die faces 1 to 6, with a dashed mean line at 3.5 and a shaded band of one standard deviation either side.">
    <rect x={sx(mu - sd)} y="30" width={sx(mu + sd) - sx(mu - sd)} height={baseY - 30} class="sp-band"></rect>
    {faces.map((k) => (
      <g>
        <rect x={sx(k) - 16} y={baseY - h} width="32" height={h} class="sp-bar"></rect>
        <text x={sx(k)} y={baseY + 16} class="sp-t">{k}</text>
      </g>
    ))}
    <line x1={sx(mu)} y1="22" x2={sx(mu)} y2={baseY} class="sp-mean"></line>
    <line x1="20" y1={baseY} x2="420" y2={baseY} class="sp-axis"></line>
    <text x={sx(mu)} y="16" class="sp-t sp-strong">mean 3.5</text>
    <text x={sx(mu - sd)} y="44" class="sp-t">−1 SD</text>
    <text x={sx(mu + sd)} y="44" class="sp-t">+1 SD</text>
  </svg>
</Figure>

<style>
  .sp-svg {
    display: block;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
  }
  .sp-bar {
    fill: var(--g-blue);
    opacity: 0.85;
  }
  .sp-band {
    fill: rgba(251, 188, 4, 0.18);
  }
  .sp-mean {
    stroke: #9aa0a6;
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .sp-axis {
    stroke: #3c4043;
    stroke-width: 1;
  }
  .sp-t {
    fill: var(--text-muted);
    font: 11px var(--font-mono);
    text-anchor: middle;
  }
  .sp-strong {
    fill: var(--text);
  }
</style>
