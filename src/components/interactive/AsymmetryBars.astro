---
import Figure from '../Figure.astro';

// p = (1/2, 1/2) and q = (9/10, 1/10): the two directions of KL divergence, in bits.
const forward = 0.737; // D(p || q)
const reverse = 0.531; // D(q || p)
const scale = 140 / 1;
---

<Figure
  kind="Diagram"
  title="KL divergence is not symmetric"
  caption="For p = (1/2, 1/2) and q = (9/10, 1/10), the two directions give different values. D(p‖q) is 0.737 bits and D(q‖p) is 0.531 bits. The direction decides which mismatch is penalised."
>
  <svg class="ab-svg" viewBox="0 0 400 200" role="img" aria-label="Two bars: D of p from q is 0.737 bits, D of q from p is 0.531 bits">
    <line x1="60" y1="170" x2="340" y2="170" class="ab-axis"></line>
    <rect x="100" y={170 - forward * scale} width="80" height={forward * scale} class="ab-a"></rect>
    <rect x="240" y={170 - reverse * scale} width="80" height={reverse * scale} class="ab-b"></rect>
    <text x="140" y={170 - forward * scale - 6} class="ab-v">{forward.toFixed(3)}</text>
    <text x="280" y={170 - reverse * scale - 6} class="ab-v">{reverse.toFixed(3)}</text>
    <text x="140" y="188" class="ab-t">D(p‖q)</text>
    <text x="280" y="188" class="ab-t">D(q‖p)</text>
  </svg>
</Figure>

<style>
  .ab-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .ab-axis {
    stroke: #3c4043;
    stroke-width: 1;
  }
  .ab-a {
    fill: var(--g-blue);
  }
  .ab-b {
    fill: var(--g-yellow);
  }
  .ab-v {
    fill: var(--text);
    font: 600 12px var(--font-mono);
    text-anchor: middle;
  }
  .ab-t {
    fill: var(--text-muted);
    font: 12px var(--font-mono);
    text-anchor: middle;
  }
</style>
