---
import Figure from '../Figure.astro';
---

<Figure
  title="The dual variable is a price"
  caption="The primal from this note with the right-hand side made adjustable: minimise x₁ + 2x₂ subject to x₁ + x₂ ≥ b and x ≥ 0. The optimal cost is drawn against b. Its slope is the dual solution y = 1: each extra unit demanded costs exactly one more unit of objective."
>
  <shadow-price>
    <label class="sp-lbl">b <input type="range" min="0" max="6" step="0.1" value="3" data-b /> <b data-bv>3.0</b></label>
    <div class="axes" style="--ax-w: 420px">
      <span class="ax-y">optimal cost</span>
      <svg class="sp-svg" viewBox="0 0 340 200" data-grid='{"box":[30,10,330,180],"x":[0,6],"y":[0,6]}' role="img" aria-label="Optimal cost against the constraint level">
        <line x1="30" y1="180" x2="330" y2="180" class="sp-ax"></line>
        <line x1="30" y1="10" x2="30" y2="180" class="sp-ax"></line>
        <text x="305" y="196" class="sp-t">b = 6</text><text x="2" y="16" class="sp-t">6</text>
        <line x1="30" y1="180" x2="330" y2="10" class="sp-curve"></line>
        <line data-tan class="sp-tan"></line>
        <circle data-pt r="4" class="sp-pt"></circle>
      </svg>
      <span class="ax-x">right-hand side b</span>
    </div>
    <p class="sp-stat" data-stat></p>
  </shadow-price>
</Figure>

<style>
  .sp-lbl { display: flex; align-items: center; gap: 10px; font-size: 0.875rem; color: var(--text-muted); margin-bottom: 12px; }
  .sp-lbl input { flex: 1; }
  .sp-svg { display: block; width: 100%; max-width: 420px; margin: 0 auto; }
  .sp-ax { stroke: #3c4043; }
  .sp-t { fill: var(--text-faint); font: 0.625rem var(--font-mono); }
  .sp-curve { stroke: var(--g-blue); stroke-width: 2; }
  .sp-tan { stroke: var(--g-yellow); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .sp-pt { fill: var(--g-yellow); }
  .sp-stat { margin: 10px 0 0; font: 0.875rem/1.6 var(--font-mono); color: var(--text-muted); text-align: center; }
</style>

<script>
  const sx = (b: number) => 30 + (b / 6) * 300;
  const sy = (v: number) => 180 - (v / 6) * 170;
  class ShadowPrice extends HTMLElement {
    connectedCallback() {
      this.querySelector('[data-b]')!.addEventListener('input', () => this.draw());
      this.draw();
    }
    draw() {
      const b = +this.querySelector<HTMLInputElement>('[data-b]')!.value;
      this.querySelector('[data-bv]')!.textContent = b.toFixed(1);
      // optimum: put everything on the cheaper variable x1, so cost = b, dual y = 1
      const cost = b;
      const pt = this.querySelector('[data-pt]')!;
      pt.setAttribute('cx', String(sx(b))); pt.setAttribute('cy', String(sy(cost)));
      const t = this.querySelector('[data-tan]')!;
      t.setAttribute('x1', String(sx(b))); t.setAttribute('y1', String(sy(cost)));
      t.setAttribute('x2', String(sx(Math.min(6, b + 1)))); t.setAttribute('y2', String(sy(Math.min(6, b + 1)))); // slope y = 1
      this.querySelector('[data-stat]')!.textContent =
        `optimum x = (${b.toFixed(1)}, 0), cost ${cost.toFixed(1)} · dual y = 1, dual value b·y = ${b.toFixed(1)} · raising b by 1 raises the cost by y = 1`;
    }
  }
  customElements.define('shadow-price', ShadowPrice);
</script>
