---
import Figure from '../Figure.astro';
---

<Figure
  title="Clipping by norm keeps the direction"
  caption="A two-parameter gradient (red when it is longer than the threshold). Clipping by norm (green) shrinks it onto the circle and keeps its direction. Clipping by value (yellow) cuts each coordinate to the square, which bends the direction towards the diagonal. Inside the threshold neither changes anything."
>
  <clip-vector>
    <label class="cv-lbl">g₁ <input type="range" min="-5" max="5" step="0.1" value="4" data-gx /> <b data-gxv>4.0</b></label>
    <label class="cv-lbl">g₂ <input type="range" min="-5" max="5" step="0.1" value="1" data-gy /> <b data-gyv>1.0</b></label>
    <label class="cv-lbl">threshold <input type="range" min="0.5" max="4" step="0.1" value="2" data-c /> <b data-cv>2.0</b></label>
    <div class="axes" style="--ax-w: 300px">
      <span class="ax-y">g₂</span>
      <svg class="cv-svg" viewBox="0 0 300 300" data-grid='{"box":[10,10,290,290],"x":[-5,5],"y":[-5,5]}' role="img" aria-label="Gradient vector with its norm-clipped and value-clipped versions">
        <defs>
          <marker id="cv-raw" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M0,0 L10,5 L0,10 Z" style="fill: var(--g-blue)"></path>
          </marker>
          <marker id="cv-over" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M0,0 L10,5 L0,10 Z" style="fill: var(--g-red)"></path>
          </marker>
          <marker id="cv-val" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M0,0 L10,5 L0,10 Z" style="fill: var(--g-yellow)"></path>
          </marker>
          <marker id="cv-norm" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M0,0 L10,5 L0,10 Z" style="fill: var(--g-green)"></path>
          </marker>
        </defs>
        <line x1="10" y1="150" x2="290" y2="150" class="cv-axis"></line>
        <line x1="150" y1="10" x2="150" y2="290" class="cv-axis"></line>
        <circle data-circle cx="150" cy="150" class="cv-circle"></circle>
        <rect data-square class="cv-square"></rect>
        <line data-raw x1="150" y1="150" class="cv-raw" marker-end="url(#cv-raw)"></line>
        <line data-val x1="150" y1="150" class="cv-val" marker-end="url(#cv-val)"></line>
        <line data-norm x1="150" y1="150" class="cv-norm" marker-end="url(#cv-norm)"></line>
      </svg>
      <span class="ax-x">g₁</span>
    </div>
    <p class="cv-stat" data-stat></p>
  </clip-vector>
</Figure>

<style>
  .cv-lbl {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .cv-lbl input[type='range'] {
    flex: 1;
  }
  .cv-svg {
    display: block;
    width: 100%;
    max-width: 300px;
  }
  .cv-axis {
    stroke: var(--text-faint);
    stroke-width: 1;
  }
  .cv-circle {
    fill: rgba(52, 168, 83, 0.1);
    stroke: var(--g-green);
    stroke-dasharray: 4 3;
  }
  .cv-square {
    fill: none;
    stroke: var(--g-yellow);
    stroke-dasharray: 2 3;
  }
  .cv-raw,
  .cv-val,
  .cv-norm {
    stroke-width: 2.5;
  }
  .cv-raw {
    stroke: var(--g-blue);
  }
  .cv-raw.over {
    stroke: var(--g-red);
  }
  .cv-val {
    stroke: var(--g-yellow);
  }
  .cv-norm {
    stroke: var(--g-green);
  }
  .cv-stat {
    margin: 10px 0 0;
    font: 0.875rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  // 28 SVG units per gradient unit, origin at (150, 150), y up.
  const S = 28;
  const set = (el: Element, x: number, y: number) => {
    el.setAttribute('x2', (150 + x * S).toFixed(1));
    el.setAttribute('y2', (150 - y * S).toFixed(1));
  };
  const deg = (x: number, y: number) => (Math.atan2(y, x) * 180) / Math.PI;

  class ClipVector extends HTMLElement {
    connectedCallback() {
      ['[data-gx]', '[data-gy]', '[data-c]'].forEach((s) => this.querySelector(s)!.addEventListener('input', () => this.draw()));
      this.draw();
    }
    draw() {
      const gx = +this.querySelector<HTMLInputElement>('[data-gx]')!.value;
      const gy = +this.querySelector<HTMLInputElement>('[data-gy]')!.value;
      const c = +this.querySelector<HTMLInputElement>('[data-c]')!.value;
      this.querySelector('[data-gxv]')!.textContent = gx.toFixed(1);
      this.querySelector('[data-gyv]')!.textContent = gy.toFixed(1);
      this.querySelector('[data-cv]')!.textContent = c.toFixed(1);

      const n = Math.hypot(gx, gy);
      const k = n > c ? c / n : 1;
      const vx = Math.max(-c, Math.min(c, gx));
      const vy = Math.max(-c, Math.min(c, gy));

      this.querySelector('[data-circle]')!.setAttribute('r', `${c * S}`);
      const sq = this.querySelector('[data-square]')!;
      sq.setAttribute('x', `${150 - c * S}`);
      sq.setAttribute('y', `${150 - c * S}`);
      sq.setAttribute('width', `${2 * c * S}`);
      sq.setAttribute('height', `${2 * c * S}`);
      const raw = this.querySelector('[data-raw]')!;
      raw.classList.toggle('over', n > c);
      raw.setAttribute('marker-end', `url(#cv-${n > c ? 'over' : 'raw'})`);
      set(raw, gx, gy);
      set(this.querySelector('[data-val]')!, vx, vy);
      set(this.querySelector('[data-norm]')!, gx * k, gy * k);

      const turn = n > 0 && Math.hypot(vx, vy) > 0 ? Math.abs(deg(gx, gy) - deg(vx, vy)) : 0;
      this.querySelector('[data-stat]')!.textContent =
        `‖g‖ = ${n.toFixed(2)} · by norm: ‖g‖ ${(n * k).toFixed(2)}, turned 0° · by value: (${vx.toFixed(1)}, ${vy.toFixed(1)}), turned ${Math.min(turn, 360 - turn).toFixed(1)}°`;
    }
  }
  customElements.define('clip-vector', ClipVector);
</script>
