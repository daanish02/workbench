---
import Figure from '../Figure.astro';
---

<Figure
  title="Ax is a combination of the columns"
  caption="A has columns a₁ = (2, 0) and a₂ = (1, 3), the matrix from this note. Set the entries of x: the output Ax is built by walking x₁ copies of a₁ and then x₂ copies of a₂. The default x = (1, 2) lands on (4, 6), the product computed above."
>
  <column-combination>
    <div class="cc2-ctl">
      <label class="cc2-lbl">x₁ <input type="range" min="-2" max="2" step="0.1" value="1" data-x1 /> <b data-x1v>1.0</b></label>
      <label class="cc2-lbl">x₂ <input type="range" min="-2" max="2" step="0.1" value="2" data-x2 /> <b data-x2v>2.0</b></label>
    </div>
    <svg class="cc2-svg" viewBox="-7 -7 14 14" role="img" aria-label="Two scaled column vectors placed head to tail">
      <defs>
        <marker id="cc2-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="currentColor"></path></marker>
      </defs>
      <g transform="scale(1,-1)">
        <g data-grid></g>
        <line data-s1 class="cc2-a1" marker-end="url(#cc2-arrow)"></line>
        <line data-s2 class="cc2-a2" marker-end="url(#cc2-arrow)"></line>
        <line data-out class="cc2-out" marker-end="url(#cc2-arrow)"></line>
      </g>
    </svg>
    <p class="cc2-stat" data-stat></p>
  </column-combination>
</Figure>

<style>
  .cc2-ctl { display: grid; gap: 10px; margin-bottom: 12px; }
  .cc2-lbl { display: flex; align-items: center; gap: 10px; font-size: 0.875rem; color: var(--text-muted); }
  .cc2-lbl input { flex: 1; }
  .cc2-svg { display: block; width: 100%; max-width: 320px; margin: 0 auto; }
  .cc2-svg :global(.cc2-g) { stroke: #262626; stroke-width: 0.03; }
  .cc2-a1 { stroke: var(--g-blue); color: var(--g-blue); stroke-width: 0.12; }
  .cc2-a2 { stroke: var(--g-green); color: var(--g-green); stroke-width: 0.12; }
  .cc2-out { stroke: var(--g-yellow); color: var(--g-yellow); stroke-width: 0.08; stroke-dasharray: 0.3 0.2; }
  .cc2-stat { margin: 10px 0 0; font: 0.875rem/1.6 var(--font-mono); color: var(--text-muted); text-align: center; }
</style>

<script>
  const A1 = [2, 0];
  const A2 = [1, 3];
  class ColumnCombination extends HTMLElement {
    connectedCallback() {
      let g = '';
      for (let i = -6; i <= 6; i++) g += `<line class="cc2-g" x1="${i}" y1="-7" x2="${i}" y2="7"></line><line class="cc2-g" x1="-7" y1="${i}" x2="7" y2="${i}"></line>`;
      this.querySelector('[data-grid]')!.innerHTML = g;
      this.querySelectorAll('input').forEach((el) => el.addEventListener('input', () => this.draw()));
      this.draw();
    }
    seg(sel: string, a: number[], b: number[]) {
      const el = this.querySelector(sel)!;
      el.setAttribute('x1', String(a[0])); el.setAttribute('y1', String(a[1]));
      el.setAttribute('x2', String(b[0])); el.setAttribute('y2', String(b[1]));
    }
    draw() {
      const x1 = +this.querySelector<HTMLInputElement>('[data-x1]')!.value;
      const x2 = +this.querySelector<HTMLInputElement>('[data-x2]')!.value;
      this.querySelector('[data-x1v]')!.textContent = x1.toFixed(1);
      this.querySelector('[data-x2v]')!.textContent = x2.toFixed(1);
      const p = [x1 * A1[0], x1 * A1[1]];
      const q = [p[0] + x2 * A2[0], p[1] + x2 * A2[1]];
      this.seg('[data-s1]', [0, 0], p);
      this.seg('[data-s2]', p, q);
      this.seg('[data-out]', [0, 0], q);
      this.querySelector('[data-stat]')!.textContent =
        `Ax = ${x1.toFixed(1)}·(2, 0) + ${x2.toFixed(1)}·(1, 3) = (${q[0].toFixed(1)}, ${q[1].toFixed(1)})`;
    }
  }
  customElements.define('column-combination', ColumnCombination);
</script>
