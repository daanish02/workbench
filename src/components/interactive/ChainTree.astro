---
import Figure from '../Figure.astro';

// Dependency tree for z = f(x(t), y(t)): every route from t to z gives one product in the chain rule.
---

<Figure
  kind="Diagram"
  title="The routes from t to z"
  caption="z depends on x and y, and both depend on t. The chain rule adds one product per route: (∂z/∂x)(dx/dt) through x, and (∂z/∂y)(dy/dt) through y."
>
  <svg class="ct-svg" viewBox="0 0 360 200" role="img" aria-label="Tree diagram: t feeds x and y, which both feed z, with the derivative on each edge">
    <defs>
      <marker id="ct-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="ct-head"></path>
      </marker>
    </defs>
    <g class="ct-node"><circle cx="50" cy="100" r="22"></circle><text x="50" y="100">t</text></g>
    <g class="ct-node"><circle cx="170" cy="50" r="22"></circle><text x="170" y="50">x</text></g>
    <g class="ct-node"><circle cx="170" cy="150" r="22"></circle><text x="170" y="150">y</text></g>
    <g class="ct-node"><circle cx="300" cy="100" r="22"></circle><text x="300" y="100">z</text></g>
    <line x1="72" y1="90" x2="150" y2="60" class="ct-edge" marker-end="url(#ct-arrow)"></line>
    <line x1="72" y1="110" x2="150" y2="140" class="ct-edge" marker-end="url(#ct-arrow)"></line>
    <line x1="191" y1="60" x2="279" y2="90" class="ct-edge" marker-end="url(#ct-arrow)"></line>
    <line x1="191" y1="140" x2="279" y2="110" class="ct-edge" marker-end="url(#ct-arrow)"></line>
    <text x="104" y="62" class="ct-label">dx/dt</text>
    <text x="104" y="150" class="ct-label">dy/dt</text>
    <text x="225" y="62" class="ct-label">∂z/∂x</text>
    <text x="225" y="150" class="ct-label">∂z/∂y</text>
  </svg>
</Figure>

<style>
  .ct-svg {
    display: block;
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
  }
  .ct-node circle {
    fill: #1a1a1a;
    stroke: var(--g-blue);
    stroke-width: 1.5;
  }
  .ct-node text {
    fill: var(--text);
    font: 600 14px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .ct-edge {
    stroke: #5f6368;
    stroke-width: 1.5;
  }
  .ct-head {
    fill: #5f6368;
  }
  .ct-label {
    fill: var(--text-muted);
    font: 12px var(--font-mono);
    text-anchor: middle;
  }
</style>
