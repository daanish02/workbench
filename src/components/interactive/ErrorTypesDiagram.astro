---
import Figure from '../Figure.astro';

// Test statistic under H0 (centred at 0) and under H1 (centred at 2.5), both with standard deviation 1.
// The critical value 1.96 splits the axis: right of it rejects H0.
const crit = 1.96;
const mu1 = 2.5;
const xMin = -3.5, xMax = 5.5;
const px = (x: number) => 20 + ((x - xMin) / (xMax - xMin)) * 360;
const base = 170;
const scale = 120;
const pdf = (x: number, m: number) => Math.exp(-((x - m) ** 2) / 2) / Math.sqrt(2 * Math.PI);
const curve = (m: number, from: number, to: number) => {
  const pts: string[] = [];
  for (let i = 0; i <= 120; i++) {
    const x = from + ((to - from) * i) / 120;
    pts.push(`${i ? 'L' : 'M'}${px(x).toFixed(2)},${(base - pdf(x, m) * scale).toFixed(2)}`);
  }
  return pts.join(' ');
};
const area = (m: number, from: number, to: number) =>
  `${curve(m, from, to)} L${px(to).toFixed(2)},${base} L${px(from).toFixed(2)},${base} Z`;
const h0 = curve(0, xMin, xMax);
const h1 = curve(mu1, xMin, xMax);
---

<Figure
  kind="Diagram"
  title="Type I and Type II errors"
  caption="Under H₀ the test statistic is centred at 0; under H₁ it is centred at 2.5. Rejecting when the statistic exceeds 1.96 makes a Type I error with probability α (red, under H₀) and a Type II error with probability β (blue, under H₁ below the cutoff). Power is the rest of H₁, to the right of the cutoff."
>
  <svg class="et-svg" viewBox="0 0 400 200" role="img" aria-label="Two bell curves, one centred at 0 and one at 2.5, with the cutoff at 1.96 and the error areas shaded">
    <path d={area(0, crit, xMax)} class="et-alpha"></path>
    <path d={area(mu1, xMin, crit)} class="et-beta"></path>
    <path d={h0} class="et-h0"></path>
    <path d={h1} class="et-h1"></path>
    <line x1={px(crit)} y1="20" x2={px(crit)} y2={base} class="et-cut"></line>
    <line x1="20" y1={base} x2="380" y2={base} class="et-axis"></line>
    <text x={px(0)} y="186" class="et-t">0</text>
    <text x={px(mu1)} y="186" class="et-t">2.5</text>
    <text x={px(crit)} y="14" class="et-t">cutoff 1.96</text>
    <text x={px(crit) + 6} y="100" class="et-t et-left">α</text>
    <text x={px(1.0)} y="130" class="et-t">β</text>
    <text x={px(4.2)} y="120" class="et-t et-h1-label">H₁ power</text>
  </svg>
</Figure>

<style>
  .et-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .et-h0 {
    fill: none;
    stroke: #9aa0a6;
    stroke-width: 2;
  }
  .et-h1 {
    fill: none;
    stroke: var(--g-blue);
    stroke-width: 2;
  }
  .et-alpha {
    fill: rgba(234, 67, 53, 0.45);
  }
  .et-beta {
    fill: rgba(66, 133, 244, 0.35);
  }
  .et-cut {
    stroke: var(--g-yellow);
    stroke-width: 1.2;
    stroke-dasharray: 4 3;
  }
  .et-axis {
    stroke: #3c4043;
    stroke-width: 1;
  }
  .et-t {
    fill: var(--text-muted);
    font: 11px var(--font-mono);
    text-anchor: middle;
  }
  .et-left {
    text-anchor: start;
  }
  .et-h1-label {
    fill: var(--g-blue);
  }
</style>
