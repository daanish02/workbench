---
import Figure from '../Figure.astro';
---

<Figure
  title="How long you build on a stale requirement"
  caption="A year-long project. Each lane is a process model, divided into its planning cycles (waterfall plans once, a delivery model replans quarterly, agile every two weeks, continuous delivery every week). A requirement changes at the marked month; the red stretch is effort that keeps flowing into the outdated requirement until the next point where the plan is revisited. This is a deliberately simple model of why short feedback loops limit waste, not a forecast of any real project."
>
  <sdlc-feedback>
    <div class="ctl-row">
      <label class="stat">Requirement changes in month <input type="range" min="0.5" max="11.5" step="0.1" value="4.7" data-c /> <b data-cv>4.7</b></label>
    </div>
    <svg viewBox="0 0 400 150" class="sf-svg" data-svg aria-label="Planning cycles per model"></svg>
    <p class="sf-msg" data-msg></p>
  </sdlc-feedback>
</Figure>

<style>
  .sf-svg {
    width: 100%;
    max-width: 680px;
    display: block;
    margin: 10px auto 0;
    background: var(--bg-soft);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
  }
  .sf-svg :global(text) {
    font: 8.5px var(--font-mono);
    fill: var(--text-muted);
  }
  .sf-svg :global(.cyc) {
    fill: rgba(66, 133, 244, 0.28);
    stroke: var(--bg-soft);
    stroke-width: 1;
  }
  .sf-svg :global(.cyc.b) {
    fill: rgba(66, 133, 244, 0.16);
  }
  .sf-svg :global(.stale) {
    fill: rgba(234, 67, 53, 0.65);
  }
  .sf-svg :global(.chg) {
    stroke: var(--g-yellow);
    stroke-width: 1.5;
    stroke-dasharray: 3 2;
  }
  .sf-msg {
    margin: 12px 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    min-height: 4.4em;
  }
  input[type='range'] {
    width: 200px;
    vertical-align: middle;
  }
</style>

<script>
  const MODELS = [
    { n: 'Waterfall', c: 12 },
    { n: 'Quarterly', c: 3 },
    { n: 'Agile sprints', c: 0.5 },
    { n: 'Continuous', c: 0.25 },
  ];
  const stale = (at: number, c: number) => Math.ceil(at / c - 1e-9) * c - at;
  class SdlcFeedback extends HTMLElement {
    connectedCallback() {
      this.querySelector('[data-c]')!.addEventListener('input', () => this.draw());
      this.draw();
    }
    draw() {
      const at = +this.querySelector<HTMLInputElement>('[data-c]')!.value;
      this.querySelector('[data-cv]')!.textContent = at.toFixed(1);
      const X = (m: number) => 80 + (m / 12) * 310;
      let h = '';
      MODELS.forEach((m, i) => {
        const y = 14 + i * 30;
        h += `<text x="4" y="${y + 13}">${m.n}</text>`;
        for (let k = 0, t = 0; t < 12 - 1e-9; k++, t += m.c) h += `<rect class="cyc ${k % 2 ? 'b' : ''}" x="${X(t).toFixed(1)}" y="${y}" width="${((Math.min(m.c, 12 - t) / 12) * 310).toFixed(1)}" height="20"></rect>`;
        const s = stale(at, m.c);
        h += `<rect class="stale" x="${X(at).toFixed(1)}" y="${y + 6}" width="${Math.max(1.5, (s / 12) * 310).toFixed(1)}" height="8"></rect>`;
      });
      h += `<line class="chg" x1="${X(at)}" y1="6" x2="${X(at)}" y2="136"></line>`;
      [0, 3, 6, 9, 12].forEach((m) => (h += `<text x="${X(m) - 4}" y="147">${m}</text>`));
      this.querySelector('[data-svg]')!.innerHTML = h;
      const w = MODELS.map((m) => stale(at, m.c));
      this.querySelector('[data-msg]')!.textContent = `A change in month ${at.toFixed(1)} is absorbed after ${w[0].toFixed(1)} months of continued work with waterfall, ${w[1].toFixed(1)} with quarterly delivery, ${w[2].toFixed(2)} with two-week sprints and ${w[3].toFixed(2)} with weekly releases. The model reads: the shorter the planning cycle, the less effort piles up on a decision that has already changed. The price of short cycles is the overhead of planning, demos and releases every cycle.`;
    }
  }
  customElements.define('sdlc-feedback', SdlcFeedback);
</script>
