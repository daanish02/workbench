---
import Figure from '../Figure.astro';
---

<Figure
  title="Thin rectangles approach the area"
  caption="The area under f(x) = x² on [0, 1] is approximated by n rectangles. Use left or midpoint heights and increase n: the sum gets closer to the exact value 1/3, and the midpoint rule is more accurate for the same n."
>
  <riemann-sums>
    <div class="rs-ctl">
      <label>n <input type="range" min="1" max="60" step="1" value="6" data-n /><b data-nv>6</b></label>
      <button class="btn" data-method="left" aria-pressed="true">left</button>
      <button class="btn" data-method="mid" aria-pressed="false">midpoint</button>
    </div>
    <div class="axes" style="--ax-w: 380px">
      <span class="ax-y">f(x) = x²</span>
      <svg class="rs-svg" viewBox="-0.1 -1.1 1.2 1.3" data-grid='{"box":[-0.1,-1.1,1.1,0.2],"x":[-0.1,1.1],"y":[-0.2,1.1]}' role="img" aria-label="Rectangles under the curve x squared on the interval from 0 to 1">
        <line x1="-0.05" y1="0" x2="1.1" y2="0" class="rs-axis"></line>
        <g data-rects></g>
        <path data-curve class="rs-curve"></path>
      </svg>
      <span class="ax-x">x</span>
    </div>
    <p class="rs-stat" data-stat></p>
  </riemann-sums>
</Figure>

<style>
  .rs-ctl {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    font: 0.8125rem var(--font-mono);
    color: var(--text-muted);
  }
  .rs-ctl label {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 180px;
  }
  .rs-ctl input {
    flex: 1;
  }
  .rs-ctl b {
    min-width: 2em;
    text-align: right;
    color: var(--text);
  }
  .rs-svg {
    display: block;
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
  }
  .rs-svg :global(.rs-rect) {
    fill: rgba(66, 133, 244, 0.35);
    stroke: var(--g-blue);
    stroke-width: 0.004;
  }
  .rs-axis {
    stroke: #3c4043;
    stroke-width: 0.005;
  }
  .rs-curve {
    fill: none;
    stroke: var(--g-yellow);
    stroke-width: 0.01;
  }
  .rs-stat {
    margin: 10px 0 0;
    font: 0.8125rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  const f = (x: number) => x * x;

  class RiemannSums extends HTMLElement {
    method: 'left' | 'mid' = 'left';

    connectedCallback() {
      const pts: string[] = [];
      for (let i = 0; i <= 200; i++) {
        const x = i / 200;
        pts.push(`${i ? 'L' : 'M'}${x.toFixed(4)},${(-f(x)).toFixed(4)}`);
      }
      this.querySelector('[data-curve]')!.setAttribute('d', pts.join(' '));

      this.querySelector('[data-n]')!.addEventListener('input', () => this.draw());
      this.querySelectorAll<HTMLButtonElement>('[data-method]').forEach((b) =>
        b.addEventListener('click', () => {
          this.method = b.dataset.method === 'mid' ? 'mid' : 'left';
          this.querySelectorAll('[data-method]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          this.draw();
        }),
      );
      this.draw();
    }

    draw() {
      const n = +this.querySelector<HTMLInputElement>('[data-n]')!.value;
      this.querySelector('[data-nv]')!.textContent = String(n);
      const w = 1 / n;
      let sum = 0;
      let rects = '';
      for (let k = 0; k < n; k++) {
        const x0 = k * w;
        // height sampled at the left end or at the midpoint of each piece
        const sample = this.method === 'mid' ? x0 + w / 2 : x0;
        const h = f(sample);
        sum += h * w;
        rects += `<rect class="rs-rect" x="${x0.toFixed(5)}" y="${(-h).toFixed(5)}" width="${w.toFixed(5)}" height="${h.toFixed(5)}"></rect>`;
      }
      this.querySelector('[data-rects]')!.innerHTML = rects;
      const exact = 1 / 3;
      this.querySelector('[data-stat]')!.textContent =
        `${this.method === 'mid' ? 'midpoint' : 'left'} sum = ${sum.toFixed(5)} · exact 1/3 = ${exact.toFixed(5)} · error ${Math.abs(sum - exact).toExponential(2)}`;
    }
  }
  customElements.define('riemann-sums', RiemannSums);
</script>
