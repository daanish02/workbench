---
import Figure from '../Figure.astro';

// Tree for the code a = 0, b = 10, c = 110, d = 111. Leaves are the symbols; internal nodes are decision points.
const nodes = {
  root: { x: 200, y: 36 },
  n1: { x: 300, y: 110 },
  n2: { x: 340, y: 186 },
  a: { x: 100, y: 110 },
  b: { x: 230, y: 186 },
  c: { x: 300, y: 252 },
  d: { x: 380, y: 252 },
};
const edges: { from: keyof typeof nodes; to: keyof typeof nodes; bit: string }[] = [
  { from: 'root', to: 'a', bit: '0' },
  { from: 'root', to: 'n1', bit: '1' },
  { from: 'n1', to: 'b', bit: '0' },
  { from: 'n1', to: 'n2', bit: '1' },
  { from: 'n2', to: 'c', bit: '0' },
  { from: 'n2', to: 'd', bit: '1' },
];
const leaves: { key: keyof typeof nodes; label: string }[] = [
  { key: 'a', label: 'a  0' },
  { key: 'b', label: 'b  10' },
  { key: 'c', label: 'c  110' },
  { key: 'd', label: 'd  111' },
];
---

<Figure
  kind="Diagram"
  title="The Huffman code as a tree"
  caption="Each left edge is a 0 and each right edge is a 1. The path from the root to a leaf is that symbol's codeword. No codeword is a prefix of another, because every codeword ends at a leaf. The probabilities are a = 1/2, b = 1/4, c = d = 1/8."
>
  <svg class="pt-svg" viewBox="0 0 420 290" role="img" aria-label="Binary tree: a has code 0, b has 10, c has 110, d has 111">
    {edges.map((e) => {
      const p = nodes[e.from], q = nodes[e.to];
      const mx = (p.x + q.x) / 2, my = (p.y + q.y) / 2;
      return (
        <g>
          <line x1={p.x} y1={p.y} x2={q.x} y2={q.y} class="pt-edge"></line>
          <rect x={mx - 9} y={my - 9} width="18" height="18" rx="4" class="pt-pill"></rect>
          <text x={mx} y={my + 4} class="pt-bit">{e.bit}</text>
        </g>
      );
    })}
    <circle cx={nodes.root.x} cy={nodes.root.y} r="12" class="pt-inner"></circle>
    <text x={nodes.root.x} y={nodes.root.y} class="pt-pre">ε</text>
    <circle cx={nodes.n1.x} cy={nodes.n1.y} r="12" class="pt-inner"></circle>
    <text x={nodes.n1.x} y={nodes.n1.y} class="pt-pre">1</text>
    <circle cx={nodes.n2.x} cy={nodes.n2.y} r="12" class="pt-inner"></circle>
    <text x={nodes.n2.x} y={nodes.n2.y} class="pt-pre">11</text>
    {leaves.map((l) => (
      <g>
        <circle cx={nodes[l.key].x} cy={nodes[l.key].y} r="13" class="pt-leaf"></circle>
        <text x={nodes[l.key].x} y={nodes[l.key].y} class="pt-sym">{l.label.split('  ')[0]}</text>
        <text x={nodes[l.key].x} y={nodes[l.key].y + 30} class="pt-code">{l.label.split('  ')[1]}</text>
      </g>
    ))}
  </svg>
</Figure>

<style>
  .pt-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto 8px;
  }
  .pt-edge {
    stroke: #6b7075;
    stroke-width: 1.6;
  }
  .pt-pill {
    fill: #111;
    stroke: #2a2d31;
  }
  .pt-bit {
    fill: var(--g-yellow);
    font: 600 11px var(--font-mono);
    text-anchor: middle;
  }
  .pt-inner {
    fill: #1a1a1a;
    stroke: #6b7075;
    stroke-width: 1.5;
  }
  .pt-leaf {
    fill: var(--g-blue);
    stroke: #8ab4f8;
    stroke-width: 1.5;
  }
  .pt-pre {
    fill: var(--text-muted);
    font: 600 10px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .pt-sym {
    fill: #0d0d0d;
    font: 700 12px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .pt-code {
    fill: var(--text);
    font: 600 12px var(--font-mono);
    text-anchor: middle;
  }
</style>
