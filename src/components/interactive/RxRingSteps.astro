---
import Figure from '../Figure.astro';
---

<Figure
  title="A receive ring: the NIC fills, the driver drains"
  caption="Eight descriptors in host memory, used in a circle. Blue slots hold an empty buffer the NIC may fill; yellow slots hold a received frame the driver has not processed yet; green slots were just processed and refilled. One interrupt starts a polling phase in which the driver takes up to 4 frames per poll without further interrupts. When a burst finds no blue slot left, the NIC drops the frame (red) before the CPU ever sees it."
>
  <rx-ring-steps>
    <svg class="rr-svg" data-svg viewBox="0 0 440 250" role="img" aria-label="Receive descriptor ring"></svg>
    <p class="rr-msg" data-msg></p>
    <p class="rr-stat mono" data-stat></p>
    <div class="ctl-row">
      <button type="button" class="btn primary" data-step-btn>Step</button>
      <button type="button" class="btn" data-auto-step aria-pressed="false">Auto</button>
      <button type="button" class="btn" data-reset>Reset</button>
    </div>
  </rx-ring-steps>
</Figure>

<style>
  .rr-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 6px auto 0;
  }
  .rr-svg :global(circle.base) {
    fill: var(--bg);
  }
  .rr-svg :global(circle.slot) {
    stroke-width: 2;
  }
  .rr-svg :global(.posted) {
    fill: rgba(66, 133, 244, 0.18);
    stroke: var(--g-blue);
  }
  .rr-svg :global(.filled) {
    fill: rgba(251, 188, 5, 0.3);
    stroke: var(--g-yellow);
  }
  .rr-svg :global(.done) {
    fill: rgba(52, 168, 83, 0.3);
    stroke: var(--g-green);
  }
  .rr-svg :global(.drop) {
    fill: rgba(234, 67, 53, 0.3);
    stroke: var(--g-red);
  }
  .rr-svg :global(text) {
    fill: var(--text);
    font: 11px var(--font-mono);
    dominant-baseline: central;
  }
  .rr-svg :global(text.muted) {
    fill: var(--text-muted);
  }
  .rr-svg :global(.ptr) {
    stroke-width: 2;
  }
  .rr-msg {
    min-height: 2.8em;
    margin: 8px 0 4px;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .rr-stat {
    font-size: 0.8125rem;
    color: var(--text);
    margin: 0 0 8px;
  }
</style>

<script>
  const N = 8;
  const BUDGET = 4;
  type Ev = ['arrive', number] | ['irq'] | ['poll'];
  const SCRIPT: Ev[] = [['arrive', 3], ['irq'], ['poll'], ['arrive', 6], ['irq'], ['poll'], ['arrive', 7], ['poll'], ['poll']];

  interface Frame {
    slots: string[];
    nic: number;
    drv: number;
    got: number;
    delivered: number;
    dropped: number;
    irqs: number;
    newDrops: number;
    msg: string;
  }

  function frames(): Frame[] {
    const slots = Array(N).fill('posted');
    let nic = 0, drv = 0, waiting = 0, got = 0, delivered = 0, dropped = 0, irqs = 0, polling = false;
    const out: Frame[] = [{ slots: [...slots], nic, drv, got, delivered, dropped, irqs, newDrops: 0, msg: 'The driver has given the NIC 8 empty buffers (blue) by writing their addresses into the ring and telling the NIC through a doorbell register.' }];
    for (const ev of SCRIPT) {
      for (let i = 0; i < N; i++) if (slots[i] === 'done') slots[i] = 'posted';
      let msg = '';
      let newDrops = 0;
      if (ev[0] === 'arrive') {
        const n = ev[1];
        const room = N - waiting;
        const ok = Math.min(n, room);
        for (let k = 0; k < ok; k++) { slots[nic] = 'filled'; nic = (nic + 1) % N; }
        waiting += ok; got += n; newDrops = n - ok; dropped += newDrops;
        msg = `${n} frames arrive. The NIC DMAs ${ok} into free buffers and marks their descriptors done${newDrops ? `; ${newDrops} find no free buffer and are dropped` : ''}.` +
          (polling ? ' The driver is already polling, so no interrupt is raised.' : '');
      } else if (ev[0] === 'irq') {
        irqs++; polling = true;
        msg = 'The NIC raises one interrupt. The driver masks further interrupts from this queue and schedules a poll.';
      } else {
        const take = Math.min(BUDGET, waiting);
        for (let k = 0; k < take; k++) { slots[drv] = 'done'; drv = (drv + 1) % N; }
        waiting -= take; delivered += take;
        if (waiting === 0) polling = false;
        msg = `Poll: the driver passes ${take} frame${take === 1 ? '' : 's'} up the stack and refills those buffers (green).` +
          (waiting ? ` ${waiting} still wait, so it stays in polling mode.` : ' The ring is empty, so it re-enables the interrupt.');
      }
      out.push({ slots: [...slots], nic, drv, got, delivered, dropped, irqs, newDrops, msg });
    }
    return out;
  }

  class RxRingSteps extends HTMLElement {
    fr = frames();
    i = 0;
    connectedCallback() {
      this.querySelector('[data-step-btn]')!.addEventListener('click', () => {
        if (this.i < this.fr.length - 1) this.i++;
        this.draw();
      });
      this.querySelector('[data-reset]')!.addEventListener('click', () => {
        this.i = 0;
        this.draw();
      });
      this.draw();
    }
    draw() {
      const f = this.fr[this.i];
      const cx = 115, cy = 125, R = 80;
      const pos = (k: number, r = R) => {
        const a = -Math.PI / 2 + (k / N) * 2 * Math.PI;
        return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
      };
      let s = `<circle cx="${cx}" cy="${cy}" r="${R}" fill="none" stroke="var(--border)" stroke-dasharray="3 4" />`;
      s += `<text x="${cx}" y="${cy}" text-anchor="middle" class="muted">ring in RAM</text>`;
      for (let k = 0; k < N; k++) {
        const [x, y] = pos(k);
        s += `<circle class="base" cx="${x}" cy="${y}" r="17" />`;
        s += `<circle class="slot ${f.slots[k]}" cx="${x}" cy="${y}" r="17" /><text x="${x}" y="${y}" text-anchor="middle">${k}</text>`;
      }
      // pointers: where the NIC writes next (outside) and where the driver reads next (inside)
      const [nx, ny] = pos(f.nic, R + 32);
      const [dx, dy] = pos(f.drv, R - 38);
      s += `<text x="${nx}" y="${ny}" text-anchor="middle" style="fill: var(--g-yellow)">NIC</text>`;
      s += `<text x="${dx}" y="${dy}" text-anchor="middle" style="fill: var(--g-green)">drv</text>`;
      const legend: [string, string][] = [['posted', 'empty buffer'], ['filled', 'frame waiting'], ['done', 'processed, refilled'], ['drop', 'dropped, no buffer']];
      legend.forEach(([cls, label], k) => {
        const y = cy - 42 + k * 28;
        s += `<circle class="slot ${cls}" cx="272" cy="${y}" r="8" /><text x="288" y="${y}" class="muted">${label}</text>`;
      });
      for (let k = 0; k < f.newDrops; k++) s += `<circle class="slot drop" cx="${272 + k * 22}" cy="203" r="8" />`;
      if (f.newDrops) s += `<text x="264" y="226" class="muted">dropped this step</text>`;
      this.querySelector('[data-svg]')!.innerHTML = s;
      this.querySelector('[data-msg]')!.textContent = f.msg;
      this.querySelector('[data-stat]')!.textContent = `step ${this.i}/${this.fr.length - 1} · arrived ${f.got} · delivered ${f.delivered} · dropped ${f.dropped} · interrupts ${f.irqs}`;
      this.querySelector<HTMLButtonElement>('[data-step-btn]')!.disabled = this.i === this.fr.length - 1;
    }
  }
  customElements.define('rx-ring-steps', RxRingSteps);
</script>
