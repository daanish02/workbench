---
import Figure from '../Figure.astro';
---

<Figure
  kind="Diagram"
  title="Who holds which key"
  caption="Bob publishes the pair (n, e) and keeps d secret. Alice encrypts with the public pair; only the holder of d can reverse it. Anyone can see the ciphertext, but without d or the factors of n it does not reveal the message."
>
  <svg class="kf-svg" viewBox="0 0 400 236" role="img" aria-label="Alice encrypts a message with Bob's public key, the ciphertext travels openly, and Bob decrypts it with his private key">
    <defs>
      <marker id="kf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="kf-head"></path>
      </marker>
    </defs>
    <rect x="10" y="20" width="100" height="60" rx="8" class="kf-box"></rect>
    <text x="60" y="44" class="kf-t">Alice</text>
    <text x="60" y="64" class="kf-s">has m</text>
    <rect x="290" y="20" width="100" height="60" rx="8" class="kf-box"></rect>
    <text x="340" y="44" class="kf-t">Bob</text>
    <text x="340" y="64" class="kf-s">has d</text>
    <line x1="112" y1="50" x2="286" y2="50" class="kf-arr" marker-end="url(#kf-arrow)"></line>
    <text x="200" y="40" class="kf-lab">c = m^e mod n</text>
    <text x="200" y="62" class="kf-s" font-size="10">ciphertext travels openly</text>
    <rect x="130" y="110" width="140" height="40" rx="8" class="kf-pub"></rect>
    <text x="200" y="128" class="kf-t">public: (n, e)</text>
    <rect x="130" y="166" width="140" height="40" rx="8" class="kf-priv"></rect>
    <text x="200" y="184" class="kf-t">private: d</text>
    <line x1="60" y1="80" x2="130" y2="130" class="kf-link"></line>
    <line x1="340" y1="80" x2="270" y2="130" class="kf-link"></line>
    <line x1="340" y1="80" x2="270" y2="186" class="kf-link"></line>
    <text x="200" y="226" class="kf-note">m = c^d mod n recovers the message</text>
  </svg>
</Figure>

<style>
  .kf-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .kf-box {
    fill: #1a1a1a;
    stroke: var(--g-blue);
    stroke-width: 1.5;
  }
  .kf-pub {
    fill: rgba(66, 133, 244, 0.2);
    stroke: var(--g-blue);
  }
  .kf-priv {
    fill: rgba(234, 67, 53, 0.2);
    stroke: var(--g-red);
  }
  .kf-arr {
    stroke: #5f6368;
    stroke-width: 2;
  }
  .kf-link {
    stroke: #5f6368;
    stroke-width: 1.2;
    stroke-dasharray: 4 3;
  }
  .kf-head {
    fill: #5f6368;
  }
  .kf-t {
    fill: var(--text);
    font: 600 12px var(--font-mono);
    text-anchor: middle;
  }
  .kf-s,
  .kf-lab,
  .kf-note {
    fill: var(--text-muted);
    font: 11px var(--font-mono);
    text-anchor: middle;
  }
  .kf-lab {
    fill: var(--g-yellow);
  }
</style>
