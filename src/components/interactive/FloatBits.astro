---
import Figure from '../Figure.astro';
---

<Figure
  title="A 32-bit float, bit by bit"
  caption="Type a number or pick a preset; click any bit to flip it. Red is the sign, yellow the 8 exponent bits (bias 127), blue the 23 fraction bits. The readout shows the exact value those bits hold and how far it is from what you typed: 0.1 and 1/3 are rounded, 0.75 is exact, and 16777217 (2²⁴ + 1) rounds to 16777216."
>
  <float-bits>
    <div class="ctl-row">
      <label class="ctl-label" for="fb-x">Number</label>
      <input class="input" id="fb-x" data-x type="text" value="0.1" style="width:9em" />
      <span class="choice">
        <button type="button" class="btn" data-p="0.1" aria-pressed="true">0.1</button>
        <button type="button" class="btn" data-p="0.75" aria-pressed="false">0.75</button>
        <button type="button" class="btn" data-p="-2.5" aria-pressed="false">−2.5</button>
        <button type="button" class="btn" data-p="1/3" aria-pressed="false">1/3</button>
        <button type="button" class="btn" data-p="16777217" aria-pressed="false">2²⁴+1</button>
        <button type="button" class="btn" data-p="Infinity" aria-pressed="false">inf</button>
        <button type="button" class="btn" data-p="NaN" aria-pressed="false">NaN</button>
      </span>
    </div>
    <div class="fb-bits" data-bits role="group" aria-label="32 bits, click to flip"></div>
    <div class="fb-legend">
      <span class="s">sign</span><span class="e">exponent</span><span class="f">fraction</span>
    </div>
    <p class="fb-formula mono" data-formula></p>
    <p class="fb-stat mono" data-stat></p>
  </float-bits>
</Figure>

<style>
  .fb-bits {
    display: grid;
    grid-template-columns: repeat(32, 1fr);
    gap: 2px;
    margin: 14px 0 6px;
  }
  .fb-bits :global(button) {
    all: unset;
    cursor: pointer;
    text-align: center;
    font: 700 0.8125rem var(--font-mono);
    padding: 6px 0;
    border-radius: 4px;
    color: var(--text);
    background: rgba(66, 133, 244, 0.16);
  }
  .fb-bits :global(button.s) {
    background: rgba(234, 67, 53, 0.22);
  }
  .fb-bits :global(button.e) {
    background: rgba(251, 188, 5, 0.2);
  }
  .fb-bits :global(button.one) {
    outline: 1.5px solid currentColor;
  }
  .fb-bits :global(button.s.one) {
    color: var(--g-red-l);
  }
  .fb-bits :global(button.e.one) {
    color: var(--g-yellow-l);
  }
  .fb-bits :global(button.f.one) {
    color: var(--g-blue-l);
  }
  .fb-bits :global(button:focus-visible) {
    outline: 2px solid var(--text);
  }
  @media (max-width: 560px) {
    .fb-bits {
      grid-template-columns: repeat(16, 1fr);
    }
  }
  .fb-legend {
    display: flex;
    gap: 14px;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .fb-legend span::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    margin-right: 5px;
    vertical-align: -1px;
  }
  .fb-legend .s::before {
    background: var(--g-red);
  }
  .fb-legend .e::before {
    background: var(--g-yellow);
  }
  .fb-legend .f::before {
    background: var(--g-blue);
  }
  .fb-formula {
    margin: 12px 0 4px;
    font-size: 0.8125rem;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .fb-stat {
    margin: 0 0 4px;
    font-size: 0.8125rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }
  .fb-stat :global(.good) {
    color: var(--g-green-l);
  }
  .fb-stat :global(.bad) {
    color: var(--g-red-l);
  }
</style>

<script>
  // exact decimal expansion of the float32 held in `bits` (finite values only)
  function exact(bits: number): string {
    const sign = bits >>> 31 ? '-' : '';
    const e = (bits >>> 23) & 0xff;
    const f = bits & 0x7fffff;
    let m = BigInt(e === 0 ? f : f | 0x800000);
    let p = (e === 0 ? 1 : e) - 127 - 23; // value = m * 2^p
    if (m === 0n) return sign + '0';
    if (p >= 0) return sign + (m << BigInt(p)).toString();
    const k = -p; // m / 2^k = m * 5^k / 10^k
    const digits = (m * 5n ** BigInt(k)).toString().padStart(k + 1, '0');
    const int = digits.slice(0, -k);
    const frac = digits.slice(-k).replace(/0+$/, '');
    return sign + int + (frac ? '.' + frac : '');
  }

  class FloatBits extends HTMLElement {
    bits = 0;
    typed = '0.1';
    connectedCallback() {
      const input = this.querySelector<HTMLInputElement>('[data-x]')!;
      input.addEventListener('input', () => this.setText(input.value, null));
      this.querySelectorAll<HTMLButtonElement>('[data-p]').forEach((b) =>
        b.addEventListener('click', () => {
          input.value = b.dataset.p!;
          this.setText(b.dataset.p!, b);
        }),
      );
      this.querySelector('[data-bits]')!.addEventListener('click', (ev) => {
        const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-i]');
        if (!b) return;
        this.bits = (this.bits ^ (1 << (31 - +b.dataset.i!))) >>> 0;
        this.typed = '';
        this.press(null);
        this.draw();
      });
      this.setText('0.1', this.querySelector('[data-p]'));
    }
    press(on: Element | null) {
      this.querySelectorAll('[data-p]').forEach((x) => x.setAttribute('aria-pressed', String(x === on)));
    }
    parse(s: string): number {
      const t = s.trim();
      const frac = t.match(/^(-?[\d.]+)\s*\/\s*([\d.]+)$/);
      if (frac) return +frac[1] / +frac[2];
      return t === '' ? NaN : Number(t);
    }
    setText(s: string, btn: Element | null) {
      this.typed = s;
      this.press(btn);
      const dv = new DataView(new ArrayBuffer(4));
      dv.setFloat32(0, this.parse(s));
      this.bits = dv.getUint32(0);
      this.draw();
    }
    draw() {
      const b = this.bits;
      const cells: string[] = [];
      for (let i = 0; i < 32; i++) {
        const v = (b >>> (31 - i)) & 1;
        const cls = i === 0 ? 's' : i < 9 ? 'e' : 'f';
        cells.push(`<button type="button" data-i="${i}" class="${cls}${v ? ' one' : ''}" aria-label="bit ${31 - i} = ${v}">${v}</button>`);
      }
      this.querySelector('[data-bits]')!.innerHTML = cells.join('');
      const s = b >>> 31;
      const e = (b >>> 23) & 0xff;
      const f = b & 0x7fffff;
      const dv = new DataView(new ArrayBuffer(4));
      dv.setUint32(0, b);
      const val = dv.getFloat32(0);
      const fEl = this.querySelector('[data-formula]')!;
      const st = this.querySelector('[data-stat]')!;
      if (e === 255) {
        fEl.textContent = `sign = ${s} · exponent = 255 (all ones) · fraction = ${f}`;
        st.innerHTML = f ? `<span class="bad">NaN: exponent all ones, fraction nonzero</span>` : `<span class="bad">${s ? '−' : '+'}infinity: exponent all ones, fraction zero</span>`;
        return;
      }
      const kind = e === 0 ? (f === 0 ? 'zero' : 'subnormal') : 'normal';
      const lead = e === 0 ? '0' : '1';
      const pow = e === 0 ? -126 : e - 127;
      fEl.textContent = `(−1)^${s} × ${lead}.${f.toString(2).padStart(23, '0').replace(/0+$/, '') || '0'}₂ × 2^${pow}   (${kind}, exponent field ${e})`;
      const ex = exact(b);
      const typedNum = this.parse(this.typed);
      if (!this.typed || Number.isNaN(typedNum)) {
        st.innerHTML = `stored exactly = ${ex}`;
        return;
      }
      const err = Math.abs(val - typedNum);
      const same = err === 0;
      st.innerHTML = `stored exactly = ${ex} · error = <span class="${same ? 'good' : 'bad'}">${same ? '0 (exact)' : err.toExponential(3)}</span>`;
    }
  }
  customElements.define('float-bits', FloatBits);
</script>
