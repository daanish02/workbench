---
import Figure from '../Figure.astro';

// Four panels sharing one time axis: observed = trend + seasonal + remainder.
// The remainder is a fixed mix of sines so the figure is deterministic.
const months = Array.from({ length: 49 }, (_, i) => i);
const trend = (t: number) => 2 * t;
const seasonal = (t: number) => 5 * Math.sin((2 * Math.PI * t) / 12);
const remainder = (t: number) => 1.2 * Math.sin(t * 2.3) + 0.8 * Math.sin(t * 5.1 + 1);
const panels = [
  { label: 'observed', f: (t: number) => trend(t) + seasonal(t) + remainder(t) },
  { label: 'trend', f: trend },
  { label: 'seasonal', f: seasonal },
  { label: 'remainder', f: remainder },
];
const xOf = (t: number) => 60 + (t / 48) * 320;
const path = (f: (t: number) => number, top: number, half: number, range: number) =>
  months
    .map((t, i) => `${i ? 'L' : 'M'}${xOf(t).toFixed(2)},${(top + half - (f(t) / range) * half).toFixed(2)}`)
    .join(' ');
---

<Figure
  kind="Diagram"
  title="Trend, seasonality and remainder"
  caption="A monthly series split into parts. The observed series is the sum of the trend (a steady rise), the seasonal pattern (a yearly wave) and the remainder (irregular noise). Each panel uses its own scale."
>
  <div class="axes" style="--ax-w: 440px">
    <span class="ax-y">value</span>
    <svg class="dc-svg" viewBox="0 0 400 300" role="img" aria-label="Four stacked panels: observed series, trend, seasonal pattern and remainder over 48 months">
      {panels.map((p, i) => {
        const top = i * 72 + 4;
        const range = i === 0 ? 110 : i === 1 ? 100 : i === 2 ? 6 : 2.5;
        return (
          <g>
            <text x="4" y={top + 12} class="dc-t">{p.label}</text>
            <line x1="60" y1={top + 30} x2="380" y2={top + 30} class="dc-axis"></line>
            <path d={path(p.f, top, 30, range)} class="dc-line"></path>
          </g>
        );
      })}
    </svg>
    <span class="ax-x">month</span>
  </div>
</Figure>

<style>
  .dc-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .dc-axis {
    stroke: #3c4043;
    stroke-width: 0.8;
  }
  .dc-line {
    fill: none;
    stroke: var(--g-blue);
    stroke-width: 1.6;
  }
  .dc-t {
    fill: var(--text-muted);
    font: 11px var(--font-mono);
  }
</style>
