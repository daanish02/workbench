---
import Figure from '../Figure.astro';
---

<Figure kind="Diagram"
  title="The four regions of two sets"
  caption="Every element of the universe sits in one region: in A only, in both, in B only, or in neither. Union is everything inside either circle, intersection is the lens where they overlap, and the complement of A is everything outside the left circle."
>
  <svg class="sv-svg" viewBox="0 0 430 240" role="img" aria-label="Venn diagram with regions A only, A and B, B only, and neither">
    <rect x="2" y="2" width="426" height="236" class="sv-universe"></rect>
    <circle cx="125" cy="120" r="84" class="sv-a"></circle>
    <circle cx="245" cy="120" r="84" class="sv-b"></circle>
    <text x="60" y="30" class="sv-name">A</text>
    <text x="330" y="30" class="sv-name">B</text>
    <text x="75" y="125" class="sv-region">A only</text>
    <text x="185" y="125" class="sv-region">A ∩ B</text>
    <text x="295" y="125" class="sv-region">B only</text>
    <text x="395" y="125" class="sv-region">neither</text>
  </svg>
</Figure>

<style>
  .sv-svg {
    display: block;
    width: 100%;
    max-width: 430px;
    margin: 0 auto;
  }
  .sv-universe {
    fill: none;
    stroke: #3c4043;
    stroke-width: 1;
  }
  .sv-a,
  .sv-b {
    fill: rgba(66, 133, 244, 0.1);
    stroke: #9aa0a6;
    stroke-width: 2;
  }
  .sv-name {
    fill: var(--text-muted);
    font: 600 15px var(--font-mono);
  }
  .sv-region {
    fill: var(--text);
    font: 12px var(--font-mono);
    text-anchor: middle;
  }
</style>
