---
import Figure from '../Figure.astro';

// f(x) = x² on [0, 1] with n = 4 left rectangles; the curve is drawn for reference.
const n = 4;
const w = 1 / n;
const rects = Array.from({ length: n }, (_, k) => {
  const x0 = k * w;
  return { x: x0, h: x0 * x0 };
});
const sum = rects.reduce((s, r) => s + r.h * w, 0);
const curve = Array.from({ length: 101 }, (_, i) => {
  const x = i / 100;
  return `${i ? 'L' : 'M'}${x.toFixed(4)},${(-x * x).toFixed(4)}`;
}).join(' ');
---

<Figure
  kind="Diagram"
  title="Four left rectangles under x²"
  caption={`Each rectangle has width 1/4 and height equal to the curve at its left end. Together they give the sum ${sum.toFixed(4)}, which is below the exact area 1/3 ≈ 0.3333 because the curve rises across each piece.`}
>
  <svg class="srd-svg" viewBox="-0.08 -1.12 1.16 1.3" role="img" aria-label="Four left rectangles under the curve x squared from 0 to 1">
    <line x1="-0.05" y1="0" x2="1.1" y2="0" class="srd-axis"></line>
    {rects.map((r) => (
      <rect x={r.x.toFixed(4)} y={(-r.h).toFixed(4)} width={w.toFixed(4)} height={r.h.toFixed(4)} class="srd-rect"></rect>
    ))}
    <path d={curve} class="srd-curve"></path>
    <text x="0.01" y="0.06" class="srd-zero">height 0</text>
  </svg>
</Figure>

<style>
  .srd-svg {
    display: block;
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
  }
  .srd-axis {
    stroke: #3c4043;
    stroke-width: 0.01;
  }
  .srd-rect {
    fill: rgba(66, 133, 244, 0.35);
    stroke: var(--g-blue);
    stroke-width: 0.006;
  }
  .srd-curve {
    fill: none;
    stroke: var(--g-yellow);
    stroke-width: 0.01;
  }
  .srd-zero {
    fill: var(--text-muted);
    font: 0.05px var(--font-mono);
  }
</style>
