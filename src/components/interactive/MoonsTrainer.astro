---
import Figure from '../Figure.astro';
---

<Figure
  title="Backpropagation training a network, live"
  caption="The two-layer ReLU network from the note, trained in your browser with the same backward pass and full-batch gradient descent (learning rate 0.5). Each Step runs 25 updates. The background shows the network's predicted class (blue or green, paler where it is unsure); points it gets wrong have a red ring. With 2 hidden units the boundary can only bend once or twice; with 16 it wraps around both moons."
>
  <moons-trainer>
    <div class="mt-ctl">
      <input type="hidden" data-h value="16" />
      <span class="choice">
        <button type="button" class="btn" data-choice="2" aria-pressed="false">2 hidden units</button>
        <button type="button" class="btn" data-choice="4" aria-pressed="false">4</button>
        <button type="button" class="btn" data-choice="16" aria-pressed="true">16</button>
      </span>
    </div>
    <div class="mt-ctl">
      <button type="button" class="btn primary" data-step-btn>Step</button>
      <button type="button" class="btn" data-auto-step aria-pressed="false">Auto</button>
      <button type="button" class="btn" data-reset>Reset</button>
    </div>
    <div class="axes" style="--ax-w: 320px">
      <span class="ax-y">x₂</span>
      <canvas class="mt-canvas" width="320" height="260"></canvas>
      <span class="ax-x">x₁</span>
    </div>
    <p class="mt-stat" data-stat></p>
  </moons-trainer>
</Figure>

<style>
  .mt-ctl {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
  }
  .mt-canvas {
    display: block;
    width: 100%;
    max-width: 320px;
    height: auto;
  }
  .mt-stat {
    margin: 10px 0 0;
    font: 0.875rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  const STEPS = 40;
  const PER = 25;
  const LR = 0.5;
  const X0 = -1.5;
  const X1 = 2.5;
  const Y0 = -1.2;
  const Y1 = 1.6;

  function rng(seed: number) {
    let s = seed >>> 0;
    const u = () => {
      s = (s + 0x6d2b79f5) >>> 0;
      let t = s;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
    const n = () => Math.sqrt(-2 * Math.log(u() + 1e-12)) * Math.cos(2 * Math.PI * u());
    return { u, n };
  }

  // Two interleaved half-moons with noise 0.2, as in the note.
  const R = rng(11);
  const PTS: [number, number, number][] = [];
  for (let i = 0; i < 200; i++) {
    const t = R.u() * Math.PI;
    const c = i < 100 ? 0 : 1;
    const x = c ? 1 - Math.cos(t) : Math.cos(t);
    const y = c ? 0.5 - Math.sin(t) : Math.sin(t);
    PTS.push([x + 0.2 * R.n(), y + 0.2 * R.n(), c]);
  }

  class MoonsTrainer extends HTMLElement {
    i = 0;
    h = 16;
    W1: number[][] = [];
    b1: number[] = [];
    W2: number[][] = [];
    b2: number[] = [];
    connectedCallback() {
      this.querySelector('[data-step-btn]')!.addEventListener('click', () => this.step());
      this.querySelector('[data-reset]')!.addEventListener('click', () => this.reset());
      this.querySelector('[data-h]')!.addEventListener('input', () => this.reset());
      this.reset();
    }
    reset() {
      this.h = +this.querySelector<HTMLInputElement>('[data-h]')!.value;
      const r = rng(5);
      this.W1 = [0, 1].map(() => Array.from({ length: this.h }, () => r.n()));
      this.b1 = new Array(this.h).fill(0);
      this.W2 = Array.from({ length: this.h }, () => [r.n() * 0.01, r.n() * 0.01]);
      this.b2 = [0, 0];
      this.i = 0;
      (this.querySelector('[data-step-btn]') as HTMLButtonElement).disabled = false;
      this.draw();
    }
    // returns hidden activations and the softmax probabilities for one point
    forward(x: number, y: number): [number[], number[]] {
      const a = this.b1.map((b, j) => Math.max(0, x * this.W1[0][j] + y * this.W1[1][j] + b));
      const z = [0, 1].map((k) => this.b2[k] + a.reduce((s, v, j) => s + v * this.W2[j][k], 0));
      const m = Math.max(z[0], z[1]);
      const e = z.map((v) => Math.exp(v - m));
      const s = e[0] + e[1];
      return [a, [e[0] / s, e[1] / s]];
    }
    step() {
      if (this.i >= STEPS) return;
      const n = PTS.length;
      for (let it = 0; it < PER; it++) {
        const gW1 = [0, 1].map(() => new Array(this.h).fill(0));
        const gb1 = new Array(this.h).fill(0);
        const gW2 = Array.from({ length: this.h }, () => [0, 0]);
        const gb2 = [0, 0];
        for (const [x, y, c] of PTS) {
          const [a, p] = this.forward(x, y);
          const dz = [p[0] - (c === 0 ? 1 : 0), p[1] - (c === 1 ? 1 : 0)].map((v) => v / n);
          for (let j = 0; j < this.h; j++) {
            gW2[j][0] += a[j] * dz[0];
            gW2[j][1] += a[j] * dz[1];
            if (a[j] > 0) {
              const da = dz[0] * this.W2[j][0] + dz[1] * this.W2[j][1];
              gW1[0][j] += x * da;
              gW1[1][j] += y * da;
              gb1[j] += da;
            }
          }
          gb2[0] += dz[0];
          gb2[1] += dz[1];
        }
        for (let j = 0; j < this.h; j++) {
          this.W1[0][j] -= LR * gW1[0][j];
          this.W1[1][j] -= LR * gW1[1][j];
          this.b1[j] -= LR * gb1[j];
          this.W2[j][0] -= LR * gW2[j][0];
          this.W2[j][1] -= LR * gW2[j][1];
        }
        this.b2[0] -= LR * gb2[0];
        this.b2[1] -= LR * gb2[1];
      }
      this.i++;
      this.draw();
      if (this.i >= STEPS) (this.querySelector('[data-step-btn]') as HTMLButtonElement).disabled = true;
    }
    draw() {
      const cv = this.querySelector('canvas')!;
      const ctx = cv.getContext('2d')!;
      const W = cv.width;
      const H = cv.height;
      const cell = 8;
      ctx.clearRect(0, 0, W, H); // translucent tiles would otherwise stack on the previous frame
      for (let px = 0; px < W; px += cell)
        for (let py = 0; py < H; py += cell) {
          const x = X0 + ((px + cell / 2) / W) * (X1 - X0);
          const y = Y1 - ((py + cell / 2) / H) * (Y1 - Y0);
          const p1 = this.forward(x, y)[1][1];
          const conf = Math.abs(p1 - 0.5) * 2;
          ctx.fillStyle = p1 > 0.5 ? `rgba(52,168,83,${0.08 + 0.3 * conf})` : `rgba(66,133,244,${0.08 + 0.3 * conf})`;
          ctx.fillRect(px, py, cell, cell);
        }
      let loss = 0;
      let right = 0;
      for (const [x, y, c] of PTS) {
        const p = this.forward(x, y)[1];
        loss -= Math.log(p[c] + 1e-12);
        const ok = (p[1] > 0.5 ? 1 : 0) === c;
        if (ok) right++;
        const sx = ((x - X0) / (X1 - X0)) * W;
        const sy = ((Y1 - y) / (Y1 - Y0)) * H;
        ctx.beginPath();
        ctx.arc(sx, sy, 3.2, 0, 2 * Math.PI);
        ctx.fillStyle = c ? '#34a853' : '#4285f4';
        ctx.fill();
        if (!ok) {
          ctx.strokeStyle = '#ea4335';
          ctx.lineWidth = 2;
          ctx.stroke();
        }
      }
      this.querySelector('[data-stat]')!.textContent =
        `${this.h} hidden units · update ${this.i * PER} · loss ${(loss / PTS.length).toFixed(3)} · accuracy ${(right / PTS.length).toFixed(2)}`;
    }
  }
  customElements.define('moons-trainer', MoonsTrainer);
</script>
