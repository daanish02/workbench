---
import Figure from '../Figure.astro';

const chain = ['docker (CLI)', 'dockerd', 'containerd', 'runc'];
const layers = ['layer: COPY src/', 'layer: RUN uv sync', 'layer: python:3.14-slim'];
---

<Figure
  kind="Diagram"
  title="A container is a process with a restricted view"
  caption="Left: the docker command asks the daemon, which hands the work to containerd, which calls runc to create the process. Right: what runc sets up. Namespaces decide what the process can see, cgroups how much it can use, and overlayfs stacks the read-only image layers under one writable layer that disappears with the container."
>
  <svg class="cs-svg" viewBox="0 0 440 250" role="img" aria-label="docker, dockerd, containerd and runc in a chain, then a container process with namespaces, cgroups and an overlay filesystem">
    <defs>
      <marker id="cs-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" class="cs-head"></path>
      </marker>
    </defs>
    {chain.map((name, i) => (
      <g>
        <rect class="cs-box" x="10" y={14 + i * 58} width="120" height="34" rx="6"></rect>
        <text class="cs-c" x="70" y={31 + i * 58}>{name}</text>
        {i < chain.length - 1 && <line class="cs-line" x1="70" y1={48 + i * 58} x2="70" y2={70 + i * 58} marker-end="url(#cs-arrow)"></line>}
      </g>
    ))}
    <line class="cs-line" x1="130" y1="205" x2="168" y2="205" marker-end="url(#cs-arrow)"></line>

    <rect class="cs-zone" x="172" y="8" width="260" height="236" rx="8"></rect>
    <text class="cs-t" x="182" y="22">container = one Linux process</text>

    <rect class="cs-ns" x="182" y="34" width="240" height="44" rx="5"></rect>
    <text class="cs-t" x="190" y="48">namespaces: what it sees</text>
    <text class="cs-m" x="190" y="66">pid · mount · net · uts · ipc · user</text>

    <rect class="cs-cg" x="182" y="86" width="240" height="44" rx="5"></rect>
    <text class="cs-t" x="190" y="100">cgroups: what it may use</text>
    <text class="cs-m" x="190" y="118">cpu · memory · io · pids</text>

    <text class="cs-t" x="190" y="146">overlayfs: its filesystem</text>
    <rect class="cs-rw" x="182" y="156" width="240" height="20" rx="4"></rect>
    <text class="cs-m" x="190" y="166">writable layer (per container)</text>
    {layers.map((name, i) => (
      <g>
        <rect class="cs-ro" x="182" y={180 + i * 20} width="240" height="18" rx="4"></rect>
        <text class="cs-m" x="190" y={189 + i * 20}>{name} (read-only)</text>
      </g>
    ))}
  </svg>
</Figure>

<style>
  .cs-svg {
    display: block;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
  }
  .cs-box {
    fill: rgba(66, 133, 244, 0.16);
    stroke: var(--g-blue);
  }
  .cs-zone {
    fill: transparent;
    stroke: var(--border-strong);
  }
  .cs-ns,
  .cs-cg {
    fill: rgba(66, 133, 244, 0.1);
    stroke: var(--border-strong);
  }
  .cs-rw {
    fill: rgba(251, 188, 5, 0.25);
    stroke: var(--g-yellow);
  }
  .cs-ro {
    fill: rgba(52, 168, 83, 0.2);
    stroke: var(--g-green);
  }
  .cs-line {
    stroke: var(--text-faint);
    stroke-width: 1.5;
  }
  .cs-head {
    fill: var(--text-faint);
  }
  .cs-svg text {
    font: 11px var(--font-mono);
    dominant-baseline: central;
  }
  .cs-c {
    fill: var(--text);
    text-anchor: middle;
  }
  .cs-t {
    fill: var(--text);
  }
  .cs-m {
    fill: var(--text-muted);
    font-size: 10px !important;
  }
</style>
