---
import Figure from '../Figure.astro';
---

<Figure
  title="Where the file system lives decides what crosses the wire"
  caption="Three ways to attach storage to servers. With direct-attached storage the drives sit in the server. With a NAS the file system runs on the storage box, and servers ask for files over NFS or SMB, so many servers can share the same files. With a SAN the storage box only serves blocks; each server runs its own file system on a remote volume, as if it were a local disk. The blue box shows where the file system runs; the yellow label shows what travels over the network."
>
  <san-nas-paths>
    <input type="hidden" data-mode value="nas" />
    <span class="choice">
      <button type="button" class="btn" data-choice="das" aria-pressed="false">DAS</button>
      <button type="button" class="btn" data-choice="nas" aria-pressed="true">NAS</button>
      <button type="button" class="btn" data-choice="san" aria-pressed="false">SAN</button>
    </span>
    <svg class="sn-svg" data-svg viewBox="0 0 440 230" role="img" aria-label="Servers, network and storage for DAS, NAS or SAN"></svg>
    <p class="sn-stat mono" data-stat></p>
  </san-nas-paths>
</Figure>

<style>
  .sn-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 10px auto 0;
  }
  .sn-svg :global(rect.base) {
    fill: var(--bg);
  }
  .sn-svg :global(rect.box) {
    fill: transparent;
    stroke: var(--border-strong);
  }
  .sn-svg :global(rect.fs) {
    fill: rgba(66, 133, 244, 0.22);
    stroke: var(--g-blue);
  }
  .sn-svg :global(rect.disk) {
    fill: rgba(52, 168, 83, 0.2);
    stroke: var(--g-green);
  }
  .sn-svg :global(rect.net) {
    fill: rgba(251, 188, 5, 0.12);
    stroke: var(--g-yellow);
  }
  .sn-svg :global(line) {
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .sn-svg :global(text) {
    fill: var(--text);
    font: 11px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .sn-svg :global(text.muted) {
    fill: var(--text-muted);
    font-size: 10px;
  }
  .sn-svg :global(text.wire) {
    fill: var(--g-yellow);
  }
  .sn-stat {
    margin: 8px 0 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  class SanNasPaths extends HTMLElement {
    connectedCallback() {
      this.querySelector('[data-mode]')!.addEventListener('input', () => this.draw());
      this.draw();
    }
    rect(x: number, y: number, w: number, h: number, cls: string, label = '') {
      return `<rect class="base" x="${x}" y="${y}" width="${w}" height="${h}" rx="5" /><rect class="${cls}" x="${x}" y="${y}" width="${w}" height="${h}" rx="5" />${label ? `<text x="${x + w / 2}" y="${y + h / 2}">${label}</text>` : ''}`;
    }
    draw() {
      const mode = this.querySelector<HTMLInputElement>('[data-mode]')!.value;
      let s = '';
      const servers = [40, 170, 300];
      servers.forEach((x, k) => {
        s += this.rect(x, 10, 110, mode === 'das' ? 150 : 76, 'box');
        s += `<text class="muted" x="${x + 55}" y="22">server ${k + 1}</text>`;
        s += this.rect(x + 10, 30, 90, 22, 'box', 'application');
        if (mode !== 'nas') s += this.rect(x + 10, 56, 90, 22, 'fs', 'file system');
        if (mode === 'das') s += this.rect(x + 10, 90, 90, 22, 'box', 'driver') + this.rect(x + 10, 122, 90, 28, 'disk', 'drives');
      });
      if (mode !== 'das') {
        servers.forEach((x) => (s += `<line x1="${x + 55}" y1="86" x2="${x + 55}" y2="112" />`));
        s += this.rect(40, 112, 370, 26, 'net', mode === 'nas' ? 'Ethernet network' : 'storage network (FC, or Ethernet for iSCSI / NVMe-oF)');
        s += `<line x1="225" y1="138" x2="225" y2="158" />`;
        s += this.rect(110, 158, 230, 66, 'box');
        s += `<text class="muted" x="225" y="168">${mode === 'nas' ? 'NAS box' : 'storage array'}</text>`;
        if (mode === 'nas') s += this.rect(122, 178, 100, 38, 'fs', 'file system');
        else s += this.rect(122, 178, 100, 38, 'box', 'volumes');
        s += this.rect(232, 178, 98, 38, 'disk', 'drives');
        s += `<text class="wire" x="44" y="148" style="text-anchor: start">${mode === 'nas' ? 'files: NFS / SMB' : 'blocks: SCSI or NVMe'}</text>`;
      } else {
        s += `<text class="wire" x="225" y="190">nothing shared: each server owns its drives</text>`;
      }
      this.querySelector('[data-svg]')!.innerHTML = s;
      const stat: Record<string, string> = {
        das: 'DAS · file system in each server · no network · fastest, but storage is stranded in each box',
        nas: 'NAS · file system on the storage box · files over the network · many servers share the same files',
        san: 'SAN · file system in each server · blocks over the network · each volume used by one server (or a cluster file system)',
      };
      this.querySelector('[data-stat]')!.textContent = stat[mode];
    }
  }
  customElements.define('san-nas-paths', SanNasPaths);
</script>
