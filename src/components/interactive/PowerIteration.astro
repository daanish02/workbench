---
import Figure from '../Figure.astro';
---

<Figure
  title="Power iteration finds the dominant direction"
  caption="The matrix has eigenvalues λ₁ = 3 along the blue dashed line and λ₂ along the green one. Starting from any vector, repeated multiplication by A (with rescaling) turns it toward the λ₁ direction. Each step shrinks the leftover angle by about |λ₂/λ₁|, so a λ₂ close to 3 makes convergence slow."
>
  <power-iteration>
    <div class="pi-ctl">
      <label class="pi-lbl">λ₂ <input type="range" min="-2.5" max="2.9" step="0.1" value="1" data-l2 /> <b data-l2v>1.0</b></label>
      <label class="pi-lbl">start angle <input type="range" min="0" max="180" step="5" value="100" data-th /> <b data-thv>100°</b></label>
      <label class="pi-lbl">steps <input type="range" min="0" max="15" step="1" value="4" data-k /> <b data-kv>4</b></label>
    </div>
    <svg class="pi-svg" viewBox="-1.3 -1.3 2.6 2.6" role="img" aria-label="Unit circle with successive power-iteration vectors">
      <g transform="scale(1,-1)">
        <circle r="1" class="pi-circle"></circle>
        <line data-e1 class="pi-e1"></line>
        <line data-e2 class="pi-e2"></line>
        <g data-vecs></g>
      </g>
    </svg>
    <p class="pi-stat" data-stat></p>
  </power-iteration>
</Figure>

<style>
  .pi-ctl { display: grid; gap: 10px; margin-bottom: 12px; }
  .pi-lbl { display: flex; align-items: center; gap: 10px; font-size: 0.875rem; color: var(--text-muted); }
  .pi-lbl input { flex: 1; }
  .pi-svg { display: block; width: 100%; max-width: 300px; margin: 0 auto; }
  .pi-circle { fill: none; stroke: #3c4043; stroke-width: 0.01; }
  .pi-e1 { stroke: var(--g-blue); stroke-width: 0.015; stroke-dasharray: 0.05 0.04; }
  .pi-e2 { stroke: var(--g-green); stroke-width: 0.015; stroke-dasharray: 0.05 0.04; }
  .pi-svg :global(.pi-v) { stroke: var(--g-yellow); stroke-width: 0.02; }
  .pi-stat { margin: 10px 0 0; font: 0.875rem/1.6 var(--font-mono); color: var(--text-muted); text-align: center; }
</style>

<script>
  // eigenvectors fixed at 30° and 120°; A = Q diag(3, λ₂) Qᵀ
  const T1 = Math.PI / 6;
  const q1 = [Math.cos(T1), Math.sin(T1)];
  const q2 = [-Math.sin(T1), Math.cos(T1)];

  class PowerIteration extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll('input').forEach((el) => el.addEventListener('input', () => this.draw()));
      const set = (sel: string, q: number[]) => {
        const el = this.querySelector(sel)!;
        el.setAttribute('x1', String(-1.25 * q[0])); el.setAttribute('y1', String(-1.25 * q[1]));
        el.setAttribute('x2', String(1.25 * q[0])); el.setAttribute('y2', String(1.25 * q[1]));
      };
      set('[data-e1]', q1);
      set('[data-e2]', q2);
      this.draw();
    }
    draw() {
      const l2 = +this.querySelector<HTMLInputElement>('[data-l2]')!.value;
      const th = +this.querySelector<HTMLInputElement>('[data-th]')!.value;
      const K = +this.querySelector<HTMLInputElement>('[data-k]')!.value;
      this.querySelector('[data-l2v]')!.textContent = l2.toFixed(1);
      this.querySelector('[data-thv]')!.textContent = `${th}°`;
      this.querySelector('[data-kv]')!.textContent = String(K);
      let v = [Math.cos((th * Math.PI) / 180), Math.sin((th * Math.PI) / 180)];
      let html = '';
      for (let k = 0; k <= K; k++) {
        const op = (0.25 + (0.75 * (k + 1)) / (K + 1)).toFixed(2);
        html += `<line class="pi-v" x1="0" y1="0" x2="${v[0]}" y2="${v[1]}" opacity="${op}"></line>`;
        if (k === K) break;
        const c1 = 3 * (v[0] * q1[0] + v[1] * q1[1]);
        const c2 = l2 * (v[0] * q2[0] + v[1] * q2[1]);
        const w = [c1 * q1[0] + c2 * q2[0], c1 * q1[1] + c2 * q2[1]];
        const n = Math.hypot(w[0], w[1]) || 1;
        v = [w[0] / n, w[1] / n];
      }
      this.querySelector('[data-vecs]')!.innerHTML = html;
      const cos = Math.min(1, Math.abs(v[0] * q1[0] + v[1] * q1[1]));
      const angle = (Math.acos(cos) * 180) / Math.PI;
      this.querySelector('[data-stat]')!.textContent =
        `after ${K} steps: ${angle.toFixed(2)}° from the λ₁ direction · ratio |λ₂/λ₁| = ${Math.abs(l2 / 3).toFixed(2)}`;
    }
  }
  customElements.define('power-iteration', PowerIteration);
</script>
