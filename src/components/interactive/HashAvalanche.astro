---
import Figure from '../Figure.astro';
---

<Figure
  title="The avalanche effect"
  caption="Type anything. The SHA-256 digest is always 256 bits. Change a single character and about half the output bits flip, with no visible pattern: that unpredictability is what makes a hash a trustworthy fingerprint. Bits that differ from the 'original' message are highlighted."
>
  <hash-avalanche>
    <div class="ha-inputs">
      <label class="stat">Message A <input class="input" data-a value="hello world" aria-label="Message A" /></label>
      <label class="stat">Message B <input class="input" data-b value="hello worle" aria-label="Message B" /></label>
    </div>
    <div class="ha-bits mono" data-bits aria-label="Digest bits"></div>
    <p class="ha-stat" data-stat></p>
  </hash-avalanche>
</Figure>

<style>
  .ha-inputs {
    display: grid;
    gap: 8px;
  }
  .ha-inputs .input {
    width: 100%;
    margin-top: 4px;
    box-sizing: border-box;
  }
  .ha-bits {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(32, 1fr);
    gap: 2px;
    max-width: 520px;
  }
  .ha-bits :global(i) {
    aspect-ratio: 1;
    border-radius: 2px;
    background: #2a2a2a;
  }
  .ha-bits :global(i.on) {
    background: #8ab4f8;
  }
  .ha-bits :global(i.diff) {
    background: var(--g-red);
  }
  .ha-stat {
    margin: 12px 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .ha-stat :global(b) {
    color: var(--text);
  }
  .ha-hex {
    font: 0.6875rem var(--font-mono);
  }
</style>

<script>
  function sha256(msg: string): Uint8Array {
    const K = new Uint32Array(64);
    for (let i = 0, p = 2; i < 64; p++) {
      let prime = true;
      for (let d = 2; d * d <= p; d++) if (p % d === 0) prime = false;
      if (prime) K[i++] = (Math.cbrt(p) % 1) * 4294967296;
    }
    const H = new Uint32Array(8);
    for (let i = 0, p = 2; i < 8; p++) {
      let prime = true;
      for (let d = 2; d * d <= p; d++) if (p % d === 0) prime = false;
      if (prime) H[i++] = (Math.sqrt(p) % 1) * 4294967296;
    }
    const bytes = new TextEncoder().encode(msg);
    const len = bytes.length;
    const padded = new Uint8Array(((len + 9 + 63) >> 6) << 6);
    padded.set(bytes);
    padded[len] = 0x80;
    new DataView(padded.buffer).setUint32(padded.length - 4, len * 8);
    const w = new Uint32Array(64);
    const rotr = (x: number, n: number) => (x >>> n) | (x << (32 - n));
    for (let off = 0; off < padded.length; off += 64) {
      const dv = new DataView(padded.buffer, off, 64);
      for (let i = 0; i < 16; i++) w[i] = dv.getUint32(i * 4);
      for (let i = 16; i < 64; i++) {
        const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
        const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
        w[i] = (w[i - 16] + s0 + w[i - 7] + s1) | 0;
      }
      let [a, b, c, d, e, f, g, h] = H;
      for (let i = 0; i < 64; i++) {
        const t1 = (h + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + ((e & f) ^ (~e & g)) + K[i] + w[i]) | 0;
        const t2 = ((rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + ((a & b) ^ (a & c) ^ (b & c))) | 0;
        h = g; g = f; f = e; e = (d + t1) | 0; d = c; c = b; b = a; a = (t1 + t2) | 0;
      }
      H[0] += a; H[1] += b; H[2] += c; H[3] += d; H[4] += e; H[5] += f; H[6] += g; H[7] += h;
    }
    const out = new Uint8Array(32);
    H.forEach((x, i) => new DataView(out.buffer).setUint32(i * 4, x >>> 0));
    return out;
  }
  const bits = (u: Uint8Array) => [...u].flatMap((b) => [...b.toString(2).padStart(8, '0')].map(Number));
  class HashAvalanche extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll('input').forEach((i) => i.addEventListener('input', () => this.draw()));
      this.draw();
    }
    draw() {
      const a = sha256(this.querySelector<HTMLInputElement>('[data-a]')!.value);
      const b = sha256(this.querySelector<HTMLInputElement>('[data-b]')!.value);
      const ba = bits(a);
      const bb = bits(b);
      const diff = ba.filter((x, i) => x !== bb[i]).length;
      this.querySelector('[data-bits]')!.innerHTML = bb.map((x, i) => `<i class="${ba[i] !== x ? 'diff' : x ? 'on' : ''}"></i>`).join('');
      const hex = (u: Uint8Array) => [...u].map((x) => x.toString(16).padStart(2, '0')).join('');
      this.querySelector('[data-stat]')!.innerHTML = `<b>${diff}</b> of 256 bits differ (${Math.round((diff / 256) * 100)}%; random output would differ by about 50%).<br><span class="ha-hex">A: ${hex(a).slice(0, 32)}…<br>B: ${hex(b).slice(0, 32)}…</span>`;
    }
  }
  customElements.define('hash-avalanche', HashAvalanche);
</script>
