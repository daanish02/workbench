---
import Figure from '../Figure.astro';

// f(x) = x² with the tangent at x = 1: y = 2x − 1, slope f'(1) = 2. Drawn with y pointing down, so y is negated.
const f = (x: number) => x * x;
const curve = Array.from({ length: 81 }, (_, i) => {
  const x = -0.5 + (2.5 * i) / 80;
  return `${i ? 'L' : 'M'}${x.toFixed(4)},${(-f(x)).toFixed(4)}`;
}).join(' ');
const tangent = [-0.5, 2].map((x) => `${x.toFixed(4)},${(-(2 * x - 1)).toFixed(4)}`).join(' ');
---

<Figure
  kind="Diagram"
  title="The tangent line and its slope"
  caption="At x = 1 the curve y = x² has the tangent line y = 2x − 1. Its slope 2 is the derivative: for a small step h to the right, the rise over the run is about 2h, so the height changes by twice the step."
>
  <svg class="sttd-svg" viewBox="-0.8 -2.6 3.4 3.2" role="img" aria-label="The parabola y equals x squared with its tangent line at x equals 1, and the point of contact marked">
    <line x1="-0.7" y1="0" x2="2.5" y2="0" class="sttd-axis"></line>
    <line x1="0" y1="-2.5" x2="0" y2="0.5" class="sttd-axis"></line>
    <path d={curve} class="sttd-curve"></path>
    <polyline points={tangent} class="sttd-tangent"></polyline>
    <circle cx="1" cy="-1" r="0.06" class="sttd-dot"></circle>
    <text x="1.12" y="-1.1" class="sttd-label">(1, 1)</text>
    <text x="1.55" y="-2.2" class="sttd-label">slope 2</text>
  </svg>
</Figure>

<style>
  .sttd-svg {
    display: block;
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
  }
  .sttd-axis {
    stroke: #3c4043;
    stroke-width: 0.02;
  }
  .sttd-curve {
    fill: none;
    stroke: var(--g-blue);
    stroke-width: 0.04;
  }
  .sttd-tangent {
    fill: none;
    stroke: var(--g-yellow);
    stroke-width: 0.04;
  }
  .sttd-dot {
    fill: var(--g-red);
  }
  .sttd-label {
    fill: var(--text-muted);
    font: 0.12px var(--font-mono);
  }
</style>
