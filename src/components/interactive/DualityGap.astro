---
import Figure from '../Figure.astro';
---

<Figure
  title="Primal and dual values"
  caption="Primal: minimise x₁ + 2x₂ with x₁ + x₂ ≥ 3 and x ≥ 0. Dual: maximise 3y with y ≤ 1 and y ≥ 0. Any feasible dual value is at most any feasible primal value. Set the primal to (3, 0) and the dual to 1: the bars meet and the gap is zero."
>
  <duality-gap>
    <div class="dg-ctl">
      <label>x₁ <input type="range" min="0" max="6" step="0.1" value="4" data-x1 /><b data-x1v>4.0</b></label>
      <label>x₂ <input type="range" min="0" max="6" step="0.1" value="0" data-x2 /><b data-x2v>0.0</b></label>
      <label>y <input type="range" min="0" max="2" step="0.05" value="0.5" data-y /><b data-yv>0.50</b></label>
    </div>
    <svg class="dg-svg" viewBox="0 0 400 200" role="img" aria-label="Bars for the primal value and the dual value">
      <line x1="60" y1="170" x2="390" y2="170" class="dg-axis"></line>
      <rect data-pbar x="90" y="170" width="80" height="0" class="dg-p"></rect>
      <rect data-dbar x="230" y="170" width="80" height="0" class="dg-d"></rect>
      <text x="130" y="186" class="dg-t">x₁ + 2x₂</text>
      <text x="270" y="186" class="dg-t">3y</text>
      <line data-ref x1="60" y1="170" x2="390" y2="170" class="dg-ref"></line>
    </svg>
    <p class="dg-stat" data-stat></p>
  </duality-gap>
</Figure>

<style>
  .dg-ctl {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-bottom: 10px;
  }
  .dg-ctl label {
    flex: 1 1 160px;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font: 0.8125rem var(--font-mono);
    color: var(--text-muted);
  }
  .dg-ctl input {
    flex: 1;
    width: 100%;
    min-width: 0;
  }
  .dg-ctl b {
    min-width: 2.6em;
    text-align: right;
    color: var(--text);
  }
  .dg-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .dg-axis {
    stroke: #3c4043;
    stroke-width: 1;
  }
  .dg-p {
    fill: var(--g-blue);
    opacity: 0.8;
  }
  .dg-d {
    fill: var(--g-yellow);
    opacity: 0.8;
  }
  .dg-ref {
    stroke: none;
  }
  .dg-t {
    fill: var(--text-muted);
    font: 11px var(--font-mono);
    text-anchor: middle;
  }
  .dg-stat {
    margin: 10px 0 0;
    font: 0.8125rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  class DualityGap extends HTMLElement {
    connectedCallback() {
      for (const sel of ['[data-x1]', '[data-x2]', '[data-y]']) {
        this.querySelector(sel)!.addEventListener('input', () => this.draw());
      }
      this.draw();
    }

    draw() {
      const x1 = +this.querySelector<HTMLInputElement>('[data-x1]')!.value;
      const x2 = +this.querySelector<HTMLInputElement>('[data-x2]')!.value;
      const y = +this.querySelector<HTMLInputElement>('[data-y]')!.value;
      this.querySelector('[data-x1v]')!.textContent = x1.toFixed(1);
      this.querySelector('[data-x2v]')!.textContent = x2.toFixed(1);
      this.querySelector('[data-yv]')!.textContent = y.toFixed(2);

      const primalFeasible = x1 >= 0 && x2 >= 0 && x1 + x2 >= 3 - 1e-9;
      const dualFeasible = y >= 0 && y <= 1 + 1e-9;
      const pv = x1 + 2 * x2;
      const dv = 3 * y;
      const scale = 120 / 12; // pixels per unit, bars up to value 12
      const ph = Math.min(pv, 12) * scale;
      const dh = Math.min(dv, 12) * scale;
      const pbar = this.querySelector<SVGRectElement>('[data-pbar]')!;
      pbar.setAttribute('y', String(170 - ph));
      pbar.setAttribute('height', String(ph));
      const dbar = this.querySelector<SVGRectElement>('[data-dbar]')!;
      dbar.setAttribute('y', String(170 - dh));
      dbar.setAttribute('height', String(dh));
      const gap = pv - dv;
      const msgP = primalFeasible ? `primal ${pv.toFixed(2)}` : `primal ${pv.toFixed(2)} (infeasible)`;
      const msgD = dualFeasible ? `dual ${dv.toFixed(2)}` : `dual ${dv.toFixed(2)} (infeasible)`;
      const verdict =
        primalFeasible && dualFeasible
          ? gap >= -1e-9
            ? `gap ${gap.toFixed(2)}${Math.abs(gap) < 1e-9 ? ': optimal pair' : ''}`
            : 'weak duality violated'
          : 'the bound applies only to feasible pairs';
      this.querySelector('[data-stat]')!.textContent = `${msgP} · ${msgD} · ${verdict}`;
    }
  }
  customElements.define('duality-gap', DualityGap);
</script>
