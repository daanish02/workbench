---
import Figure from '../Figure.astro';

// Partial sums of the square wave (4/π) Σ sin(kt)/k over odd k, for t in (0, π).
const partial = (t: number, N: number) => {
  let s = 0;
  for (let i = 0; i < N; i++) {
    const k = 2 * i + 1;
    s += Math.sin(k * t) / k;
  }
  return (4 / Math.PI) * s;
};
const X = (t: number) => 40 + (t / Math.PI) * 330;
const Y = (v: number) => 170 - v * 120;
const path = (N: number) => {
  const pts: string[] = [];
  for (let i = 1; i <= 300; i++) {
    const t = (Math.PI * i) / 301;
    pts.push(`${i === 1 ? 'M' : 'L'}${X(t).toFixed(2)},${Y(partial(t, N)).toFixed(2)}`);
  }
  return pts.join(' ');
};
// location and height of the overshoot with 15 harmonics
let peakT = 0, peakV = -Infinity;
for (let i = 1; i <= 300; i++) {
  const t = (Math.PI * i) / 301;
  const v = partial(t, 15);
  if (v > peakV) { peakV = v; peakT = t; }
}
---

<Figure
  kind="Diagram"
  title="Partial sums and the Gibbs overshoot"
  caption="The square wave equals +1 on (0, π). Partial sums with 1, 3 and 15 odd harmonics approach 1, but the largest value with 15 harmonics is about 1.18. More terms move the overshoot closer to the jump without shrinking it."
>
  <div class="axes" style="--ax-w: 440px">
    <span class="ax-y">value</span>
    <svg class="gb-svg" viewBox="0 0 400 200" role="img" aria-label="Partial sums of a square wave over half a period, overshooting near the jump">
      <line x1="40" y1={Y(1)} x2="370" y2={Y(1)} class="gb-target"></line>
      <line x1="40" y1={Y(0)} x2="370" y2={Y(0)} class="gb-axis"></line>
      <text x="30" y={Y(1) + 4} class="gb-t gb-end">1</text>
      <text x="30" y={Y(0) + 4} class="gb-t gb-end">0</text>
      <path d={path(1)} class="gb-n1"></path>
      <path d={path(3)} class="gb-n3"></path>
      <path d={path(15)} class="gb-n15"></path>
      <circle cx={X(peakT)} cy={Y(peakV)} r="3.5" class="gb-peak"></circle>
      <text x={X(peakT) + 8} y={Y(peakV) - 6} class="gb-t">peak {peakV.toFixed(2)}</text>
      <text x="40" y="190" class="gb-t">t = 0</text>
      <text x="370" y="190" class="gb-t gb-end">t = π</text>
    </svg>
    <span class="ax-x">t</span>
  </div>
  <div class="gb-legend">
    <span><i class="sw sw-n1"></i>N = 1</span>
    <span><i class="sw sw-n3"></i>N = 3</span>
    <span><i class="sw sw-n15"></i>N = 15</span>
  </div>
</Figure>

