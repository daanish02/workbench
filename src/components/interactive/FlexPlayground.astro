---
import Figure from '../Figure.astro';
const rows = [
  { key: 'dir', label: 'flex-direction', opts: ['row', 'column'] },
  { key: 'justify', label: 'justify-content', opts: ['flex-start', 'center', 'space-between', 'space-evenly'] },
  { key: 'align', label: 'align-items', opts: ['stretch', 'flex-start', 'center', 'flex-end'] },
  { key: 'grow', label: 'item 2 flex-grow', opts: ['0', '1'] },
];
---

<Figure
  title="Flexbox: one container, four properties"
  caption="A flex container lays its items out along a main axis (blue arrow) set by flex-direction. justify-content distributes the free space along that axis; align-items positions items on the cross axis. Giving item 2 flex-grow: 1 makes it absorb all the free space, so justify-content has nothing left to distribute. The readout is the CSS for the current state."
>
  <flex-playground>
    {rows.map((r) => (
      <div class="choice-row fp-row">
        <span class="ctl-label">{r.label}</span>
        <input type="hidden" data-prop={r.key} value={r.opts[0]} />
        <span class="choice">
          {r.opts.map((o, i) => <button type="button" class="btn" data-choice={o} aria-pressed={i === 0 ? 'true' : 'false'}>{o}</button>)}
        </span>
      </div>
    ))}
    <div class="fp-stage">
      <div class="fp-axis" data-axis></div>
      <div class="fp-box" data-box>
        <div class="fp-item a">1</div>
        <div class="fp-item b" data-grow>2</div>
        <div class="fp-item c">3</div>
      </div>
    </div>
    <p class="fp-stat mono" data-stat></p>
  </flex-playground>
</Figure>

<style>
  .fp-row {
    margin: 4px 0;
  }
  .fp-stage {
    position: relative;
    margin: 12px auto 0;
    max-width: 440px;
  }
  .fp-box {
    display: flex;
    gap: 8px;
    height: 190px;
    padding: 8px;
    border: 1px dashed var(--border-strong);
    border-radius: 8px;
    background: var(--bg);
  }
  .fp-item {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 32px;
    border-radius: 6px;
    font: 600 0.875rem var(--font-mono);
    color: var(--text);
  }
  .fp-item.a {
    background: rgba(66, 133, 244, 0.3);
    border: 1px solid var(--g-blue);
    padding: 6px 10px;
  }
  .fp-item.b {
    background: rgba(251, 188, 5, 0.3);
    border: 1px solid var(--g-yellow);
    padding: 14px 16px;
  }
  .fp-item.c {
    background: rgba(52, 168, 83, 0.3);
    border: 1px solid var(--g-green);
    padding: 4px 22px;
  }
  .fp-axis {
    position: absolute;
    pointer-events: none;
    background: var(--g-blue);
    opacity: 0.7;
  }
  .fp-axis.row {
    left: 8px;
    right: 8px;
    bottom: -9px;
    height: 2px;
  }
  .fp-axis.column {
    top: 8px;
    bottom: 8px;
    right: -9px;
    width: 2px;
  }
  .fp-stat {
    font-size: 0.8125rem;
    color: var(--text);
    margin: 18px 0 8px;
    white-space: pre-wrap;
  }
</style>

<script>
  class FlexPlayground extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll('[data-prop]').forEach((el) => el.addEventListener('change', () => this.draw()));
      this.draw();
    }
    val(key: string) {
      return this.querySelector<HTMLInputElement>(`[data-prop="${key}"]`)!.value;
    }
    draw() {
      const box = this.querySelector<HTMLElement>('[data-box]')!;
      const dir = this.val('dir'), justify = this.val('justify'), align = this.val('align'), grow = this.val('grow');
      box.style.flexDirection = dir;
      box.style.justifyContent = justify;
      box.style.alignItems = align;
      this.querySelector<HTMLElement>('[data-grow]')!.style.flexGrow = grow;
      this.querySelector<HTMLElement>('[data-axis]')!.className = `fp-axis ${dir}`;
      this.querySelector('[data-stat]')!.textContent =
        `.box { display: flex; flex-direction: ${dir}; justify-content: ${justify}; align-items: ${align}; }\n.item-2 { flex-grow: ${grow}; }`;
    }
  }
  customElements.define('flex-playground', FlexPlayground);
</script>
