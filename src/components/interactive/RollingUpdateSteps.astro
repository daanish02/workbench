---
import Figure from '../Figure.astro';
---

<Figure
  title="A rolling update never drops below three ready Pods"
  caption="A Deployment with replicas: 3, maxSurge: 1 and maxUnavailable: 0 moves from version 1.4.2 (blue) to 1.4.3 (green). Each round starts one new Pod (yellow while it is not ready), waits for its readiness probe, then removes one old Pod (red). With a broken image the new Pod never becomes ready, so the rollout stalls and the old Pods keep serving."
>
  <rolling-update-steps>
    <input type="hidden" data-mode value="ok" />
    <span class="choice">
      <button type="button" class="btn" data-choice="ok" aria-pressed="true">Healthy 1.4.3</button>
      <button type="button" class="btn" data-choice="broken" aria-pressed="false">Broken 1.4.3</button>
    </span>
    <svg class="ru-svg" data-svg viewBox="0 0 440 92" role="img" aria-label="Pods of the Deployment and their state"></svg>
    <p class="ru-msg" data-msg></p>
    <p class="ru-stat mono" data-stat></p>
    <div class="ctl-row">
      <button type="button" class="btn primary" data-step-btn>Step</button>
      <button type="button" class="btn" data-auto-step aria-pressed="false">Auto</button>
      <button type="button" class="btn" data-reset>Reset</button>
    </div>
  </rolling-update-steps>
</Figure>

<style>
  .ru-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 10px auto 0;
  }
  .ru-svg :global(rect.bg) {
    fill: var(--bg);
  }
  .ru-svg :global(rect.old) {
    fill: rgba(66, 133, 244, 0.3);
    stroke: var(--g-blue);
  }
  .ru-svg :global(rect.new) {
    fill: rgba(52, 168, 83, 0.3);
    stroke: var(--g-green);
  }
  .ru-svg :global(rect.starting) {
    fill: rgba(251, 188, 5, 0.25);
    stroke: var(--g-yellow);
    stroke-dasharray: 4 3;
  }
  .ru-svg :global(rect.stopping) {
    fill: rgba(234, 67, 53, 0.25);
    stroke: var(--g-red);
    stroke-dasharray: 4 3;
  }
  .ru-svg :global(text) {
    fill: var(--text);
    font: 11px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .ru-svg :global(text.s) {
    fill: var(--text-muted);
    font-size: 10px;
  }
  .ru-msg {
    min-height: 3em;
    margin: 8px 0 4px;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .ru-stat {
    font-size: 0.8125rem;
    color: var(--text);
    margin: 0 0 8px;
  }
</style>

<script>
  // state: ready | starting | stopping | failing
  interface Pod { v: 'old' | 'new'; state: string }
  interface Frame { pods: Pod[]; msg: string }

  function frames(mode: string): Frame[] {
    let pods: Pod[] = [0, 1, 2].map(() => ({ v: 'old', state: 'ready' }));
    const out: Frame[] = [];
    const push = (msg: string) => out.push({ pods: pods.map((p) => ({ ...p })), msg });
    push('Three Pods of version 1.4.2 serve traffic. kubectl set image changes the template to 1.4.3, so the Deployment creates a new ReplicaSet.');
    for (let round = 1; round <= 3; round++) {
      pods.push({ v: 'new', state: 'starting' });
      push(`Round ${round}: maxSurge 1 allows one extra Pod, so the new ReplicaSet starts a 1.4.3 Pod. It gets no traffic until its readiness probe passes.`);
      if (mode === 'broken') {
        pods[pods.length - 1].state = 'failing';
        push('The new Pod crashes or fails its readiness probe. maxUnavailable 0 forbids removing an old Pod first, so nothing else changes.');
        push('The rollout is stuck: kubectl rollout status waits, and after progressDeadlineSeconds (600 s by default) the Deployment reports it as failed. The three old Pods still serve every request. Fix: kubectl rollout undo.');
        return out;
      }
      pods[pods.length - 1].state = 'ready';
      push(`The new Pod passes its readiness probe and joins the Service: ${pods.filter((p) => p.state === 'ready').length} Pods are ready.`);
      const i = pods.findIndex((p) => p.v === 'old' && p.state === 'ready');
      pods[i].state = 'stopping';
      push('One old Pod is removed from the Service and sent SIGTERM; it finishes its open requests within the grace period.');
      pods = pods.filter((p) => p.state !== 'stopping');
    }
    push('All three Pods run 1.4.3. The old ReplicaSet is kept at 0 replicas so kubectl rollout undo can scale it back up.');
    return out;
  }

  const LABEL: Record<string, string> = { ready: 'ready', starting: 'not ready', stopping: 'terminating', failing: 'CrashLoop' };

  class RollingUpdateSteps extends HTMLElement {
    fr: Frame[] = [];
    i = 0;
    connectedCallback() {
      const mode = this.querySelector<HTMLInputElement>('[data-mode]')!;
      const reset = () => {
        this.fr = frames(mode.value);
        this.i = 0;
        this.draw();
      };
      mode.addEventListener('change', reset);
      this.querySelector('[data-step-btn]')!.addEventListener('click', () => {
        if (this.i < this.fr.length - 1) this.i++;
        this.draw();
      });
      this.querySelector('[data-reset]')!.addEventListener('click', reset);
      reset();
    }
    draw() {
      const f = this.fr[this.i];
      let s = '';
      f.pods.forEach((p, n) => {
        const x = 10 + n * 106;
        const cls = p.state === 'ready' ? p.v : p.state === 'failing' ? 'stopping' : p.state;
        s += `<rect class="bg" x="${x}" y="14" width="96" height="64" rx="7" />`;
        s += `<rect class="${cls}" x="${x}" y="14" width="96" height="64" rx="7" />`;
        s += `<text x="${x + 48}" y="36">${p.v === 'old' ? '1.4.2' : '1.4.3'}</text>`;
        s += `<text class="s" x="${x + 48}" y="58">${LABEL[p.state]}</text>`;
      });
      this.querySelector('[data-svg]')!.innerHTML = s;
      this.querySelector('[data-msg]')!.textContent = f.msg;
      const ready = f.pods.filter((p) => p.state === 'ready');
      const count = (v: string) => ready.filter((p) => p.v === v).length;
      this.querySelector('[data-stat]')!.textContent =
        `step ${this.i}/${this.fr.length - 1} · pods ${f.pods.length} (max 4) · ready ${ready.length} (min 3) · 1.4.2 ${count('old')} · 1.4.3 ${count('new')}`;
      this.querySelector<HTMLButtonElement>('[data-step-btn]')!.disabled = this.i === this.fr.length - 1;
    }
  }
  customElements.define('rolling-update-steps', RollingUpdateSteps);
</script>
