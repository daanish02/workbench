---
import Figure from '../Figure.astro';
---

<Figure
  title="Each subnet's route table decides where a packet goes"
  caption="The three route tables of the VPC above (zone a). Pick the subnet a packet leaves from and where it is going. The table's rows that contain the destination match (yellow); the most specific one, the longest prefix, wins (green). Public subnets send the rest of the internet to the internet gateway, private app subnets to the NAT gateway, and data subnets have no route out at all."
>
  <vpc-route-tables>
    <div class="ctl-row">
      <input type="hidden" data-src value="app" />
      <span class="choice">
        <button type="button" class="btn" data-choice="public" aria-pressed="false">from public-a</button>
        <button type="button" class="btn" data-choice="app" aria-pressed="true">from app-a</button>
        <button type="button" class="btn" data-choice="data" aria-pressed="false">from data-a</button>
      </span>
    </div>
    <div class="ctl-row">
      <input type="hidden" data-dst value="db" />
      <span class="choice">
        <button type="button" class="btn" data-choice="db" aria-pressed="true">to 10.20.70.5 (RDS)</button>
        <button type="button" class="btn" data-choice="api" aria-pressed="false">to 198.51.100.7 (payments API)</button>
        <button type="button" class="btn" data-choice="s3" aria-pressed="false">to S3</button>
      </span>
    </div>
    <div class="rt-wrap" data-tables></div>
    <p class="rt-stat mono" data-stat></p>
  </vpc-route-tables>
</Figure>

<style>
  .rt-wrap {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 10px;
    margin-top: 10px;
  }
  .rt-wrap :global(.rt) {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px;
    font: 0.75rem var(--font-mono);
  }
  .rt-wrap :global(.rt.on) {
    border-color: var(--g-blue);
    background: rgba(66, 133, 244, 0.08);
  }
  .rt-wrap :global(.rt h4) {
    margin: 0 0 6px;
    font-size: 0.8125rem;
  }
  .rt-wrap :global(table) {
    width: 100%;
    border-collapse: collapse;
  }
  .rt-wrap :global(th),
  .rt-wrap :global(td) {
    text-align: left;
    padding: 3px 4px;
    border-bottom: 1px solid var(--border);
  }
  .rt-wrap :global(th) {
    color: var(--text-muted);
    font-weight: 500;
  }
  .rt-wrap :global(tr.match td) {
    background: rgba(251, 188, 5, 0.18);
  }
  .rt-wrap :global(tr.win td) {
    background: rgba(52, 168, 83, 0.28);
  }
  .rt-stat {
    font-size: 0.8125rem;
    color: var(--text);
    margin: 10px 0 8px;
  }
  .rt-stat :global(.bad) {
    color: var(--g-red);
  }
</style>

<script>
  // a route: destination, prefix length (for the longest-match rule), target
  interface Route { dest: string; len: number; target: string; covers: string[] }
  const LOCAL: Route = { dest: '10.20.0.0/16', len: 16, target: 'local', covers: ['db'] };
  const TABLES: Record<string, { name: string; routes: Route[] }> = {
    public: { name: 'rt-public (public-a, public-b)', routes: [LOCAL, { dest: '0.0.0.0/0', len: 0, target: 'igw-0a1b', covers: ['db', 'api', 's3'] }] },
    app: {
      name: 'rt-app-a (app-a)',
      routes: [
        LOCAL,
        { dest: 'pl-s3 (S3 ranges)', len: 24, target: 'vpce-s3', covers: ['s3'] },
        { dest: '0.0.0.0/0', len: 0, target: 'nat-a', covers: ['db', 'api', 's3'] },
      ],
    },
    data: { name: 'rt-data (data-a, data-b)', routes: [LOCAL] },
  };
  const DST: Record<string, string> = { db: '10.20.70.5', api: '198.51.100.7', s3: 'an S3 address' };
  const MEANING: Record<string, string> = {
    local: 'delivered inside the VPC, no gateway involved',
    'igw-0a1b': 'out through the internet gateway (the source needs a public IP)',
    'nat-a': 'out through the NAT gateway, which swaps in its Elastic IP',
    'vpce-s3': 'through the S3 gateway endpoint, never touching the internet or the NAT bill',
  };

  class VpcRouteTables extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll('input[type=hidden]').forEach((el) => el.addEventListener('change', () => this.draw()));
      this.draw();
    }
    draw() {
      const src = this.querySelector<HTMLInputElement>('[data-src]')!.value;
      const dst = this.querySelector<HTMLInputElement>('[data-dst]')!.value;
      const matches = TABLES[src].routes.filter((r) => r.covers.includes(dst));
      const win = matches.sort((a, b) => b.len - a.len)[0];
      this.querySelector('[data-tables]')!.innerHTML = Object.entries(TABLES).map(([id, t]) => {
        const rows = t.routes.map((r) => {
          const cls = id === src ? (r === win ? 'win' : r.covers.includes(dst) ? 'match' : '') : '';
          return `<tr class="${cls}"><td>${r.dest}</td><td>${r.target}</td></tr>`;
        }).join('');
        return `<div class="rt${id === src ? ' on' : ''}"><h4>${t.name}</h4><table><tr><th>destination</th><th>target</th></tr>${rows}</table></div>`;
      }).join('');
      this.querySelector('[data-stat]')!.innerHTML = win
        ? `${DST[dst]} matches ${matches.length} route${matches.length > 1 ? 's' : ''} · longest prefix ${win.dest} · target ${win.target}: ${MEANING[win.target]}`
        : `<span class="bad">${DST[dst]}: no matching route, packet dropped</span> · data subnets cannot reach the internet or S3 at all`;
    }
  }
  customElements.define('vpc-route-tables', VpcRouteTables);
</script>
