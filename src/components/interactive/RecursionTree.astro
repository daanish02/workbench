---
import Figure from '../Figure.astro';

// Recursion tree for T(n) = 2T(n/2) + n: each level does total work n, and there are log₂ n levels.
const levels = [
  { label: 'n', nodes: 1, size: 'n', work: 'n' },
  { label: 'n/2', nodes: 2, size: 'n/2', work: 'n' },
  { label: 'n/4', nodes: 4, size: 'n/4', work: 'n' },
];
---

<Figure
  kind="Diagram"
  title="Recursion tree for merge sort"
  caption="T(n) = 2T(n/2) + n. Each level splits the problem in two and does work n in total, because the halves add up to the same size. With log₂ n levels the total is n log₂ n."
>
  <svg class="rt-svg" viewBox="0 0 400 230" role="img" aria-label="Recursion tree: each level has two or more nodes whose sizes add to n, with work n per level">
    {levels.map((L, li) => {
      const y = 30 + li * 65;
      return (
        <g>
          {Array.from({ length: L.nodes }, (_, k) => {
            const x = (400 / (L.nodes + 1)) * (k + 1) - 0;
            return (
              <g>
                <rect x={x - 36} y={y - 16} width="72" height="32" rx="6" class="rt-node"></rect>
                <text x={x} y={y} class="rt-t">{L.size}</text>
              </g>
            );
          })}
        </g>
      );
    })}
    <text x="20" y="218" class="rt-note">… continuing down to size 1: log₂ n levels in total</text>
  </svg>
</Figure>

<style>
  .rt-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .rt-node {
    fill: #1a1a1a;
    stroke: var(--g-blue);
    stroke-width: 1.5;
  }
  .rt-t {
    fill: var(--text);
    font: 600 12px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .rt-w {
    fill: var(--g-yellow);
    font: 11px var(--font-mono);
  }
  .rt-note {
    fill: var(--text-muted);
    font: 11px var(--font-mono);
  }
</style>
