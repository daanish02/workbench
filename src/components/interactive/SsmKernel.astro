---
import Figure from '../Figure.astro';
---

<Figure
  title="A linear recurrence is a long convolution"
  caption="A state space layer with diagonal decays a_n. Unrolled, its output is the input convolved with the kernel K_k = Σ c_n a_nᵏ b_n (blue): how much an input k steps ago still contributes. Fast-decaying states only remember the last few steps; decays close to 1 give a kernel that reaches hundreds of steps back. S4-style models mix many timescales in one layer. Drag the slowest decay to stretch the kernel."
>
  <ssm-kernel>
    <div class="sk-ctl">
      <input type="hidden" data-set value="mixed" />
      <span class="choice">
        <button type="button" class="btn" data-choice="fast" aria-pressed="false">fast states</button>
        <button type="button" class="btn" data-choice="mixed" aria-pressed="true">mixed timescales</button>
        <button type="button" class="btn" data-choice="slow" aria-pressed="false">slow states</button>
      </span>
    </div>
    <label class="sk-lbl">slowest decay <input type="range" min="0.9" max="0.999" step="0.001" value="0.99" data-a /> <b data-av>0.990</b></label>
    <div class="axes" style="--ax-w: 440px">
      <span class="ax-y">kernel K_k</span>
      <svg class="sk-svg" viewBox="0 0 400 190" data-grid='{"box":[30,10,390,170],"x":[0,200],"y":[0,1]}' role="img" aria-label="Convolution kernel of a state space layer against lag">
        <path data-k class="sk-k"></path>
        <line x1="30" x2="390" data-half class="sk-half"></line>
        <text x="30" y="186" class="ax-tick">0</text>
        <text x="390" y="186" class="ax-tick sk-end">200</text>
        <text x="24" y="14" class="ax-tick sk-end">1</text>
      </svg>
      <span class="ax-x">lag k (steps back)</span>
    </div>
    <p class="sk-stat" data-stat></p>
  </ssm-kernel>
</Figure>

<style>
  .sk-ctl {
    margin-bottom: 10px;
  }
  .sk-lbl {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .sk-lbl input[type='range'] {
    flex: 1;
  }
  .sk-svg {
    display: block;
    width: 100%;
    max-width: 440px;
  }
  .sk-k {
    fill: rgba(66, 133, 244, 0.18);
    stroke: var(--g-blue);
    stroke-width: 2;
  }
  .sk-half {
    stroke: var(--g-yellow);
    stroke-dasharray: 4 4;
  }
  .sk-end {
    text-anchor: end;
  }
  .sk-stat {
    margin: 10px 0 0;
    font: 0.875rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  const SETS: Record<string, (slow: number) => number[]> = {
    fast: () => [0.5, 0.7, 0.8, 0.85],
    mixed: (slow) => [0.5, 0.8, 0.95, slow],
    slow: (slow) => [slow - 0.02, slow - 0.01, slow - 0.005, slow].map((v) => Math.max(0.5, v)),
  };
  const L = 200;
  const px = (k: number) => 30 + (k / L) * 360;
  const py = (v: number) => 170 - v * 160;

  class SsmKernel extends HTMLElement {
    connectedCallback() {
      this.querySelector('[data-set]')!.addEventListener('input', () => this.draw());
      this.querySelector('[data-a]')!.addEventListener('input', () => this.draw());
      const h = this.querySelector('[data-half]')!;
      h.setAttribute('y1', py(0.1).toFixed(1));
      h.setAttribute('y2', py(0.1).toFixed(1));
      this.draw();
    }
    draw() {
      const slow = +this.querySelector<HTMLInputElement>('[data-a]')!.value;
      this.querySelector('[data-av]')!.textContent = slow.toFixed(3);
      const a = SETS[this.querySelector<HTMLInputElement>('[data-set]')!.value](slow);
      // equal weights b_n c_n = 1/N so K_0 = 1
      const K = Array.from({ length: L + 1 }, (_, k) => a.reduce((s, an) => s + an ** k, 0) / a.length);
      const d = K.map((v, k) => `${k ? 'L' : 'M'}${px(k).toFixed(1)},${py(v).toFixed(1)}`).join('') + `L${px(L)},170L30,170Z`;
      this.querySelector('[data-k]')!.setAttribute('d', d);
      let reach = K.findIndex((v) => v < 0.1);
      this.querySelector('[data-stat]')!.textContent =
        `decays ${a.map((v) => v.toFixed(3)).join(', ')} · kernel falls below 0.1 (yellow) after ${reach < 0 ? '> 200' : reach} steps`;
    }
  }
  customElements.define('ssm-kernel', SsmKernel);
</script>
