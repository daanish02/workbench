---
import Figure from '../Figure.astro';
---

<Figure
  title="Likelihood and the MLE"
  caption="The curve is the likelihood of the heads probability θ after k heads in n flips, scaled so its peak is 1. The solid line marks the MLE k/n. Turn on the Beta(2, 2) prior to see the posterior peak, the MAP estimate, move toward one half."
>
  <likelihood-mle>
    <div class="lm-ctl">
      <label>n <input type="range" min="1" max="50" step="1" value="10" data-n /><b data-nv>10</b></label>
      <label>k <input type="range" min="0" max="50" step="1" value="7" data-k /><b data-kv>7</b></label>
      <span class="lm-prior"><input type="checkbox" hidden data-prior /><button type="button" class="btn" data-toggle aria-pressed="false">Beta(2, 2) prior</button></span>
    </div>
    <div class="axes" style="--ax-w: 440px">
      <span class="ax-y">likelihood (scaled)</span>
      <svg class="lm-svg" viewBox="0 0 400 200" data-grid='{"box":[30,10,390,170],"x":[0,1],"y":[0,1]}' role="img" aria-label="Likelihood curve over θ from 0 to 1 with a vertical line at the maximum">
        <line x1="30" y1="170" x2="390" y2="170" class="lm-axis"></line>
        <line x1="30" y1="10" x2="30" y2="170" class="lm-axis"></line>
        <path data-curve class="lm-curve"></path>
        <line data-mle x1="0" y1="10" x2="0" y2="170" class="lm-mle"></line>
        <line data-map x1="0" y1="10" x2="0" y2="170" class="lm-map"></line>
        <text x="30" y="186" class="lm-t">0</text>
        <text x="390" y="186" class="lm-t lm-end">1</text>
        <text x="210" y="186" class="lm-t">θ</text>
      </svg>
      <span class="ax-x">heads probability θ</span>
    </div>
    <p class="lm-stat" data-stat></p>
  </likelihood-mle>
</Figure>

<style>
  .lm-ctl {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-bottom: 10px;
  }
  .lm-ctl label {
    flex: 1 1 160px;
    display: flex;
    align-items: center;
    gap: 8px;
    font: 0.8125rem var(--font-mono);
    color: var(--text-muted);
  }
  .lm-ctl input[type='range'] {
    flex: 1;
    min-width: 0;
  }
  .lm-ctl b {
    min-width: 2em;
    text-align: right;
    color: var(--text);
  }
  .lm-prior {
    flex: 0 0 auto !important;
  }
  .lm-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .lm-axis {
    stroke: #3c4043;
    stroke-width: 1;
  }
  .lm-curve {
    fill: rgba(66, 133, 244, 0.2);
    stroke: var(--g-blue);
    stroke-width: 2;
  }
  .lm-mle {
    stroke: var(--g-yellow);
    stroke-width: 1.5;
  }
  .lm-map {
    stroke: var(--g-red);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .lm-t {
    fill: var(--text-muted);
    font: 11px var(--font-mono);
    text-anchor: start;
  }
  .lm-end {
    text-anchor: end;
  }
  .lm-stat {
    margin: 10px 0 0;
    font: 0.8125rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  class LikelihoodMLE extends HTMLElement {
    connectedCallback() {
      this.querySelector('[data-n]')!.addEventListener('input', () => this.draw());
      this.querySelector('[data-k]')!.addEventListener('input', () => this.draw());
      this.querySelector('[data-prior]')!.addEventListener('change', () => this.draw());
      this.draw();
    }

    draw() {
      const nEl = this.querySelector<HTMLInputElement>('[data-n]')!;
      const kEl = this.querySelector<HTMLInputElement>('[data-k]')!;
      const n = +nEl.value;
      kEl.max = String(n);
      if (+kEl.value > n) kEl.value = String(n);
      const k = +kEl.value;
      const prior = this.querySelector<HTMLInputElement>('[data-prior]')!.checked;
      this.querySelector('[data-nv]')!.textContent = String(n);
      this.querySelector('[data-kv]')!.textContent = String(k);

      // work in logs so long samples do not underflow
      const a = prior ? k + 1 : k;
      const b = prior ? n - k + 1 : n - k;
      const grid: number[] = [];
      for (let i = 1; i < 200; i++) grid.push(i / 200);
      const logs = grid.map((t) => a * Math.log(t) + b * Math.log(1 - t));
      const top = Math.max(...logs);
      const X0 = 30, W = 360, Y0 = 170, H = 160;
      const pts = grid.map((t, i) => {
        const y = Y0 - H * Math.exp(logs[i] - top);
        return `${i ? 'L' : 'M'}${(X0 + t * W).toFixed(2)},${y.toFixed(2)}`;
      });
      this.querySelector('[data-curve]')!.setAttribute('d', `${pts.join(' ')} L${X0 + W},${Y0} L${X0},${Y0} Z`);

      const mle = k / n;
      this.querySelector<SVGLineElement>('[data-mle]')!.setAttribute('x1', String(X0 + mle * W));
      this.querySelector<SVGLineElement>('[data-mle]')!.setAttribute('x2', String(X0 + mle * W));
      const map = prior ? (k + 1) / (n + 2) : null;
      const mapEl = this.querySelector<SVGLineElement>('[data-map]')!;
      mapEl.style.display = map === null ? 'none' : '';
      if (map !== null) {
        mapEl.setAttribute('x1', String(X0 + map * W));
        mapEl.setAttribute('x2', String(X0 + map * W));
      }
      this.querySelector('[data-stat]')!.textContent =
        map === null
          ? `MLE = k/n = ${k}/${n} = ${mle.toFixed(3)}`
          : `MLE = k/n = ${mle.toFixed(3)} · MAP with Beta(2, 2) prior = (k+1)/(n+2) = ${map.toFixed(3)}`;
    }
  }
  customElements.define('likelihood-mle', LikelihoodMLE);
</script>
