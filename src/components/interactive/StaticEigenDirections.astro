---
import Figure from '../Figure.astro';

// A = [[2, 1], [1, 2]]. Eigen-directions (1, 1) and (1, -1) only get scaled: A(1,1) = 3(1,1), A(1,-1) = 1(1,-1).
const apply = (x: number, y: number) => [2 * x + y, x + 2 * y];
const v = [1, 0];
const av = apply(v[0], v[1]);
const e1 = [1, 1];
const ae1 = apply(e1[0], e1[1]);
const e2 = [1, -1];
const ae2 = apply(e2[0], e2[1]);
const f = (p: number[]) => `${p[0].toFixed(3)},${(-p[1]).toFixed(3)}`;
---

<Figure kind="Diagram"
  title="Eigen-directions: the only lines A leaves in place"
  caption="The vector (1, 0) is bent by A into (2, 1), changing direction. The directions (1, 1) and (1, −1) stay on their own lines: A sends (1, 1) to three times itself, and (1, −1) to itself."
>
  <svg class="sed-svg" viewBox="-4 -4 8 8" role="img" aria-label="Arrows showing A applied to (1,0), and the eigenvectors (1,1) and (1,-1) keeping their directions">
    <line x1="-4" y1="0" x2="4" y2="0" class="sed-axis"></line>
    <line x1="0" y1="-4" x2="0" y2="4" class="sed-axis"></line>
    <line x1="-3" y1="3" x2="3" y2="-3" class="sed-line"></line>
    <line x1="-3" y1="-3" x2="3" y2="3" class="sed-line"></line>
    <line x1="0" y1="0" x2={v[0]} y2={-v[1]} class="sed-v"></line>
    <line x1="0" y1="0" x2={av[0]} y2={-av[1]} class="sed-av"></line>
    <line x1="0" y1="0" x2={e1[0]} y2={-e1[1]} class="sed-e1"></line>
    <line x1="0" y1="0" x2={ae1[0]} y2={-ae1[1]} class="sed-e1 sed-long"></line>
    <line x1="0" y1="0" x2={e2[0]} y2={-e2[1]} class="sed-e2"></line>
    <line x1="0" y1="0" x2={ae2[0]} y2={-ae2[1]} class="sed-e2 sed-long"></line>
    <circle cx={v[0]} cy={-v[1]} r="0.09" class="sed-dot sed-dot-v"></circle>
    <circle cx={av[0]} cy={-av[1]} r="0.09" class="sed-dot sed-dot-av"></circle>
    <text x={av[0] + 0.2} y={-av[1] - 0.2} class="sed-lab">Av</text>
    <text x={v[0] + 0.2} y={-v[1] + 0.35} class="sed-lab">v</text>
    <text x={ae1[0] + 0.15} y={-ae1[1] - 0.15} class="sed-lab">λ = 3</text>
    <text x={ae2[0] + 0.15} y={-ae2[1] + 0.25} class="sed-lab">λ = 1</text>
  </svg>
</Figure>

<style>
  .sed-svg {
    display: block;
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
  }
  .sed-axis {
    stroke: #3c4043;
    stroke-width: 0.03;
  }
  .sed-line {
    stroke: #5f6368;
    stroke-width: 0.03;
    stroke-dasharray: 0.15 0.12;
  }
  .sed-svg line {
    stroke-width: 0.06;
  }
  .sed-dot {
    stroke: none;
  }
  .sed-dot-v {
    fill: var(--g-blue);
  }
  .sed-dot-av {
    fill: var(--g-yellow);
  }
  .sed-v {
    stroke: var(--g-blue);
    fill: var(--g-blue);
  }
  .sed-av {
    stroke: var(--g-yellow);
    fill: var(--g-yellow);
  }
  .sed-e1 {
    stroke: var(--g-green);
  }
  .sed-e2 {
    stroke: var(--g-red);
  }
  .sed-long {
    stroke-dasharray: 0.2 0.12;
    stroke-width: 0.05;
  }
  .sed-lab {
    fill: var(--text-muted);
    font: 0.28px var(--font-mono);
  }
</style>
