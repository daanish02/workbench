---
import Figure from '../Figure.astro';
---

<Figure
  title="Exponential and logarithm are mirror images"
  caption="Drag the base. The curve bˣ and the curve logᵦ(x) reflect across the diagonal y = x, because each undoes the other. At base e the exponential is its own slope."
>
  <log-exp-plot>
    <div class="ctl-row">
      <label class="lbl">Base b <input type="range" min="1.2" max="10" step="0.1" value="2" data-base /> <b data-basev>2</b></label>
    </div>
    <svg class="le-svg" viewBox="0 0 360 300" role="img" aria-label="Plot of b to the x and log base b of x with the line y equals x">
      <defs>
        <clipPath id="le-clip"><rect x="20" y="20" width="330" height="260"></rect></clipPath>
      </defs>
      <line x1="20" y1="150" x2="350" y2="150" class="le-axis"></line>
      <line x1="170" y1="20" x2="170" y2="280" class="le-axis"></line>
      <line x1="20" y1="280" x2="350" y2="20" class="le-diag"></line>
      <g clip-path="url(#le-clip)">
        <path data-exp class="le-exp"></path>
        <path data-log class="le-log"></path>
      </g>
      <text x="335" y="142" class="le-name">x</text>
      <text x="176" y="34" class="le-name">y</text>
    </svg>
    <p class="le-stat" data-stat></p>
  </log-exp-plot>
</Figure>

<style>
  .ctl-row {
    margin-bottom: 10px;
  }
  .lbl {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  input[type='range'] {
    flex: 1;
  }
  .le-svg {
    display: block;
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
  }
  .le-axis {
    stroke: #3c4043;
    stroke-width: 1;
  }
  .le-diag {
    stroke: #5f6368;
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  .le-exp {
    fill: none;
    stroke: var(--g-blue);
    stroke-width: 2.5;
  }
  .le-log {
    fill: none;
    stroke: var(--g-red);
    stroke-width: 2.5;
  }
  .le-name {
    fill: var(--text-faint);
    font: 0.75rem var(--font-mono);
  }
  .le-stat {
    margin: 10px 0 0;
    font: 0.875rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  // Plot window: x from -2.5 to 4.5 and y from -2.5 to 4.5, mapped onto the SVG.
  const X0 = -2.5;
  const X1 = 4.5;
  const Y0 = -2.5;
  const Y1 = 4.5;
  const px = (x: number) => 20 + ((x - X0) / (X1 - X0)) * 330;
  const py = (y: number) => 280 - ((y - Y0) / (Y1 - Y0)) * 260;

  function path(points: [number, number][]): string {
    return points.map(([x, y], i) => `${i ? 'L' : 'M'}${px(x).toFixed(1)},${py(y).toFixed(1)}`).join(' ');
  }

  class LogExpPlot extends HTMLElement {
    connectedCallback() {
      this.querySelector('[data-base]')!.addEventListener('input', () => this.draw());
      this.draw();
    }
    draw() {
      const b = +this.querySelector<HTMLInputElement>('[data-base]')!.value;
      this.querySelector('[data-basev]')!.textContent = b.toFixed(1);

      const exp: [number, number][] = [];
      for (let x = X0; x <= X1; x += 0.02) exp.push([x, Math.pow(b, x)]);
      const log: [number, number][] = [];
      for (let x = 0.01; x <= X1; x += 0.02) log.push([x, Math.log(x) / Math.log(b)]);

      this.querySelector('[data-exp]')!.setAttribute('d', path(exp));
      this.querySelector('[data-log]')!.setAttribute('d', path(log));

      const ex = Math.pow(b, 2);
      this.querySelector('[data-stat]')!.textContent =
        `b² = ${ex.toFixed(2)} and logᵦ(${ex.toFixed(2)}) = ${(Math.log(ex) / Math.log(b)).toFixed(2)}`;
    }
  }
  customElements.define('log-exp-plot', LogExpPlot);
</script>
