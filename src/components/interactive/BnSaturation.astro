---
import Figure from '../Figure.astro';
---

<Figure
  title="Batch norm keeps tanh units out of saturation"
  caption="Histogram of the tanh outputs of one layer for 256 random inputs, in the 6-layer, 32-unit network from the note with weights of standard deviation 1. Without batch norm most outputs pile up at −1 and +1 (red bars), where tanh's slope is near zero and almost no gradient passes. With batch norm each layer's inputs are rescaled to unit variance first, and the outputs spread across the range."
>
  <bn-saturation>
    <div class="bs-ctl">
      <input type="hidden" data-layer value="3" />
      <span class="choice">
        <button type="button" class="btn" data-choice="1" aria-pressed="false">layer 1</button>
        <button type="button" class="btn" data-choice="3" aria-pressed="true">layer 3</button>
        <button type="button" class="btn" data-choice="6" aria-pressed="false">layer 6</button>
      </span>
      <input type="checkbox" hidden data-bn />
      <button type="button" class="btn" data-toggle aria-pressed="false">Batch norm</button>
    </div>
    <div class="axes" style="--ax-w: 440px">
      <span class="ax-y">share of outputs</span>
      <svg class="bs-svg" viewBox="0 0 400 200" data-grid='{"box":[30,10,390,180],"y":[0,0.6]}' role="img" aria-label="Histogram of tanh activations in one layer">
        <g data-bars></g>
        <text x="30" y="196" class="ax-tick">−1</text>
        <text x="210" y="196" class="ax-tick bs-mid">0</text>
        <text x="390" y="196" class="ax-tick bs-end">1</text>
      </svg>
      <span class="ax-x">tanh output</span>
    </div>
    <p class="bs-stat" data-stat></p>
  </bn-saturation>
</Figure>

<style>
  .bs-ctl {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-bottom: 10px;
  }
  .bs-svg {
    display: block;
    width: 100%;
    max-width: 440px;
  }
  .bs-svg :global(.bs-ok) {
    fill: var(--g-blue);
  }
  .bs-svg :global(.bs-sat) {
    fill: var(--g-red);
  }
  .bs-mid {
    text-anchor: middle;
  }
  .bs-end {
    text-anchor: end;
  }
  .bs-stat {
    margin: 10px 0 0;
    font: 0.875rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  const BINS = 20;
  const N = 256;
  const W = 32;
  const DEPTH = 6;

  function rng(seed: number) {
    let s = seed >>> 0;
    const u = () => {
      s = (s + 0x6d2b79f5) >>> 0;
      let t = s;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
    return () => Math.sqrt(-2 * Math.log(u() + 1e-12)) * Math.cos(2 * Math.PI * u());
  }

  // Forward pass once per setting; returns the tanh outputs of every layer.
  function run(bn: boolean): number[][][] {
    const g = rng(4);
    let h: number[][] = Array.from({ length: N }, () => [g(), g()]);
    const layers: number[][][] = [];
    let inDim = 2;
    for (let l = 0; l < DEPTH; l++) {
      const Wm = Array.from({ length: inDim }, () => Array.from({ length: W }, () => g()));
      let z = h.map((row) => Array.from({ length: W }, (_, j) => row.reduce((s, v, i) => s + v * Wm[i][j], 0)));
      if (bn)
        for (let j = 0; j < W; j++) {
          const col = z.map((r) => r[j]);
          const m = col.reduce((a, b) => a + b, 0) / N;
          const v = col.reduce((a, b) => a + (b - m) ** 2, 0) / N;
          z.forEach((r) => (r[j] = (r[j] - m) / Math.sqrt(v + 1e-5)));
        }
      h = z.map((r) => r.map(Math.tanh));
      layers.push(h);
      inDim = W;
    }
    return layers;
  }

  class BnSaturation extends HTMLElement {
    cache: Record<string, number[][][]> = {};
    connectedCallback() {
      this.querySelector('[data-layer]')!.addEventListener('input', () => this.draw());
      this.querySelector('[data-bn]')!.addEventListener('input', () => this.draw());
      this.draw();
    }
    draw() {
      const layer = +this.querySelector<HTMLInputElement>('[data-layer]')!.value;
      const bn = this.querySelector<HTMLInputElement>('[data-bn]')!.checked;
      const key = bn ? 'bn' : 'plain';
      this.cache[key] ??= run(bn);
      const vals = this.cache[key][layer - 1].flat();
      const counts = new Array(BINS).fill(0);
      for (const v of vals) counts[Math.min(BINS - 1, Math.floor(((v + 1) / 2) * BINS))]++;
      const bw = 360 / BINS;
      this.querySelector('[data-bars]')!.innerHTML = counts
        .map((c, i) => {
          const share = c / vals.length;
          const h = (Math.min(share, 0.6) / 0.6) * 170;
          const edge = i === 0 || i === BINS - 1;
          return `<rect x="${(30 + i * bw + 1).toFixed(1)}" y="${(180 - h).toFixed(1)}" width="${(bw - 2).toFixed(1)}" height="${h.toFixed(1)}" class="${edge ? 'bs-sat' : 'bs-ok'}"></rect>`;
        })
        .join('');
      const sat = vals.filter((v) => Math.abs(v) > 0.9).length / vals.length;
      const slope = vals.reduce((s, v) => s + (1 - v * v), 0) / vals.length;
      this.querySelector('[data-stat]')!.textContent =
        `layer ${layer}${bn ? ' with batch norm' : ''} · |output| > 0.9: ${(sat * 100).toFixed(0)} % · mean tanh slope ${slope.toFixed(2)}`;
    }
  }
  customElements.define('bn-saturation', BnSaturation);
</script>
