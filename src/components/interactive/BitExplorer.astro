---
import Figure from '../Figure.astro';
---

<Figure
  title="One byte, three readings"
  caption="Click bits to flip them, or type a number. The pattern never changes meaning by itself: the same eight bits are read as an unsigned integer, as a two's complement signed integer (where the top bit weighs −128), and as two hex digits, one per group of four bits."
>
  <bit-explorer>
    <div class="bits" data-bits></div>
    <div class="readings">
      <div class="reading"><span class="ctl-label">Unsigned</span><b data-u></b><small data-u-sum></small></div>
      <div class="reading"><span class="ctl-label">Signed</span><b data-s></b><small data-s-sum></small></div>
      <div class="reading"><span class="ctl-label">Hex</span><b data-h></b><small>one digit per 4 bits</small></div>
    </div>
    <div class="ctl-row" style="margin-top:12px">
      <label class="ctl-label" for="be-in">Set from decimal</label>
      <input class="input" id="be-in" data-in type="number" min="-128" max="255" value="-5" style="width:7em" />
      <button class="btn" data-neg>Negate (flip + 1)</button>
      <button class="btn" data-inc>+1</button>
      <button class="btn" data-dec>−1</button>
    </div>
  </bit-explorer>
</Figure>

<style>
  .bits {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 6px;
  }
  .bits :global(button) {
    appearance: none;
    border: 1px solid var(--border-strong);
    background: var(--bg-soft);
    border-radius: 10px;
    padding: 8px 0 6px;
    cursor: pointer;
    color: var(--text-faint);
    font: inherit;
    transition: background 0.15s, border-color 0.15s;
  }
  .bits :global(button b) {
    display: block;
    font: 700 1.375rem var(--font-mono);
    color: var(--text-muted);
  }
  .bits :global(button small) {
    font: 0.6875rem var(--font-mono);
  }
  .bits :global(button.one) {
    background: rgba(66, 133, 244, 0.16);
    border-color: var(--g-blue);
  }
  .bits :global(button.one b) {
    color: #fff;
  }
  .bits :global(button.msb.one) {
    background: rgba(234, 67, 53, 0.16);
    border-color: var(--g-red);
  }
  .bits :global(button:nth-child(4)) {
    margin-right: 6px;
  }
  .readings {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 8px;
  }
  .reading {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 8px 12px;
  }
  .reading b {
    display: block;
    font: 700 1.5rem var(--font-mono);
  }
  .reading small {
    display: block;
    font: 0.6875rem var(--font-mono);
    color: var(--text-faint);
    overflow-wrap: anywhere;
  }
</style>

<script>
  class BitExplorer extends HTMLElement {
    v = 0b11111011; // stored as unsigned 0..255

    connectedCallback() {
      const box = this.querySelector('[data-bits]')!;
      for (let i = 7; i >= 0; i--) {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.i = String(i);
        if (i === 7) b.classList.add('msb');
        b.addEventListener('click', () => ((this.v ^= 1 << i), this.draw()));
        box.append(b);
      }
      const input = this.querySelector<HTMLInputElement>('[data-in]')!;
      input.addEventListener('input', () => {
        const n = Math.trunc(+input.value);
        if (Number.isFinite(n) && n >= -128 && n <= 255) (this.v = n & 0xff), this.draw(false);
      });
      this.querySelector('[data-neg]')!.addEventListener('click', () => ((this.v = (~this.v + 1) & 0xff), this.draw()));
      this.querySelector('[data-inc]')!.addEventListener('click', () => ((this.v = (this.v + 1) & 0xff), this.draw()));
      this.querySelector('[data-dec]')!.addEventListener('click', () => ((this.v = (this.v - 1) & 0xff), this.draw()));
      this.draw();
    }
    draw(syncInput = true) {
      const v = this.v;
      const signed = v & 0x80 ? v - 256 : v;
      this.querySelectorAll<HTMLButtonElement>('[data-bits] button').forEach((b) => {
        const i = +b.dataset.i!;
        const on = (v >> i) & 1;
        b.classList.toggle('one', !!on);
        b.innerHTML = `<b>${on}</b><small>${i === 7 ? '128 / −128' : 2 ** i}</small>`;
        b.setAttribute('aria-label', `bit ${i}, ${on ? 'on' : 'off'}`);
      });
      const ones = [7, 6, 5, 4, 3, 2, 1, 0].filter((i) => (v >> i) & 1);
      this.querySelector('[data-u]')!.textContent = String(v);
      this.querySelector('[data-u-sum]')!.textContent = ones.length ? ones.map((i) => 2 ** i).join(' + ') : '0';
      this.querySelector('[data-s]')!.textContent = String(signed);
      this.querySelector('[data-s-sum]')!.textContent = ones.length ? ones.map((i) => (i === 7 ? '−128' : 2 ** i)).join(' + ').replace(/\+ −/g, '− ') : '0';
      this.querySelector('[data-h]')!.textContent = '0x' + v.toString(16).toUpperCase().padStart(2, '0');
      if (syncInput) this.querySelector<HTMLInputElement>('[data-in]')!.value = String(signed);
    }
  }
  customElements.define('bit-explorer', BitExplorer);
</script>
