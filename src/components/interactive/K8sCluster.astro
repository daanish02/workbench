---
import Figure from '../Figure.astro';

const plane = [
  { name: 'scheduler', x: 160 },
  { name: 'controllers', x: 300 },
];
const nodes = [
  { name: 'node 1', x: 10, pods: ['web', 'web'] },
  { name: 'node 2', x: 226, pods: ['web', 'db'] },
];
---

<Figure
  kind="Diagram"
  title="Everything goes through the API server"
  caption="The control plane (top) stores desired state in etcd behind the API server. The scheduler and the controllers watch the API server and write decisions back to it. On each worker node (bottom), the kubelet watches for Pods assigned to its node and starts their containers through containerd; kube-proxy programs Service routing. No component talks to etcd except the API server."
>
  <svg class="kc-svg" viewBox="0 0 440 290" role="img" aria-label="Control plane with API server, etcd, scheduler and controllers above two worker nodes with kubelet, kube-proxy and Pods">
    <defs>
      <marker id="kc-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" class="kc-head"></path>
      </marker>
    </defs>
    <rect class="kc-zone" x="4" y="4" width="432" height="118" rx="8"></rect>
    <text class="kc-t" x="14" y="18">control plane</text>

    <rect class="kc-api" x="140" y="76" width="160" height="34" rx="6"></rect>
    <text class="kc-c" x="220" y="93">API server</text>
    <rect class="kc-etcd" x="14" y="76" width="90" height="34" rx="6"></rect>
    <text class="kc-c" x="59" y="93">etcd</text>
    <line class="kc-line" x1="104" y1="93" x2="138" y2="93" marker-start="url(#kc-arrow)" marker-end="url(#kc-arrow)"></line>
    {plane.map((p) => (
      <g>
        <rect class="kc-ctl" x={p.x - 60} y="30" width="120" height="30" rx="6"></rect>
        <text class="kc-c" x={p.x} y="45">{p.name}</text>
        <line class="kc-line" x1={p.x < 220 ? p.x + 20 : p.x - 40} y1="60" x2={p.x < 220 ? 200 : 240} y2="74" marker-start="url(#kc-arrow)" marker-end="url(#kc-arrow)"></line>
      </g>
    ))}
    <rect class="kc-ctl" x="320" y="76" width="106" height="34" rx="6"></rect>
    <text class="kc-c" x="373" y="93">kubectl, CI</text>
    <line class="kc-line" x1="320" y1="93" x2="302" y2="93" marker-end="url(#kc-arrow)"></line>

    {nodes.map((n) => (
      <g>
        <line class="kc-line" x1={n.x + 54} y1="168" x2={n.x < 100 ? 200 : 240} y2="112" marker-start="url(#kc-arrow)" marker-end="url(#kc-arrow)"></line>
        <rect class="kc-zone" x={n.x} y="136" width="204" height="150" rx="8"></rect>
        <text class="kc-t" x={n.x + 10} y="150">{n.name}</text>
        <rect class="kc-ctl" x={n.x + 10} y="168" width="88" height="28" rx="5"></rect>
        <text class="kc-c" x={n.x + 54} y="182">kubelet</text>
        <rect class="kc-ctl" x={n.x + 106} y="168" width="88" height="28" rx="5"></rect>
        <text class="kc-c" x={n.x + 150} y="182">kube-proxy</text>
        <rect class="kc-rt" x={n.x + 10} y="204" width="184" height="24" rx="5"></rect>
        <text class="kc-c" x={n.x + 102} y="216">containerd</text>
        {n.pods.map((p, i) => (
          <g>
            <rect class={p === 'db' ? 'kc-pod2' : 'kc-pod'} x={n.x + 10 + i * 96} y="238" width="88" height="38" rx="6"></rect>
            <text class="kc-c" x={n.x + 54 + i * 96} y="257">Pod {p}</text>
          </g>
        ))}
      </g>
    ))}
  </svg>
</Figure>

<style>
  .kc-svg {
    display: block;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
  }
  .kc-zone {
    fill: transparent;
    stroke: var(--border-strong);
  }
  .kc-api {
    fill: rgba(251, 188, 5, 0.25);
    stroke: var(--g-yellow);
  }
  .kc-etcd {
    fill: rgba(52, 168, 83, 0.22);
    stroke: var(--g-green);
  }
  .kc-ctl {
    fill: rgba(66, 133, 244, 0.16);
    stroke: var(--g-blue);
  }
  .kc-rt {
    fill: transparent;
    stroke: var(--border-strong);
  }
  .kc-pod {
    fill: rgba(66, 133, 244, 0.3);
    stroke: var(--g-blue);
  }
  .kc-pod2 {
    fill: rgba(52, 168, 83, 0.3);
    stroke: var(--g-green);
  }
  .kc-line {
    stroke: var(--text-faint);
    stroke-width: 1.3;
  }
  .kc-head {
    fill: var(--text-faint);
  }
  .kc-svg text {
    font: 11px var(--font-mono);
    dominant-baseline: central;
  }
  .kc-c {
    fill: var(--text);
    text-anchor: middle;
  }
  .kc-t {
    fill: var(--text-muted);
  }
</style>
