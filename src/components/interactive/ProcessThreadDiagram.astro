---
import Figure from '../Figure.astro';
---

<Figure
  kind="Diagram"
  title="What is private, what is shared"
  caption="Left: two processes each get a private address space, so neither can touch the other's heap. Right: threads of one process share code, globals, heap and open files; only the stack and the registers (the execution state) belong to each thread."
>
  <div class="ptd">
    <div class="col">
      <p class="hd">Two processes</p>
      <div class="pair">
        {
          ['A', 'B'].map((p) => (
            <div class="proc">
              <span class="tag">Process {p}</span>
              <div class="reg code">code</div>
              <div class="reg data">globals</div>
              <div class="reg heap">heap</div>
              <div class="reg files">open files</div>
              <div class="reg stack">stack + registers</div>
            </div>
          ))
        }
      </div>
      <p class="note">isolated by default</p>
    </div>
    <div class="col">
      <p class="hd">Two threads in one process</p>
      <div class="proc shared">
        <span class="tag">Process</span>
        <div class="reg code">code <em>shared</em></div>
        <div class="reg data">globals <em>shared</em></div>
        <div class="reg heap">heap <em>shared</em></div>
        <div class="reg files">open files <em>shared</em></div>
        <div class="threads">
          <div class="reg stack">Thread 1<br /><small>stack + registers</small></div>
          <div class="reg stack t2">Thread 2<br /><small>stack + registers</small></div>
        </div>
      </div>
      <p class="note">shared memory, separate execution</p>
    </div>
  </div>
</Figure>

<style>
  .ptd {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  @media (max-width: 560px) {
    .ptd {
      grid-template-columns: 1fr;
    }
  }
  .hd {
    margin: 0 0 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .proc {
    position: relative;
    border: 1.5px dashed var(--border-strong);
    border-radius: 10px;
    padding: 22px 8px 8px;
    display: grid;
    gap: 5px;
  }
  .tag {
    position: absolute;
    top: 4px;
    left: 8px;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-faint);
  }
  .reg {
    border-radius: 6px;
    padding: 5px 8px;
    font: 0.75rem var(--font-mono);
    border: 1px solid var(--c);
    background: color-mix(in srgb, var(--c) 14%, transparent);
    color: var(--text);
  }
  .reg em {
    float: right;
    font-style: normal;
    font-size: 0.625rem;
    color: var(--g-green-l);
  }
  .reg small {
    color: var(--text-muted);
  }
  .code {
    --c: var(--g-blue);
  }
  .data {
    --c: #a142f4;
  }
  .heap {
    --c: var(--g-green);
  }
  .files {
    --c: #24c1e0;
  }
  .stack {
    --c: var(--g-red);
  }
  .t2 {
    --c: var(--g-yellow);
  }
  .threads {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5px;
  }
  .note {
    margin: 6px 0 0;
    font-size: 0.75rem;
    color: var(--text-faint);
    text-align: center;
  }
</style>
