---
import Figure from '../Figure.astro';
---

<Figure
  title="Adaptive bitrate: quality that follows your network"
  caption="The video is cut into 4-second segments, each available at five qualities. The player measures its throughput and picks the best quality it can sustain for every next segment. Grey is available bandwidth, the blue line is the quality chosen, the green area is how many seconds are buffered. Compare a player that insists on 1080p with an adaptive one when bandwidth dips or fluctuates."
>
  <abr-demo>
    <div class="ctl-row">
      <span class="ctl-label">Network</span>
      <button class="btn" data-n="stable" aria-pressed="false">Stable 6 Mbit/s</button>
      <button class="btn" data-n="dips" aria-pressed="true">Congestion dip</button>
      <button class="btn" data-n="cell" aria-pressed="false">Cellular</button>
      <span class="ctl-label">Player</span>
      <button class="btn" data-p="fixed" aria-pressed="false">Always 1080p</button>
      <button class="btn" data-p="adaptive" aria-pressed="true">Adaptive</button>
    </div>
    <svg viewBox="0 0 400 200" class="ab-svg" data-svg aria-label="Bandwidth, chosen quality and buffer over time"></svg>
    <div class="ab-legend"><span><i style="background: var(--text-faint)"></i>bandwidth</span><span><i style="background: var(--g-blue)"></i>chosen quality</span><span><i style="background: var(--g-green)"></i>buffer (s)</span><span><i style="background: var(--g-red)"></i>stall</span></div>
    <p class="ab-msg" data-msg></p>
  </abr-demo>
</Figure>

<style>
  .ab-svg {
    width: 100%;
    max-width: 680px;
    display: block;
    margin: 10px auto 0;
    background: var(--bg-soft);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
  }
  .ab-svg :global(text) {
    font: 9px var(--font-mono);
    fill: var(--text-muted);
  }
  .ab-svg :global(.ax) {
    stroke: var(--border-strong);
  }
  .ab-svg :global(.bw) {
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 2;
  }
  .ab-svg :global(.q) {
    fill: none;
    stroke: var(--g-blue);
    stroke-width: 2.5;
  }
  .ab-svg :global(.buf) {
    fill: rgba(52, 168, 83, 0.25);
    stroke: var(--g-green);
  }
  .ab-svg :global(.stall) {
    fill: rgba(234, 67, 53, 0.55);
  }
  .ab-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    justify-content: center;
    margin-top: 8px;
    font: 0.75rem var(--font-mono);
    color: var(--text-muted);
  }
  .ab-legend i {
    display: inline-block;
    width: 12px;
    height: 3px;
    margin-right: 6px;
    vertical-align: middle;
  }
  .ab-msg {
    margin: 10px 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    min-height: 3.4em;
  }
</style>

<script>
  const LADDER = [0.4, 0.8, 1.4, 2.8, 5.0]; // Mbit/s for 240p ... 1080p
    const SEG = 4;
  const BW: Record<string, (t: number) => number> = {
    stable: () => 6,
    dips: (t) => (t >= 40 && t < 70 ? 1 : 6),
    cell: (t) => [4, 1.5, 0.9, 3, 0.6, 2.5][Math.floor(t / 15) % 6],
  };
  interface Seg {
    t: number;
    r: number;
    buf: number;
    stall: number;
  }
  function play(bw: (t: number) => number, adaptive: boolean) {
    let t = 0;
    let buffer = 0;
    let est = bw(0);
    let played = 0;
    let startup: number | null = null;
    let stalls = 0;
    let frozen = 0;
    const segs: Seg[] = [];
    while (played < 120) {
      let r = 4;
      if (adaptive) {
        r = 0;
        LADDER.forEach((v, i) => v <= 0.85 * est && (r = i));
        if (buffer < 6) r = 0;
      }
      const dl = (LADDER[r] * SEG) / bw(t);
      est = 0.5 * est + 0.5 * bw(t);
      let stall = 0;
      if (startup === null) startup = dl;
      else if (dl > buffer) {
        stalls++;
        stall = dl - buffer;
        frozen += stall;
        buffer = 0;
      } else buffer -= dl;
      buffer += SEG;
      segs.push({ t, r, buf: buffer, stall });
      t += dl;
      played += SEG;
      if (buffer > 20) {
        t += buffer - 20;
        buffer = 20;
      }
    }
    return { segs, startup: startup ?? 0, stalls, frozen, avg: segs.reduce((a, s) => a + LADDER[s.r], 0) / segs.length, end: t };
  }
  class AbrDemo extends HTMLElement {
    net = 'dips';
    adaptive = true;
    connectedCallback() {
      this.querySelectorAll<HTMLButtonElement>('[data-n]').forEach((b) => b.addEventListener('click', () => ((this.net = b.dataset.n!), this.mark('[data-n]', b), this.draw())));
      this.querySelectorAll<HTMLButtonElement>('[data-p]').forEach((b) => b.addEventListener('click', () => ((this.adaptive = b.dataset.p === 'adaptive'), this.mark('[data-p]', b), this.draw())));
      this.draw();
    }
    mark(sel: string, on: HTMLElement) {
      this.querySelectorAll(sel).forEach((x) => x.setAttribute('aria-pressed', String(x === on)));
    }
    draw() {
      const bw = BW[this.net];
      const res = play(bw, this.adaptive);
      const T = Math.max(res.end, 130);
      const X = (t: number) => 30 + (t / T) * 360;
      const Y = (mbps: number) => 170 - (mbps / 6.5) * 150;
      const YB = (s: number) => 170 - (s / 25) * 60; // buffer scale on a smaller band
      let h = `<line class="ax" x1="30" y1="170" x2="390" y2="170"></line><line class="ax" x1="30" y1="15" x2="30" y2="170"></line>`;
      let pts = '';
      for (let t = 0; t <= T; t += 1) pts += `${X(t).toFixed(1)},${Y(bw(t)).toFixed(1)} `;
      h += `<polyline class="bw" points="${pts}"></polyline>`;
      h += `<polygon class="buf" points="${X(0)},170 ${res.segs.map((s) => `${X(s.t).toFixed(1)},${YB(s.buf).toFixed(1)}`).join(' ')} ${X(res.end)},170"></polygon>`;
      let q = '';
      res.segs.forEach((s, i) => {
        const next = res.segs[i + 1]?.t ?? res.end;
        q += `${X(s.t).toFixed(1)},${Y(LADDER[s.r]).toFixed(1)} ${X(next).toFixed(1)},${Y(LADDER[s.r]).toFixed(1)} `;
        if (s.stall > 0) h += `<rect class="stall" x="${X(s.t) - 2}" y="15" width="4" height="155"></rect>`;
      });
      h += `<polyline class="q" points="${q}"></polyline>`;
      h += [0, 40, 80, 120].map((t) => `<text x="${X(t) - 6}" y="183">${t}s</text>`).join('') + `<text x="4" y="22">6 Mbit/s</text><text x="150" y="196">time</text>`;
      this.querySelector('[data-svg]')!.innerHTML = h;
      this.querySelector('[data-msg]')!.textContent = `${this.adaptive ? 'Adaptive' : 'Fixed 1080p'}: start-up ${res.startup.toFixed(1)} s, ${res.stalls} stall${res.stalls === 1 ? '' : 's'} (${res.frozen.toFixed(1)} s frozen), average quality ${res.avg.toFixed(1)} Mbit/s. ${this.adaptive ? 'It gives up some resolution in exchange for almost never freezing.' : 'It always asks for the highest quality, so any dip below 5 Mbit/s drains the buffer and the video freezes.'}`;
    }
  }
  customElements.define('abr-demo', AbrDemo);
</script>
