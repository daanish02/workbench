---
import Figure from '../Figure.astro';
---

<Figure
  title="One graph, many adjacency matrices"
  caption="A 6-node graph (left) and its adjacency matrix (right): a blue cell at row u, column v means an edge between u and v. Press Renumber: the node labels are shuffled while the drawing stays the same, and the matrix rows and columns are permuted with them, so the matrix looks different although the graph has not changed. The readout counts how many matrix cells changed and lists the edge list in the current numbering."
>
  <graph-repr>
    <div class="gr-ctl">
      <button type="button" class="btn" data-shuffle>Renumber</button>
      <button type="button" class="btn" data-reset>Reset</button>
    </div>
    <svg class="gr-svg" viewBox="0 0 400 190" role="img" aria-label="A graph and its adjacency matrix under a node numbering">
      <g data-g></g>
    </svg>
    <p class="gr-stat" data-stat></p>
  </graph-repr>
</Figure>

<style>
  .gr-ctl {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
  }
  .gr-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .gr-svg :global(.gr-t) {
    fill: var(--text);
    font: 11px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .gr-svg :global(.gr-s) {
    fill: var(--text-faint);
    font: 10px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .gr-stat {
    margin: 10px 0 0;
    font: 0.8125rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  // fixed layout; edges between drawing positions
  const POS = [
    [40, 50],
    [110, 30],
    [160, 95],
    [100, 150],
    [30, 130],
    [185, 165],
  ];
  const EDGES = [
    [0, 1],
    [1, 2],
    [0, 4],
    [4, 3],
    [3, 2],
    [2, 5],
    [1, 3],
  ];
  const N = POS.length;
  const MX = 236;
  const MY = 28;
  const C = 24;

  class GraphRepr extends HTMLElement {
    label = [0, 1, 2, 3, 4, 5]; // label[position] = node number
    seed = 1;
    connectedCallback() {
      this.querySelector('[data-shuffle]')!.addEventListener('click', () => {
        // deterministic shuffle so the figure behaves the same for every reader
        const l = this.label.slice();
        for (let i = N - 1; i > 0; i--) {
          this.seed = (this.seed * 48271) % 2147483647;
          const j = this.seed % (i + 1);
          [l[i], l[j]] = [l[j], l[i]];
        }
        this.label = l;
        this.draw();
      });
      this.querySelector('[data-reset]')!.addEventListener('click', () => {
        this.label = [0, 1, 2, 3, 4, 5];
        this.seed = 1;
        this.draw();
      });
      this.draw();
    }
    matrix(label: number[]) {
      const M = Array.from({ length: N }, () => Array(N).fill(0));
      for (const [a, b] of EDGES) {
        M[label[a]][label[b]] = 1;
        M[label[b]][label[a]] = 1;
      }
      return M;
    }
    draw() {
      const M = this.matrix(this.label);
      const M0 = this.matrix([0, 1, 2, 3, 4, 5]);
      let changed = 0;
      let html = '';
      for (const [a, b] of EDGES) html += `<line x1="${POS[a][0]}" y1="${POS[a][1]}" x2="${POS[b][0]}" y2="${POS[b][1]}" style="stroke:var(--text-faint);stroke-width:2"></line>`;
      POS.forEach(([x, y], p) => {
        html += `<circle cx="${x}" cy="${y}" r="13" style="fill:var(--bg)"></circle><circle cx="${x}" cy="${y}" r="13" style="fill:rgba(66,133,244,0.3);stroke:var(--g-blue);stroke-width:2"></circle><text x="${x}" y="${y}" class="gr-t">${this.label[p]}</text>`;
      });
      for (let i = 0; i < N; i++) {
        html += `<text x="${MX - 10}" y="${MY + i * C + C / 2}" class="gr-s">${i}</text><text x="${MX + i * C + C / 2}" y="${MY - 10}" class="gr-s">${i}</text>`;
        for (let j = 0; j < N; j++) {
          const diff = M[i][j] !== M0[i][j];
          if (diff) changed++;
          const fill = M[i][j] ? 'rgba(66,133,244,0.6)' : 'transparent';
          html += `<rect x="${MX + j * C + 1.5}" y="${MY + i * C + 1.5}" width="${C - 3}" height="${C - 3}" rx="3" style="fill:${fill};stroke:${diff ? 'var(--g-yellow)' : 'var(--border)'}"></rect>`;
        }
      }
      this.querySelector('[data-g]')!.innerHTML = html;
      const list = EDGES.map(([a, b]) => {
        const u = this.label[a];
        const v = this.label[b];
        return `${Math.min(u, v)}-${Math.max(u, v)}`;
      }).sort();
      this.querySelector('[data-stat]')!.textContent = `${changed} of 36 cells changed (yellow) · same 7 edges: ${list.join(' ')}`;
    }
  }
  customElements.define('graph-repr', GraphRepr);
</script>
