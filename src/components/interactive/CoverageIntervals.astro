---
import Figure from '../Figure.astro';
---

<Figure
  title="100 confidence intervals"
  caption="Each row is one sample's confidence interval for the true mean 0. Blue intervals contain 0; red ones miss it. The procedure promises that about the chosen share of rows are blue, and the count shows it."
>
  <coverage-intervals>
    <div class="ci-ctl">
      <label>n <input type="range" min="5" max="100" step="1" value="20" data-n /><b data-nv>20</b></label>
      <div class="choice-row"><span class="ctl-label">level</span>
        <input type="hidden" data-level value="1.96" /><span class="choice"><button type="button" class="btn" data-choice="1.645" aria-pressed="false">90%</button><button type="button" class="btn" data-choice="1.96" aria-pressed="true">95%</button><button type="button" class="btn" data-choice="2.576" aria-pressed="false">99%</button></span>
      </div>
      <button type="button" data-new>new samples</button>
    </div>
    <svg class="ci-svg" viewBox="0 0 400 200" role="img" aria-label="One hundred horizontal confidence intervals around a vertical line at zero, most crossing it">
      <line x1="200" y1="0" x2="200" y2="200" class="ci-zero"></line>
      <g data-rows></g>
    </svg>
    <p class="ci-stat" data-stat></p>
  </coverage-intervals>
</Figure>

<style>
  .ci-ctl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-bottom: 10px;
  }
  .ci-ctl label {
    flex: 1 1 160px;
    display: flex;
    align-items: center;
    gap: 8px;
    font: 0.8125rem var(--font-mono);
    color: var(--text-muted);
  }
  .ci-ctl input {
    flex: 1;
    min-width: 0;
  }
  .ci-ctl b {
    min-width: 2em;
    text-align: right;
    color: var(--text);
  }
  .ci-ctl select,
  .ci-ctl button {
    font: 0.8125rem var(--font-mono);
    color: var(--text);
    background: transparent;
    border: 1px solid #3c4043;
    border-radius: 4px;
    padding: 2px 6px;
  }
  .ci-ctl button {
    cursor: pointer;
  }
  .ci-ctl option {
    background: #1a1a1a;
    color: #e8eaed;
  }
  .ci-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .ci-zero {
    stroke: var(--g-yellow);
    stroke-width: 1.2;
  }
  .ci-svg :global(.ci-hit) {
    stroke: var(--g-blue);
    stroke-width: 1.2;
  }
  .ci-svg :global(.ci-miss) {
    stroke: var(--g-red);
    stroke-width: 1.6;
  }
  .ci-stat {
    margin: 10px 0 0;
    font: 0.8125rem/1.6 var(--font-mono);
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script>
  const rng = (seed: number) => () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
  const gauss = (r: () => number) => Math.sqrt(-2 * Math.log(1 - r())) * Math.cos(2 * Math.PI * r());

  class CoverageIntervals extends HTMLElement {
    seed = 3;
    connectedCallback() {
      this.querySelector('[data-n]')!.addEventListener('input', () => this.draw());
      this.querySelector('[data-level]')!.addEventListener('change', () => this.draw());
      this.querySelector('[data-new]')!.addEventListener('click', () => {
        this.seed += 1;
        this.draw();
      });
      this.draw();
    }

    draw() {
      const n = +this.querySelector<HTMLInputElement>('[data-n]')!.value;
      const z = +this.querySelector<HTMLSelectElement>('[data-level]')!.value;
      const level = z === 1.645 ? 90 : z === 1.96 ? 95 : 99;
      this.querySelector('[data-nv]')!.textContent = String(n);
      // x from -1.5 to 1.5 over 0..400; 100 rows over 0..200
      const toX = (v: number) => 200 + (v / 1.5) * 190;
      const r = rng(this.seed);
      const half = (z * 1) / Math.sqrt(n);
      let html = '';
      let covered = 0;
      for (let i = 0; i < 100; i++) {
        let s = 0;
        for (let j = 0; j < n; j++) s += gauss(r);
        const xbar = s / n;
        const hit = Math.abs(xbar) <= half;
        if (hit) covered++;
        const y = 1 + i * 2;
        html += `<line class="${hit ? 'ci-hit' : 'ci-miss'}" x1="${toX(xbar - half).toFixed(2)}" y1="${y}" x2="${toX(xbar + half).toFixed(2)}" y2="${y}"></line>`;
      }
      this.querySelector('[data-rows]')!.innerHTML = html;
      this.querySelector('[data-stat]')!.textContent =
        `${covered} of 100 intervals contain 0 · target ${level}% · half-width ${half.toFixed(3)}`;
    }
  }
  customElements.define('coverage-intervals', CoverageIntervals);
</script>
