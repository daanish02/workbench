---
import Figure from '../Figure.astro';

// Joint table for X and Y in {0, 1}; cell shade grows with probability.
const cells = [
  { x: 0, y: 0, p: 0.1, cx: 205, cy: 100 },
  { x: 0, y: 1, p: 0.4, cx: 315, cy: 100 },
  { x: 1, y: 0, p: 0.2, cx: 205, cy: 200 },
  { x: 1, y: 1, p: 0.3, cx: 315, cy: 200 },
];
---

<Figure
  kind="Diagram"
  title="Joint table with marginals"
  caption="Each cell is P(X = x, Y = y). The row totals on the right are the marginal of X, and the column totals along the bottom are the marginal of Y. Darker cells hold more probability."
>
  <svg class="jt-svg" viewBox="0 0 520 290" role="img" aria-label="A two by two joint probability table with values 0.1, 0.4, 0.2, 0.3, row totals 0.5 and 0.5, and column totals 0.3 and 0.7.">
    <text x="255" y="38" class="jt-h">Y = 0</text>
    <text x="365" y="38" class="jt-h">Y = 1</text>
    <text x="135" y="100" class="jt-h jt-end">X = 0</text>
    <text x="135" y="200" class="jt-h jt-end">X = 1</text>
    {cells.map((c) => (
      <g>
        <rect x={c.cx - 55} y={c.cy - 50} width="110" height="100" class="jt-cell" style={`fill-opacity: ${(0.12 + c.p * 2).toFixed(2)}`}></rect>
        <text x={c.cx} y={c.cy} class="jt-v">{c.p.toFixed(1)}</text>
      </g>
    ))}
    <text x="385" y="100" class="jt-t jt-start">P(X = 0) = 0.5</text>
    <text x="385" y="200" class="jt-t jt-start">P(X = 1) = 0.5</text>
    <text x="205" y="270" class="jt-t">P(Y = 0) = 0.3</text>
    <text x="315" y="270" class="jt-t">P(Y = 1) = 0.7</text>
  </svg>
</Figure>

<style>
  .jt-svg {
    display: block;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
  }
  .jt-cell {
    fill: var(--g-blue);
    stroke: #3c4043;
    stroke-width: 1;
  }
  .jt-h {
    fill: var(--text);
    font: 600 13px var(--font-mono);
    text-anchor: middle;
  }
  .jt-end {
    text-anchor: end;
  }
  .jt-t.jt-start {
    text-anchor: start;
  }
  .jt-v {
    fill: var(--text);
    font: 600 16px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .jt-t {
    fill: var(--text-muted);
    font: 12px var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
  }
</style>
