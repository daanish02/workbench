---
import Figure from '../Figure.astro';
---

<Figure
  title="Same traffic, different routing"
  caption="Each tick one request arrives; 10% are expensive, and one key is far more popular than the rest. Three servers each do a fixed amount of work per tick. Watch the backlog per server under each strategy: round robin ignores cost, least-loaded reacts to it, and hashing keeps a key on one server even when that server is the busy one."
>
  <lb-sim>
    <div class="ctl-row">
      <span class="ctl-label">Strategy</span>
      <button class="btn" data-s="rr" aria-pressed="true">Round robin</button>
      <button class="btn" data-s="least" aria-pressed="false">Least loaded</button>
      <button class="btn" data-s="hash" aria-pressed="false">Hash of key</button>
    </div>
    <div class="ctl-row">
      <button class="btn primary" data-run>Run</button>
      <button class="btn" data-reset>Reset</button>
      <span class="stat" data-stat></span>
    </div>
    <div class="lb" data-bars></div>
    <p class="lb-msg" data-msg></p>
  </lb-sim>
</Figure>

<style>
  .lb {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 14px;
    height: 150px;
    align-items: end;
  }
  .lb :global(.col) {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    gap: 4px;
  }
  .lb :global(.bar) {
    border-radius: 6px 6px 0 0;
    background: var(--g-blue);
    min-height: 2px;
    transition: height 0.1s;
  }
  .lb :global(.bar.hot) {
    background: var(--g-red);
  }
  .lb :global(.lab) {
    text-align: center;
    font: 0.75rem var(--font-mono);
    color: var(--text-muted);
  }
  .lb-msg {
    margin: 12px 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    min-height: 3em;
  }
</style>

<script>
  function rng(seed: number) {
    return () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  const TICKS = 300;
  const MSG: Record<string, string> = {
    rr: 'Round robin gives each server the same NUMBER of requests, but an expensive request costs 8 times a cheap one, so backlogs still diverge.',
    least: 'Least loaded sends each request to the server with the smallest backlog, so work evens out and waiting stays near zero.',
    hash: 'Hashing keeps each key on one server, which is useful for caches, but the very popular key (and everything else hashed to its server) piles up there.',
  };
  class LbSim extends HTMLElement {
    s = 'rr';
    t = 0;
    backlog = [0, 0, 0];
    worst = 0;
    waited = 0;
    rr = 0;
    rnd = rng(3);
    iv = 0;
    connectedCallback() {
      this.querySelectorAll<HTMLButtonElement>('[data-s]').forEach((b) =>
        b.addEventListener('click', () => {
          this.s = b.dataset.s!;
          this.querySelectorAll('[data-s]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          this.reset();
        }),
      );
      this.querySelector('[data-run]')!.addEventListener('click', () => this.toggle());
      this.querySelector('[data-reset]')!.addEventListener('click', () => this.reset());
      this.reset();
    }
    disconnectedCallback() {
      clearInterval(this.iv);
    }
    toggle() {
      if (this.iv) {
        clearInterval(this.iv);
        this.iv = 0;
        this.querySelector('[data-run]')!.textContent = 'Run';
      } else {
        if (this.t >= TICKS) this.reset();
        this.querySelector('[data-run]')!.textContent = 'Pause';
        this.iv = window.setInterval(() => this.step(), 40);
      }
    }
    reset() {
      clearInterval(this.iv);
      this.iv = 0;
      this.querySelector('[data-run]')!.textContent = 'Run';
      this.t = 0;
      this.backlog = [0, 0, 0];
      this.worst = 0;
      this.waited = 0;
      this.rr = 0;
      this.rnd = rng(3);
      this.draw();
    }
    step() {
      if (this.t >= TICKS) return this.toggle();
      const cost = this.rnd() < 0.1 ? 8 : 1;
      const pool = [0, 0, 0, 0, 0, ...Array.from({ length: 19 }, (_, i) => i + 1)];
      const key = pool[Math.floor(this.rnd() * pool.length)];
      let sv = 0;
      if (this.s === 'rr') sv = this.rr++ % 3;
      else if (this.s === 'least') sv = this.backlog.indexOf(Math.min(...this.backlog));
      else sv = ((key * 2654435761) >>> 0) % 3;
      this.waited += this.backlog[sv];
      this.backlog[sv] += cost;
      this.backlog = this.backlog.map((b) => Math.max(0, b - 1.3));
      this.worst = Math.max(this.worst, ...this.backlog);
      this.t++;
      this.draw();
    }
    draw() {
      const max = 20;
      this.querySelector('[data-bars]')!.innerHTML = this.backlog
        .map((b, i) => `<div class="col"><div class="bar ${b > 8 ? 'hot' : ''}" style="height:${Math.min(100, (b / max) * 100)}%"></div><div class="lab">server ${i + 1} · ${b.toFixed(1)}</div></div>`)
        .join('');
      this.querySelector('[data-stat]')!.innerHTML = `tick <b>${this.t}/${TICKS}</b> · worst backlog <b>${this.worst.toFixed(1)}</b> · avg wait <b>${this.t ? (this.waited / this.t).toFixed(2) : '0.00'}</b>`;
      this.querySelector('[data-msg]')!.textContent = MSG[this.s];
    }
  }
  customElements.define('lb-sim', LbSim);
</script>
