---
// Pulls an important idea out of the running text so the page has visual landmarks.
interface Props {
  type?: 'key' | 'pitfall' | 'example' | 'practice';
  title?: string;
}
const { type = 'key', title } = Astro.props;
const labels = { key: 'Key idea', pitfall: 'Pitfall', example: 'Example', practice: 'In practice' };
const icons = {
  key: 'M8 1.5a4.5 4.5 0 0 0-2.5 8.24V11.5h5V9.74A4.5 4.5 0 0 0 8 1.5ZM6 13.5h4',
  pitfall: 'M8 2 1.5 13.5h13L8 2Zm0 4.5v3m0 2v.01',
  example: 'M3 8h10M9 4l4 4-4 4',
  practice: 'M2.5 8.5l3.5 3.5 7.5-8',
};
---

<aside class:list={['callout', type]}>
  <div class="callout-label">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d={icons[type]}></path>
    </svg>
    {title ?? labels[type]}
  </div>
  <div class="callout-body"><slot /></div>
</aside>
