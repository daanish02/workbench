---
// One glyph per area, drawn in the four Google colours used by the workbench logo.
interface Props {
  id: string;
  size?: number;
}

const { id, size = 22 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    id === 'cs' && (
      <g stroke="#4285F4">
        <polyline points="11,9 4,16 11,23" />
        <polyline points="21,9 28,16 21,23" />
        <line x1="18" y1="7" x2="14" y2="25" stroke="#EA4335" />
      </g>
    )
  }
  {
    id === 'math' && (
      <path d="M23 6 C19 3.5 15.5 5.5 15 9.5 L12.5 22.5 C11.8 26.5 8.5 28.5 5 26" stroke="#EA4335" stroke-width="2.6" />
    )
  }
  {
    id === 'ml' && (
      <g>
        <g stroke="#FBBC05" stroke-width="1.2">
          <line x1="6" y1="11" x2="16" y2="7" />
          <line x1="6" y1="11" x2="16" y2="16" />
          <line x1="6" y1="11" x2="16" y2="25" />
          <line x1="6" y1="21" x2="16" y2="7" />
          <line x1="6" y1="21" x2="16" y2="16" />
          <line x1="6" y1="21" x2="16" y2="25" />
          <line x1="16" y1="7" x2="26" y2="16" />
          <line x1="16" y1="16" x2="26" y2="16" />
          <line x1="16" y1="25" x2="26" y2="16" />
        </g>
        <g fill="#FBBC05" stroke="none">
          <circle cx="6" cy="11" r="2.2" />
          <circle cx="6" cy="21" r="2.2" />
          <circle cx="16" cy="7" r="2.2" />
          <circle cx="16" cy="16" r="2.2" />
          <circle cx="16" cy="25" r="2.2" />
          <circle cx="26" cy="16" r="2.2" />
        </g>
      </g>
    )
  }
  {
    id === 'dl' && (
      <g stroke="#34A853">
        <polygon points="16,5 28,11 16,17 4,11" />
        <polyline points="4,16 16,22 28,16" />
        <polyline points="4,21 16,27 28,21" />
      </g>
    )
  }
  {
    id === 'applied-dl' && (
      <g fill="#8AB4F8" stroke="none">
        <path d="M15 4 L18 13 L27 16 L18 19 L15 28 L12 19 L3 16 L12 13 Z" />
        <circle cx="26" cy="6" r="1.8" />
      </g>
    )
  }
  {
    id === 'infra' && (
      <g stroke="currentColor">
        <rect x="8" y="8" width="16" height="16" rx="3" />
        <rect x="12.5" y="12.5" width="7" height="7" rx="1" />
        <line x1="12" y1="3" x2="12" y2="8" />
        <line x1="20" y1="3" x2="20" y2="8" />
        <line x1="12" y1="24" x2="12" y2="29" />
        <line x1="20" y1="24" x2="20" y2="29" />
        <line x1="3" y1="12" x2="8" y2="12" />
        <line x1="3" y1="20" x2="8" y2="20" />
        <line x1="24" y1="12" x2="29" y2="12" />
        <line x1="24" y1="20" x2="29" y2="20" />
      </g>
    )
  }
</svg>
