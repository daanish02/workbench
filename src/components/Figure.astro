---
// Frame shared by every diagram and interactive: header strip, body, optional caption.
interface Props {
  title: string;
  kind?: 'Interactive' | 'Diagram';
  caption?: string;
}
const { title, kind = 'Interactive', caption } = Astro.props;
---

<figure class="figure not-prose" data-pagefind-ignore>
  <div class="figure-head">
    <span class="dot" style={kind === 'Diagram' ? 'background: var(--g-blue); box-shadow: 0 0 0 3px rgba(66,133,244,.18)' : undefined}></span>
    <span class="kind">{kind}</span>
    <span class="title">{title}</span>
  </div>
  <div class="figure-body">
    <slot />
  </div>
  {caption && <figcaption class="figure-caption">{caption}</figcaption>}
</figure>
