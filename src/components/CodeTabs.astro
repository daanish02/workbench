---
// One code block shown in several languages: wrap two or more fenced blocks in <CodeTabs>.
// Each block's header tab becomes a row of tabs (one per block); clicking a tab shows that block.
// Without JavaScript all blocks simply show one after another.
---

<code-tabs><slot /></code-tabs>

<style>
  code-tabs {
    display: block;
  }
  code-tabs :global(.ct-tabs) {
    display: flex;
    align-self: stretch;
  }
  code-tabs :global(.ct-tab) {
    padding: 0.45rem 0.9rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    font: 600 0.8125rem/1.9rem 'Inter', system-ui, sans-serif;
    color: var(--text-muted);
    cursor: pointer;
  }
  code-tabs :global(.ct-tab:hover) {
    color: var(--text);
  }
  code-tabs :global(.ct-tab[aria-selected='true']) {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>

<script>
  class CodeTabs extends HTMLElement {
    connectedCallback() {
      const blocks = [...this.querySelectorAll<HTMLElement>('.expressive-code')];
      if (blocks.length < 2) return;
      const labels = blocks.map((b) => b.querySelector('.title')?.textContent?.trim() || 'Code');
      const show = (i: number) =>
        blocks.forEach((b, j) => {
          b.style.display = j === i ? '' : 'none';
          b.querySelectorAll<HTMLElement>('.ct-tab').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === String(i))));
        });
      // every block gets the full tab row in place of its own single tab, so the visible one always shows all tabs
      blocks.forEach((b) => {
        const title = b.querySelector('.header .title');
        if (!title) return;
        const row = document.createElement('div');
        row.className = 'ct-tabs';
        row.setAttribute('role', 'tablist');
        labels.forEach((label, i) => {
          const tab = document.createElement('button');
          tab.type = 'button';
          tab.className = 'ct-tab';
          tab.setAttribute('role', 'tab');
          tab.dataset.tab = String(i);
          tab.textContent = label;
          tab.addEventListener('click', () => show(i));
          row.append(tab);
        });
        title.replaceWith(row);
      });
      show(0);
    }
  }
  customElements.define('code-tabs', CodeTabs);
</script>
